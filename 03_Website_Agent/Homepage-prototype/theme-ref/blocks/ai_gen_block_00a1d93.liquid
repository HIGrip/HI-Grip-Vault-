{% doc %}
  @prompt
    Een tijdlijn die interactief is en oplicht wanneer de klant scrollt. Er moeten fotos in de tijdlijn passen en niet alleen maar verticaal zijn ook soms horizon taal. Het gaat om 10 bulletpoints waar ook tekst onder past. het moet energiek zijn voor ons sportmerk., de tekst moet wat verder van de tijdlijn af en meer kleuren, ER MOET BOVEN ELKE TITEL EEN PLEK KOMEN VOOR EEN DATUM
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-timeline-{{ ai_gen_id }} {
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding: 60px 20px;
    display: block;
  }

  .ai-timeline-container-{{ ai_gen_id }} {
    position: relative;
    max-width: 1200px;
    margin: 0 auto;
  }

  .ai-timeline-line-{{ ai_gen_id }} {
    position: absolute;
    left: 50%;
    top: 0;
    bottom: 0;
    width: 4px;
    background: linear-gradient(180deg, {{ block.settings.line_color_start }}, {{ block.settings.line_color_end }});
    transform: translateX(-50%);
  }

  .ai-timeline-item-{{ ai_gen_id }} {
    position: relative;
    margin-bottom: 80px;
    opacity: 0.3;
    transform: translateY(30px);
    transition: all 0.6s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .ai-timeline-item-{{ ai_gen_id }}.active {
    opacity: 1;
    transform: translateY(0);
  }

  .ai-timeline-item-{{ ai_gen_id }}:nth-child(odd) .ai-timeline-content-{{ ai_gen_id }} {
    flex-direction: row;
    text-align: right;
  }

  .ai-timeline-item-{{ ai_gen_id }}:nth-child(even) .ai-timeline-content-{{ ai_gen_id }} {
    flex-direction: row-reverse;
    text-align: left;
  }

  .ai-timeline-content-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 60px;
    position: relative;
  }

  .ai-timeline-text-wrapper-{{ ai_gen_id }} {
    flex: 1;
    max-width: calc(50% - 80px);
  }

  .ai-timeline-date-{{ ai_gen_id }} {
    font-size: {{ block.settings.date_size }}px;
    color: {{ block.settings.date_color }};
    font-weight: 700;
    margin-bottom: 8px;
    text-transform: uppercase;
    letter-spacing: 1px;
  }

  .ai-timeline-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    color: {{ block.settings.title_color }};
    font-weight: 700;
    margin-bottom: 12px;
    line-height: 1.2;
  }

  .ai-timeline-description-{{ ai_gen_id }} {
    font-size: {{ block.settings.description_size }}px;
    color: {{ block.settings.description_color }};
    line-height: 1.6;
  }

  .ai-timeline-image-wrapper-{{ ai_gen_id }} {
    flex: 1;
    max-width: calc(50% - 80px);
    position: relative;
  }

  .ai-timeline-image-{{ ai_gen_id }} {
    width: 100%;
    height: auto;
    border-radius: {{ block.settings.image_border_radius }}px;
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.15);
    transition: transform 0.4s ease;
  }

  .ai-timeline-item-{{ ai_gen_id }}.active .ai-timeline-image-{{ ai_gen_id }} {
    transform: scale(1.02);
  }

  .ai-timeline-placeholder-{{ ai_gen_id }} {
    width: 100%;
    aspect-ratio: 16 / 9;
    background: linear-gradient(135deg, #f5f5f5 0%, #e0e0e0 100%);
    border-radius: {{ block.settings.image_border_radius }}px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-timeline-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-timeline-dot-{{ ai_gen_id }} {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    width: {{ block.settings.dot_size }}px;
    height: {{ block.settings.dot_size }}px;
    background: {{ block.settings.dot_color }};
    border: 4px solid {{ block.settings.dot_border_color }};
    border-radius: 50%;
    z-index: 10;
    transition: all 0.4s ease;
    box-shadow: 0 0 0 0 {{ block.settings.dot_color }};
  }

  .ai-timeline-item-{{ ai_gen_id }}.active .ai-timeline-dot-{{ ai_gen_id }} {
    transform: translate(-50%, -50%) scale(1.3);
    box-shadow: 0 0 0 8px {{ block.settings.dot_color }}33;
  }

  @media screen and (max-width: 768px) {
    .ai-timeline-line-{{ ai_gen_id }} {
      left: 20px;
    }

    .ai-timeline-item-{{ ai_gen_id }}:nth-child(odd) .ai-timeline-content-{{ ai_gen_id }},
    .ai-timeline-item-{{ ai_gen_id }}:nth-child(even) .ai-timeline-content-{{ ai_gen_id }} {
      flex-direction: column;
      text-align: left;
      padding-left: 60px;
    }

    .ai-timeline-text-wrapper-{{ ai_gen_id }},
    .ai-timeline-image-wrapper-{{ ai_gen_id }} {
      max-width: 100%;
    }

    .ai-timeline-dot-{{ ai_gen_id }} {
      left: 20px;
      top: 40px;
    }

    .ai-timeline-content-{{ ai_gen_id }} {
      gap: 20px;
    }
  }
{% endstyle %}

<interactive-timeline-{{ ai_gen_id }} class="ai-timeline-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-timeline-container-{{ ai_gen_id }}">
    <div class="ai-timeline-line-{{ ai_gen_id }}"></div>

    {% for i in (1..10) %}
      {% liquid
        assign date_key = 'item_' | append: i | append: '_date'
        assign title_key = 'item_' | append: i | append: '_title'
        assign description_key = 'item_' | append: i | append: '_description'
        assign image_key = 'item_' | append: i | append: '_image'
        assign orientation_key = 'item_' | append: i | append: '_orientation'

        assign item_date = block.settings[date_key]
        assign item_title = block.settings[title_key]
        assign item_description = block.settings[description_key]
        assign item_image = block.settings[image_key]
        assign item_orientation = block.settings[orientation_key]
      %}

      {% if item_title != blank or item_description != blank or item_image != blank %}
        <div class="ai-timeline-item-{{ ai_gen_id }}" data-timeline-item>
          <div class="ai-timeline-content-{{ ai_gen_id }}">
            <div class="ai-timeline-text-wrapper-{{ ai_gen_id }}">
              {% if item_date != blank %}
                <div class="ai-timeline-date-{{ ai_gen_id }}">{{ item_date }}</div>
              {% endif %}
              {% if item_title != blank %}
                <{{ block.settings.heading_tag | default: "h3" }} class="ai-timeline-title-{{ ai_gen_id }}">{{ item_title }}</{{ block.settings.heading_tag | default: "h3" }}>
              {% endif %}
              {% if item_description != blank %}
                <div class="ai-timeline-description-{{ ai_gen_id }}">{{ item_description }}</div>
              {% endif %}
            </div>

            <div class="ai-timeline-image-wrapper-{{ ai_gen_id }}">
              {% if item_image != blank %}
                {% if item_orientation == 'landscape' %}
                  <img
                    src="{{ item_image | image_url: width: 800 }}"
                    alt="{{ item_image.alt | escape }}"
                    class="ai-timeline-image-{{ ai_gen_id }}"
                    loading="lazy"
                    width="800"
                    height="{{ 800 | divided_by: item_image.aspect_ratio | round }}"
                    style="aspect-ratio: 16 / 9; object-fit: cover;"
                  >
                {% else %}
                  <img
                    src="{{ item_image | image_url: width: 600 }}"
                    alt="{{ item_image.alt | escape }}"
                    class="ai-timeline-image-{{ ai_gen_id }}"
                    loading="lazy"
                    width="600"
                    height="{{ 600 | divided_by: item_image.aspect_ratio | round }}"
                    style="aspect-ratio: 3 / 4; object-fit: cover;"
                  >
                {% endif %}
              {% else %}
                <div class="ai-timeline-placeholder-{{ ai_gen_id }}">
                  {{ 'image' | placeholder_svg_tag }}
                </div>
              {% endif %}
            </div>

            <div class="ai-timeline-dot-{{ ai_gen_id }}"></div>
          </div>
        </div>
      {% endif %}
    {% endfor %}
  </div>
</interactive-timeline-{{ ai_gen_id }}>

<script>
  (function() {
    class InteractiveTimeline{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.items = [];
        this.observer = null;
      }

      connectedCallback() {
        this.items = this.querySelectorAll('[data-timeline-item]');
        this.setupIntersectionObserver();
      }

      setupIntersectionObserver() {
        const options = {
          root: null,
          rootMargin: '-20% 0px -20% 0px',
          threshold: 0.1
        };

        this.observer = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('active');
            }
          });
        }, options);

        this.items.forEach((item) => {
          this.observer.observe(item);
        });
      }

      disconnectedCallback() {
        if (this.observer) {
          this.observer.disconnect();
        }
      }
    }

    customElements.define('interactive-timeline-{{ ai_gen_id }}', InteractiveTimeline{{ ai_gen_id }});
  })();
</script>

