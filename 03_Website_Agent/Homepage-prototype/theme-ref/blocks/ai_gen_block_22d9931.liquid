    },
    {
      "type": "range",
      "id": "icon_size",
      "label": "Icoon grootte",
      "min": 20,
      "max": 80,
      "step": 5,
      "unit": "px",
      "default": 40
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Icoon kleur",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "icon_stroke_width",
      "label": "Icoon lijndikte",
      "min": 1,
      "max": 3,
      "step": 1,
      "default": 2
    },
    {
      "type": "header",
      "content": "Titel"
    },
    {
      "type": "range",
      "id": "title_size",
      "label": "Titel grootte",
      "min": 12,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Titel kleur",
      "default": "#000000"
    },
    {
      "type": "select",
      "id": "title_weight",
      "label": "Titel gewicht",
      "options": [
        {
          "value": "400",
          "label": "Normaal"
        },
        {
          "value": "500",
