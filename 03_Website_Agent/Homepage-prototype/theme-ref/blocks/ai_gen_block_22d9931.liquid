        },
        {
          "value": "uppercase",
          "label": "Hoofdletters"
        }
      ],
      "default": "uppercase"
    },
    {
      "type": "range",
      "id": "title_letter_spacing",
      "label": "Titel letter spacing",
      "min": 0,
      "max": 3,
      "step": 0.5,
      "unit": "px",
      "default": 1
    },
    {
      "type": "header",
      "content": "Tekst"
    },
    {
      "type": "range",
      "id": "text_size",
      "label": "Tekst grootte",
      "min": 10,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 13
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Tekst kleur",
      "default": "#666666"
    }
  ],
  "presets": [
    {
      "name": "Kernwaarden"
    }
  ]
