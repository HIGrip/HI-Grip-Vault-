{% doc %}
  @prompt
    sectie met pictogrammen voor sporten padel, voetbal, tennis, gym, reformer pilates., koptekst en subtekst weghalen en veel kleiner en uitlijnen naar links, ik wil de pictogrammen en tekst eronder kunnen aanpassen, ik wil per pictogram de grootte kunnen aanpassen
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-sports-icons-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding: {{ block.settings.section_padding }}px 0;
    background-color: {{ block.settings.background_color }};
  }

  .ai-sports-icons__container-{{ ai_gen_id }} {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .ai-sports-icons__grid-{{ ai_gen_id }} {
    display: flex;
    gap: {{ block.settings.icon_spacing }}px;
    justify-content: flex-start;
    align-items: center;
  }

  .ai-sports-icons__item-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: {{ block.settings.label_spacing }}px;
    text-align: center;
  }

  .ai-sports-icons__icon-wrapper-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: {{ block.settings.icon_background }};
    border-radius: {{ block.settings.icon_border_radius }}px;
    padding: {{ block.settings.icon_padding }}px;
    transition: transform 0.3s ease, background-color 0.3s ease;
  }

  .ai-sports-icons__icon-wrapper-{{ ai_gen_id }}:hover {
    transform: translateY(-5px);
    background-color: {{ block.settings.icon_hover_background }};
  }

  .ai-sports-icons__icon-wrapper-{{ ai_gen_id }}.ai-sports-icons__icon-wrapper--1-{{ ai_gen_id }} {
    width: {{ block.settings.icon_size_1 }}px;
    height: {{ block.settings.icon_size_1 }}px;
  }

  .ai-sports-icons__icon-wrapper-{{ ai_gen_id }}.ai-sports-icons__icon-wrapper--2-{{ ai_gen_id }} {
    width: {{ block.settings.icon_size_2 }}px;
    height: {{ block.settings.icon_size_2 }}px;
  }

  .ai-sports-icons__icon-wrapper-{{ ai_gen_id }}.ai-sports-icons__icon-wrapper--3-{{ ai_gen_id }} {
    width: {{ block.settings.icon_size_3 }}px;
    height: {{ block.settings.icon_size_3 }}px;
  }

  .ai-sports-icons__icon-wrapper-{{ ai_gen_id }}.ai-sports-icons__icon-wrapper--4-{{ ai_gen_id }} {
    width: {{ block.settings.icon_size_4 }}px;
    height: {{ block.settings.icon_size_4 }}px;
  }

  .ai-sports-icons__icon-wrapper-{{ ai_gen_id }}.ai-sports-icons__icon-wrapper--5-{{ ai_gen_id }} {
    width: {{ block.settings.icon_size_5 }}px;
    height: {{ block.settings.icon_size_5 }}px;
  }

  .ai-sports-icons__icon-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
  }

  .ai-sports-icons__label-{{ ai_gen_id }} {
    font-size: {{ block.settings.label_size }}px;
    color: {{ block.settings.label_color }};
    font-weight: 500;
  }

  @media screen and (max-width: 749px) {
    .ai-sports-icons__grid-{{ ai_gen_id }} {
      flex-wrap: wrap;
      gap: {{ block.settings.icon_spacing | times: 0.7 }}px;
    }

    .ai-sports-icons__icon-wrapper-{{ ai_gen_id }}.ai-sports-icons__icon-wrapper--1-{{ ai_gen_id }} {
      width: {{ block.settings.icon_size_1 | times: 0.8 }}px;
      height: {{ block.settings.icon_size_1 | times: 0.8 }}px;
    }

    .ai-sports-icons__icon-wrapper-{{ ai_gen_id }}.ai-sports-icons__icon-wrapper--2-{{ ai_gen_id }} {
      width: {{ block.settings.icon_size_2 | times: 0.8 }}px;
      height: {{ block.settings.icon_size_2 | times: 0.8 }}px;
    }

    .ai-sports-icons__icon-wrapper-{{ ai_gen_id }}.ai-sports-icons__icon-wrapper--3-{{ ai_gen_id }} {
      width: {{ block.settings.icon_size_3 | times: 0.8 }}px;
      height: {{ block.settings.icon_size_3 | times: 0.8 }}px;
    }

    .ai-sports-icons__icon-wrapper-{{ ai_gen_id }}.ai-sports-icons__icon-wrapper--4-{{ ai_gen_id }} {
      width: {{ block.settings.icon_size_4 | times: 0.8 }}px;
      height: {{ block.settings.icon_size_4 | times: 0.8 }}px;
    }

    .ai-sports-icons__icon-wrapper-{{ ai_gen_id }}.ai-sports-icons__icon-wrapper--5-{{ ai_gen_id }} {
      width: {{ block.settings.icon_size_5 | times: 0.8 }}px;
      height: {{ block.settings.icon_size_5 | times: 0.8 }}px;
    }
  }
{% endstyle %}

<div class="ai-sports-icons-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-sports-icons__container-{{ ai_gen_id }}">
    <div class="ai-sports-icons__grid-{{ ai_gen_id }}">
      {% for i in (1..5) %}
        {% liquid
          assign icon_key = 'icon_' | append: i
          assign label_key = 'label_' | append: i
          assign icon = block.settings[icon_key]
          assign label = block.settings[label_key]
        %}
        
        {% if icon != blank or label != blank %}
          <div class="ai-sports-icons__item-{{ ai_gen_id }}">
            <div class="ai-sports-icons__icon-wrapper-{{ ai_gen_id }} ai-sports-icons__icon-wrapper--{{ i }}-{{ ai_gen_id }}">
              {% if icon != blank %}
                <img 
                  src="{{ icon | image_url: width: 200 }}" 
                  alt="{{ label | escape }}"
                  class="ai-sports-icons__icon-{{ ai_gen_id }}"
                  loading="lazy"
                  width="200"
                  height="200"
                >
              {% else %}
                <div class="ai-sports-icons__placeholder-{{ ai_gen_id }}">
                  {{ 'image' | placeholder_svg_tag }}
                </div>
              {% endif %}
            </div>
            {% if label != blank %}
              <span class="ai-sports-icons__label-{{ ai_gen_id }}">{{ label }}</span>
            {% endif %}
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</div>

