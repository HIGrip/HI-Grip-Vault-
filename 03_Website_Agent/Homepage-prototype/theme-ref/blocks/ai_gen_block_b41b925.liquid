{% doc %}
  @prompt
    EEN SECTIE MET WAAROM SPORTCLUBS HÏ GRIP OP HUN SPORTCLUB MOETEN HEBBEN MET BULLETPOINTS EN PLEK VOOR EEN AFBEELDING
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-sports-club-benefits-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding: {{ block.settings.section_padding }}px 20px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-sports-club-benefits__container-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: {{ block.settings.content_gap }}px;
    align-items: center;
    max-width: 1200px;
    margin: 0 auto;
  }

  .ai-sports-club-benefits__content-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.content_spacing }}px;
  }

  .ai-sports-club-benefits__heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size }}px;
    color: {{ block.settings.heading_color }};
    margin: 0;
    line-height: 1.2;
  }

  .ai-sports-club-benefits__subheading-{{ ai_gen_id }} {
    font-size: {{ block.settings.subheading_size }}px;
    color: {{ block.settings.text_color }};
    margin: 0;
    line-height: 1.5;
  }

  .ai-sports-club-benefits__list-{{ ai_gen_id }} {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.bullet_spacing }}px;
  }

  .ai-sports-club-benefits__item-{{ ai_gen_id }} {
    display: flex;
    align-items: flex-start;
    gap: 12px;
  }

  .ai-sports-club-benefits__icon-{{ ai_gen_id }} {
    flex-shrink: 0;
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    background-color: {{ block.settings.icon_background }};
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-top: 2px;
  }

  .ai-sports-club-benefits__icon-{{ ai_gen_id }} svg {
    width: calc({{ block.settings.icon_size }}px * 0.5);
    height: calc({{ block.settings.icon_size }}px * 0.5);
    stroke: {{ block.settings.icon_color }};
  }

  .ai-sports-club-benefits__text-{{ ai_gen_id }} {
    flex: 1;
    font-size: {{ block.settings.bullet_text_size }}px;
    color: {{ block.settings.text_color }};
    line-height: 1.6;
    margin: 0;
  }

  .ai-sports-club-benefits__image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    border-radius: {{ block.settings.image_border_radius }}px;
    overflow: hidden;
  }

  .ai-sports-club-benefits__image-{{ ai_gen_id }} {
    width: 100%;
    height: auto;
    display: block;
    border-radius: {{ block.settings.image_border_radius }}px;
  }

  .ai-sports-club-benefits__image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    aspect-ratio: 4 / 3;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: {{ block.settings.image_border_radius }}px;
    position: relative;
  }

  .ai-sports-club-benefits__image-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 300px;
    max-height: 300px;
  }

  .ai-sports-club-benefits__empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    padding: 12px 20px;
    font-size: 14px;
    color: #666;
    text-align: center;
    pointer-events: none;
  }

  @media screen and (max-width: 749px) {
    .ai-sports-club-benefits__container-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: {{ block.settings.mobile_gap }}px;
    }

    {% if block.settings.mobile_image_position == 'top' %}
      .ai-sports-club-benefits__image-wrapper-{{ ai_gen_id }} {
        order: -1;
      }
    {% endif %}

    .ai-sports-club-benefits__heading-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.heading_size }}px * 0.7);
    }

    .ai-sports-club-benefits__subheading-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.subheading_size }}px * 0.9);
    }
  }
{% endstyle %}

<sports-club-benefits-{{ ai_gen_id }}
  class="ai-sports-club-benefits-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-sports-club-benefits__container-{{ ai_gen_id }}">
    <div class="ai-sports-club-benefits__content-{{ ai_gen_id }}">
      {% if block.settings.heading != blank %}
        <{{ block.settings.heading_tag | default: "h2" }} class="ai-sports-club-benefits__heading-{{ ai_gen_id }}">
          {{ block.settings.heading }}
        </{{ block.settings.heading_tag | default: "h2" }}>
      {% endif %}

      {% if block.settings.subheading != blank %}
        <div class="ai-sports-club-benefits__subheading-{{ ai_gen_id }}">
          {{ block.settings.subheading }}
        </div>
      {% endif %}

      <ul class="ai-sports-club-benefits__list-{{ ai_gen_id }}">
        {% if block.settings.bullet_1 != blank %}
          <li class="ai-sports-club-benefits__item-{{ ai_gen_id }}">
            <div class="ai-sports-club-benefits__icon-{{ ai_gen_id }}">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="none"
                stroke-width="2.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
            </div>
            <p class="ai-sports-club-benefits__text-{{ ai_gen_id }}">
              {{ block.settings.bullet_1 }}
            </p>
          </li>
        {% endif %}

        {% if block.settings.bullet_2 != blank %}
          <li class="ai-sports-club-benefits__item-{{ ai_gen_id }}">
            <div class="ai-sports-club-benefits__icon-{{ ai_gen_id }}">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="none"
                stroke-width="2.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
            </div>
            <p class="ai-sports-club-benefits__text-{{ ai_gen_id }}">
              {{ block.settings.bullet_2 }}
            </p>
          </li>
        {% endif %}

        {% if block.settings.bullet_3 != blank %}
          <li class="ai-sports-club-benefits__item-{{ ai_gen_id }}">
            <div class="ai-sports-club-benefits__icon-{{ ai_gen_id }}">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="none"
                stroke-width="2.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
            </div>
            <p class="ai-sports-club-benefits__text-{{ ai_gen_id }}">
              {{ block.settings.bullet_3 }}
            </p>
          </li>
        {% endif %}

        {% if block.settings.bullet_4 != blank %}
          <li class="ai-sports-club-benefits__item-{{ ai_gen_id }}">
            <div class="ai-sports-club-benefits__icon-{{ ai_gen_id }}">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="none"
                stroke-width="2.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
            </div>
            <p class="ai-sports-club-benefits__text-{{ ai_gen_id }}">
              {{ block.settings.bullet_4 }}
            </p>
          </li>
        {% endif %}

        {% if block.settings.bullet_5 != blank %}
          <li class="ai-sports-club-benefits__item-{{ ai_gen_id }}">
            <div class="ai-sports-club-benefits__icon-{{ ai_gen_id }}">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="none"
                stroke-width="2.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
            </div>
            <p class="ai-sports-club-benefits__text-{{ ai_gen_id }}">
              {{ block.settings.bullet_5 }}
            </p>
          </li>
        {% endif %}

        {% if block.settings.bullet_6 != blank %}
          <li class="ai-sports-club-benefits__item-{{ ai_gen_id }}">
            <div class="ai-sports-club-benefits__icon-{{ ai_gen_id }}">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="none"
                stroke-width="2.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
            </div>
            <p class="ai-sports-club-benefits__text-{{ ai_gen_id }}">
              {{ block.settings.bullet_6 }}
            </p>
          </li>
        {% endif %}
      </ul>
    </div>

    <div class="ai-sports-club-benefits__image-wrapper-{{ ai_gen_id }}">
      {% if block.settings.image %}
        <img
          src="{{ block.settings.image | image_url: width: 1200 }}"
          alt="{{ block.settings.image.alt | escape }}"
          loading="lazy"
          width="{{ block.settings.image.width }}"
          height="{{ block.settings.image.height }}"
          class="ai-sports-club-benefits__image-{{ ai_gen_id }}"
        >
      {% else %}
        <div class="ai-sports-club-benefits__image-placeholder-{{ ai_gen_id }}">
          {{ 'image' | placeholder_svg_tag }}
          <div class="ai-sports-club-benefits__empty-state-{{ ai_gen_id }}">
            Voeg een afbeelding toe
          </div>
        </div>
      {% endif %}
    </div>
  </div>
</sports-club-benefits-{{ ai_gen_id }}>

<script>
  (function() {
    class SportsClubBenefits{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
      }
    }

    customElements.define('sports-club-benefits-{{ ai_gen_id }}', SportsClubBenefits{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Waarom HÏ Grip",
  "tag": null,
  "settings": [
    { "type": "select", "id": "heading_tag", "label": "Kopniveau (SEO)", "options": [ {"value":"h1","label":"H1"}, {"value":"h2","label":"H2"}, {"value":"h3","label":"H3"}, {"value":"h4","label":"H4"}, {"value":"p","label":"Geen kop (alinea)"} ], "default": "h2" },
    {
      "type": "header",
      "content": "Inhoud"
