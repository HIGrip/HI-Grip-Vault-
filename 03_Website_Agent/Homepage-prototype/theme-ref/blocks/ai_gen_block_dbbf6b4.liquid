{% doc %}
  @prompt
    een sectie waar we onze drie kernwaarden kort kunnen neerzetten in sportstijl, de kernwaarden poppen omhoog als mensen op de site komen en bestaan uit tekst en klein tekstje eronder en een lijntje en mooie effecten
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-core-values-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding: {{ block.settings.section_padding }}px 20px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-core-values-container-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: {{ block.settings.gap }}px;
    max-width: 1200px;
    margin: 0 auto;
  }

  .ai-core-value-card-{{ ai_gen_id }} {
    position: relative;
    padding: {{ block.settings.card_padding }}px;
    background-color: {{ block.settings.card_background }};
    border-radius: {{ block.settings.card_border_radius }}px;
    text-align: center;
    opacity: 0;
    transform: translateY(30px);
  }

  .ai-core-value-card-{{ ai_gen_id }}.ai-animated-{{ ai_gen_id }} {
    animation: ai-popup-{{ ai_gen_id }} 0.6s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
  }

  .ai-core-value-card-{{ ai_gen_id }}:nth-child(1).ai-animated-{{ ai_gen_id }} {
    animation-delay: 0.1s;
  }

  .ai-core-value-card-{{ ai_gen_id }}:nth-child(2).ai-animated-{{ ai_gen_id }} {
    animation-delay: 0.3s;
  }

  .ai-core-value-card-{{ ai_gen_id }}:nth-child(3).ai-animated-{{ ai_gen_id }} {
    animation-delay: 0.5s;
  }

  @keyframes ai-popup-{{ ai_gen_id }} {
    0% {
      opacity: 0;
      transform: translateY(30px) scale(0.9);
    }
    100% {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  .ai-core-value-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    font-weight: 700;
    color: {{ block.settings.title_color }};
    margin: 0 0 {{ block.settings.title_spacing }}px 0;
    text-transform: uppercase;
    letter-spacing: 1px;
  }

  .ai-core-value-divider-{{ ai_gen_id }} {
    width: {{ block.settings.divider_width }}px;
    height: {{ block.settings.divider_height }}px;
    background: {{ block.settings.divider_color }};
    margin: 0 auto {{ block.settings.divider_spacing }}px;
    border-radius: {{ block.settings.divider_border_radius }}px;
  }

  .ai-core-value-description-{{ ai_gen_id }} {
    font-size: {{ block.settings.description_size }}px;
    color: {{ block.settings.description_color }};
    line-height: 1.6;
    margin: 0;
  }

  @media screen and (max-width: 749px) {
    .ai-core-values-container-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: {{ block.settings.gap | times: 0.7 }}px;
    }

    .ai-core-value-card-{{ ai_gen_id }}:nth-child(1).ai-animated-{{ ai_gen_id }} {
      animation-delay: 0.1s;
    }

    .ai-core-value-card-{{ ai_gen_id }}:nth-child(2).ai-animated-{{ ai_gen_id }} {
      animation-delay: 0.2s;
    }

    .ai-core-value-card-{{ ai_gen_id }}:nth-child(3).ai-animated-{{ ai_gen_id }} {
      animation-delay: 0.3s;
    }
  }
{% endstyle %}

<core-values-{{ ai_gen_id }} class="ai-core-values-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-core-values-container-{{ ai_gen_id }}">
    {% for i in (1..3) %}
      {% liquid
        assign title_key = 'value_' | append: i | append: '_title'
        assign description_key = 'value_' | append: i | append: '_description'
        assign title = block.settings[title_key]
        assign description = block.settings[description_key]
      %}
      
      <div class="ai-core-value-card-{{ ai_gen_id }}" data-card="{{ i }}">
        {% if title != blank %}
          <{{ block.settings.heading_tag | default: "h3" }} class="ai-core-value-title-{{ ai_gen_id }}">{{ title }}</{{ block.settings.heading_tag | default: "h3" }}>
        {% endif %}
        
        <div class="ai-core-value-divider-{{ ai_gen_id }}"></div>
        
        {% if description != blank %}
          <p class="ai-core-value-description-{{ ai_gen_id }}">{{ description }}</p>
        {% endif %}
      </div>
    {% endfor %}
  </div>
</core-values-{{ ai_gen_id }}>

<script>
  (function() {
    class CoreValues{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.animated = false;
      }

      connectedCallback() {
        this.setupIntersectionObserver();
      }

      setupIntersectionObserver() {
        const options = {
          root: null,
          rootMargin: '0px',
          threshold: 0.2
        };

        const observer = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting && !this.animated) {
              this.animateCards();
              this.animated = true;
            }
          });
        }, options);

        observer.observe(this);
      }

      animateCards() {
        const cards = this.querySelectorAll('.ai-core-value-card-{{ ai_gen_id }}');
        cards.forEach((card) => {
          card.classList.add('ai-animated-{{ ai_gen_id }}');
        });
      }
    }

    customElements.define('core-values-{{ ai_gen_id }}', CoreValues{{ ai_gen_id }});
  })();
</script>

