{% doc %}
  @prompt
    een sectie waar huidige klanten staan met voor elke klant een afbeelding met een kleine tekst erbij. het is bedoeld voor social proof. , in plaats van 6 klanten, nu 4 klanten, DE AFBEELDINGEN ZIJN AANPASBAAR TE VERSTELLEN IN DE GROTE 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-customer-logos-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding: {{ block.settings.section_padding }}px 0;
  }

  .ai-customer-logos-container-{{ ai_gen_id }} {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .ai-customer-logos-header-{{ ai_gen_id }} {
    text-align: {{ block.settings.text_alignment }};
    margin-bottom: {{ block.settings.spacing_below_heading }}px;
  }

  .ai-customer-logos-heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size }}px;
    color: {{ block.settings.heading_color }};
    margin: 0 0 {{ block.settings.spacing_below_heading | divided_by: 2 }}px;
  }

  .ai-customer-logos-subheading-{{ ai_gen_id }} {
    font-size: {{ block.settings.subheading_size }}px;
    color: {{ block.settings.subheading_color }};
    margin: 0;
  }

  .ai-customer-logos-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat({{ block.settings.columns_desktop }}, 1fr);
    gap: {{ block.settings.grid_gap }}px;
    margin-top: {{ block.settings.spacing_below_heading }}px;
  }

  .ai-customer-logo-item-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: {{ block.settings.item_padding }}px;
    background-color: {{ block.settings.item_background_color }};
    border-radius: {{ block.settings.item_border_radius }}px;
    transition: transform 0.3s ease;
  }

  .ai-customer-logo-item-{{ ai_gen_id }}:hover {
    transform: translateY(-4px);
  }

  .ai-customer-logo-image-wrapper-{{ ai_gen_id }} {
    width: 100%;
    height: {{ block.settings.logo_height }}px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: {{ block.settings.spacing_below_logo }}px;
  }

  .ai-customer-logo-image-{{ ai_gen_id }} {
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
  }

  .ai-customer-logo-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 8px;
  }

  .ai-customer-logo-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-customer-logo-text-{{ ai_gen_id }} {
    font-size: {{ block.settings.text_size }}px;
    color: {{ block.settings.text_color }};
    line-height: 1.5;
  }

  @media screen and (max-width: 749px) {
    .ai-customer-logos-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_mobile }}, 1fr);
    }

    .ai-customer-logos-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.8 }}px;
    }

    .ai-customer-logos-subheading-{{ ai_gen_id }} {
      font-size: {{ block.settings.subheading_size | times: 0.9 }}px;
    }

    .ai-customer-logo-image-wrapper-{{ ai_gen_id }} {
      height: {{ block.settings.logo_height | times: 0.8 }}px;
    }
  }
{% endstyle %}

<customer-logos-{{ ai_gen_id }}
  class="ai-customer-logos-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-customer-logos-container-{{ ai_gen_id }}">
    {% if block.settings.heading != blank or block.settings.subheading != blank %}
      <div class="ai-customer-logos-header-{{ ai_gen_id }}">
        {% if block.settings.heading != blank %}
          <{{ block.settings.heading_tag | default: "h2" }} class="ai-customer-logos-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</{{ block.settings.heading_tag | default: "h2" }}>
        {% endif %}
        {% if block.settings.subheading != blank %}
          <div class="ai-customer-logos-subheading-{{ ai_gen_id }}">{{ block.settings.subheading }}</div>
        {% endif %}
      </div>
    {% endif %}

    <div class="ai-customer-logos-grid-{{ ai_gen_id }}">
      {% for i in (1..4) %}
        {% liquid
          assign logo_key = 'logo_' | append: i
          assign text_key = 'text_' | append: i
          assign logo = block.settings[logo_key]
          assign text = block.settings[text_key]
        %}

        <div class="ai-customer-logo-item-{{ ai_gen_id }}">
          <div class="ai-customer-logo-image-wrapper-{{ ai_gen_id }}">
            {% if logo != blank %}
              <img
                src="{{ logo | image_url: width: 600 }}"
                alt="{{ text | escape }}"
                loading="lazy"
                width="{{ logo.width }}"
                height="{{ logo.height }}"
                class="ai-customer-logo-image-{{ ai_gen_id }}"
              >
            {% else %}
              <div class="ai-customer-logo-placeholder-{{ ai_gen_id }}">
                {{ 'image' | placeholder_svg_tag }}
              </div>
            {% endif %}
          </div>
          {% if text != blank %}
            <div class="ai-customer-logo-text-{{ ai_gen_id }}">{{ text }}</div>
          {% endif %}
        </div>
      {% endfor %}
    </div>
  </div>
</customer-logos-{{ ai_gen_id }}>

<script>
  (function() {
    class CustomerLogos{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
      }
    }

    customElements.define('customer-logos-{{ ai_gen_id }}', CustomerLogos{{ ai_gen_id }});
  })();
</script>

