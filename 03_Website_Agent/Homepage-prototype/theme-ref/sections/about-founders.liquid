{{ 'about-page.css' | asset_url | stylesheet_tag }}
<script src="{{ 'about-page.js' | asset_url }}" defer></script>
<script>document.documentElement.classList.add('ab-js');</script>
{%- liquid
  assign s = section.settings
  assign tag = s.heading_tag | default: 'h2'
  assign n = section.blocks.size
-%}
<section class="ab ab-fn ab-pad" data-ab="founders" data-anim="{{ s.animate }}" aria-label="De founders" style="{% render 'about-vars', s: s %}">
  <div class="ab-wrap">
    <{{ tag }} class="ab-h">{%- if s.line_1 != blank -%}<span class="ab-l"{% render 'about-ta', d: s.line_1_align, m: s.line_1_align_m %}>{{ s.line_1 }} </span>{%- endif -%}{%- if s.line_2 != blank -%}<span class="ab-l"{% render 'about-ta', d: s.line_2_align, m: s.line_2_align_m %}>{{ s.line_2 }} </span>{%- endif -%}</{{ tag }}>
    <div class="ab-cards" style="margin-top:clamp(2rem,4vw,3.5rem);">
      {%- for block in section.blocks -%}
        {%- assign b = block.settings -%}
        <article class="ab-card rv{% if forloop.first %} is-open{% endif %}" tabindex="0" style="--c:{{ b.accent }};--ab-fy:{{ b.focus_y }}%;" {{ block.shopify_attributes }}>
          <div class="ab-card__portrait">
            {%- if b.portrait != blank -%}
              {{ b.portrait | image_url: width: 1200 | image_tag: loading: 'lazy', sizes: '(min-width: 761px) 40vw, 86vw', widths: '500, 800, 1200', alt: b.portrait.alt | default: b.name }}
            {%- else -%}
              <span class="ab-card__ini" aria-hidden="true">{{ b.name | strip | slice: 0 | escape }}</span>
              <div class="ab-card__ph"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><circle cx="12" cy="8" r="4"/><path d="M4 21c1.5-4 4.5-6 8-6s6.5 2 8 6"/></svg>Portret {{ b.name | escape }}</div>
            {%- endif -%}
          </div>
          <div class="ab-card__info">
            {%- if b.sport != blank or b.role != blank -%}
              <div class="ab-chips"{% render 'about-ta', d: b.chips_align, m: b.chips_align_m %}>
                {%- if b.sport != blank -%}<span class="ab-chip ab-chip--s">{{ b.sport | escape }}</span>{%- endif -%}
                {%- if b.role != blank -%}<span class="ab-chip">{{ b.role | escape }}</span>{%- endif -%}
              </div>
            {%- endif -%}
            <div class="ab-card__name"{% render 'about-ta', d: b.name_align, m: b.name_align_m %}>{{ b.name | escape }}</div>
            {%- if b.quote != blank -%}<p class="ab-quote"{% render 'about-ta', d: b.quote_align, m: b.quote_align_m %}>&ldquo;{{ b.quote | escape }}&rdquo;</p>{%- endif -%}
          </div>
        </article>
      {%- endfor -%}
    </div>
    {%- if n > 1 -%}
      <div class="ab-card-nav" aria-label="Blader door de founders">
        <button type="button" class="ab-cn-btn" data-prev aria-label="Vorige founder"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5l-7 7 7 7"/></svg></button>
        <span class="ab-cn-count" data-count>1 / {{ n }}</span>
        <button type="button" class="ab-cn-btn" data-next aria-label="Volgende founder"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7"/></svg></button>
      </div>
    {%- endif -%}
  </div>
</section>

