{{ 'about-page.css' | asset_url | stylesheet_tag }}
<script src="{{ 'about-page.js' | asset_url }}" defer></script>
<script>document.documentElement.classList.add('ab-js');</script>
{%- liquid
  assign s = section.settings
  assign tag = s.heading_tag | default: 'h2'
  assign n = section.blocks.size
  assign nm = n | minus: 1
-%}
<section class="ab ab-tl-sec ab-pad" data-ab="timeline" data-anim="{{ s.animate }}" aria-label="Tijdlijn" style="{% render 'about-vars', s: s %}">
  <div class="ab-wrap">
    <{{ tag }} class="ab-h">{%- if s.line_1 != blank -%}<span class="ab-l"{% render 'about-ta', d: s.line_1_align, m: s.line_1_align_m %}>{{ s.line_1 }} </span>{%- endif -%}{%- if s.line_2 != blank -%}<span class="ab-l"{% render 'about-ta', d: s.line_2_align, m: s.line_2_align_m %}>{{ s.line_2 }} </span>{%- endif -%}</{{ tag }}>
    <div class="ab-tl" style="--ab-n:{{ n }};--ab-tc1:{{ s.line_color_1 }};--ab-tc2:{{ s.line_color_2 }};--ab-tc3:{{ s.line_color_3 }};">
      <span class="ab-tl__bar" aria-hidden="true"></span>
      {%- for block in section.blocks -%}
        {%- liquid
          if nm > 0
            assign f = forloop.index0 | times: 100 | divided_by: nm
          else
            assign f = 0
          endif
          assign tone = 1
          if f >= 100
            assign tone = 3
          elsif f >= 50
            assign tone = 2
          endif
        -%}
        <div class="ab-ms" data-tone="{{ tone }}"{% render 'about-ta', d: block.settings.title_align, m: block.settings.title_align_m %} {{ block.shopify_attributes }}>
          <time {% render 'about-ta', d: block.settings.date_align, m: block.settings.date_align_m %}>{{ block.settings.date | escape }}</time>
          <b>{{ block.settings.title | escape }}</b>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

