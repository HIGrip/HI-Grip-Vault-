{{ 'about-page.css' | asset_url | stylesheet_tag }}
<script src="{{ 'about-page.js' | asset_url }}" defer></script>
<script>document.documentElement.classList.add('ab-js');</script>
{%- liquid
  assign s = section.settings
  assign tag = s.heading_tag | default: 'h2'
-%}
<section class="ab ab-vl ab-pad" data-ab="values" data-anim="{{ s.animate }}" aria-label="Kernwaarden" style="{% render 'about-vars', s: s %}--ab-mask:url('{{ 'hi-logo-mask.png' | asset_url }}');">
  <div class="ab-wrap">
    <{{ tag }} class="ab-h">{%- if s.line_1 != blank -%}<span class="ab-l"{% render 'about-ta', d: s.line_1_align, m: s.line_1_align_m %}>{{ s.line_1 }} </span>{%- endif -%}{%- if s.line_2 != blank -%}<span class="ab-l"{% render 'about-ta', d: s.line_2_align, m: s.line_2_align_m %}>{{ s.line_2 }} </span>{%- endif -%}</{{ tag }}>
  </div>
  <div class="ab-wrap ab-vl__grid">
    <div class="ab-vl__logocol">
      <div class="ab-logo-wrap">
        <div class="ab-logo ab-logo--base" role="img" aria-label="HÏ Grip-embleem"></div>
        <div class="ab-logo ab-logo--fill" aria-hidden="true"></div>
      </div>
    </div>
    <div>
      <div class="ab-vpanels">
        {%- for block in section.blocks -%}
          {%- assign b = block.settings -%}
          <article class="ab-vp" style="--c:{{ b.color }};"{% render 'about-ta', d: b.word_align, m: b.word_align_m %} {{ block.shopify_attributes }}>
            {%- case b.icon -%}
              {%- when 'comfort' -%}<svg class="ab-vp__ico" viewBox="0 0 96 96" aria-hidden="true"><path d="M48 18 82 36 48 54 14 36Z M14 50l34 18 34-18 M14 64l34 18 34-18"/></svg>
              {%- when 'vertrouwen' -%}<svg class="ab-vp__ico" viewBox="0 0 96 96" aria-hidden="true"><path d="M48 14v14 M48 68v14 M14 48h14 M68 48h14"/><circle cx="48" cy="48" r="24"/><circle cx="48" cy="48" r="9"/></svg>
              {%- when 'innovatie' -%}<svg class="ab-vp__ico" viewBox="0 0 96 96" aria-hidden="true"><path d="M38 62c-6-5-10-11-10-19a20 20 0 0 1 40 0c0 8-4 14-10 19v8H38Z M40 78h16 M48 10v6 M20 22l4 4 M76 22l-4 4 M12 46h6 M78 46h6"/></svg>
            {%- endcase -%}
            <h3 class="ab-vp__big" data-w="{{ b.word | escape }}">{{ b.word | escape }}</h3>
            {%- if b.text != blank -%}<p {% render 'about-ta', d: b.text_align, m: b.text_align_m %}>{{ b.text | escape }}</p>{%- endif -%}
          </article>
        {%- endfor -%}
      </div>
      {%- if s.button_label != blank and s.button_url != blank -%}
        <a class="ab-btn ab-vl__btn"{% render 'about-ta', d: s.button_align, m: s.button_align_m %} href="{{ s.button_url }}">{{ s.button_label | escape }}</a>
      {%- endif -%}
    </div>
  </div>
</section>

