{{ 'legal-page.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign s = section.settings
  assign tag = s.heading_tag | default: 'h1'
-%}
<div
  class="legal legal-hero"
  data-width="{{ s.section_width }}"
  data-align="{{ s.text_align }}"
  data-animate="{{ s.animate }}"
  style="
    --legal-bg: {{ s.bg_color }};
    --legal-fg: {{ s.text_color }};
    --legal-accent: {{ s.eyebrow_color }};
    --legal-h-size: {{ s.heading_size }}px;
    --legal-h-size-m: {{ s.heading_size_mobile }}px;
    --legal-lead-size: {{ s.lead_size }}px;
    --legal-pt: {{ s.padding_top }}px;
    --legal-pb: {{ s.padding_bottom }}px;
    --legal-pt-m: {{ s.padding_top_mobile }}px;
    --legal-pb-m: {{ s.padding_bottom_mobile }}px;
    --legal-eyebrow-size: {{ s.eyebrow_size }}px;
    {% if s.heading_color != blank %}--legal-heading-color: {{ s.heading_color }};{% endif %}
    {% if s.lead_color != blank %}--legal-lead-color: {{ s.lead_color }};{% endif %}
  "
  {{ section.shopify_attributes }}
>
  <div class="legal__wrap">
    {%- if s.eyebrow != blank -%}
      <p class="legal-hero__eyebrow">{{ s.eyebrow | escape }}</p>
    {%- endif -%}
    {%- if s.heading != blank -%}
      <{{ tag }}
        class="legal-hero__heading{% if s.heading_uppercase %} legal-hero__heading--upper{% endif %}{% if s.heading_italic %} legal-hero__heading--italic{% endif %}"
      >{{ s.heading | escape }}</{{ tag }}>
    {%- endif -%}
    {%- if s.lead != blank -%}
      <p class="legal-hero__lead">{{ s.lead }}</p>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Juridisch: Kop",
  "settings": [
    { "type": "header", "content": "Tekst" },
    { "type": "text", "id": "eyebrow", "label": "Bovenregel", "default": "Algemeen" },
    { "type": "text", "id": "heading", "label": "Kop", "default": "Algemene voorwaarden" },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Kopniveau (H1, H2, H3...)",
      "options": [
        { "value": "h1", "label": "H1" },
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" },
        { "value": "h4", "label": "H4" },
        { "value": "h5", "label": "H5" },
        { "value": "h6", "label": "H6" },
        { "value": "p", "label": "Gewone tekst (p)" }
      ],
      "default": "h1"
    },
    { "type": "inline_richtext", "id": "lead", "label": "Introtekst (optioneel)" },
    { "type": "header", "content": "Tekstgrootte" },
    { "type": "range", "id": "heading_size", "label": "Kopgrootte (desktop)", "min": 24, "max": 160, "step": 2, "unit": "px", "default": 80 },
    { "type": "range", "id": "heading_size_mobile", "label": "Kopgrootte (mobiel)", "min": 20, "max": 80, "step": 2, "unit": "px", "default": 40 },
    { "type": "range", "id": "eyebrow_size", "label": "Grootte bovenregel", "min": 9, "max": 24, "step": 1, "unit": "px", "default": 11 },
    { "type": "range", "id": "lead_size", "label": "Introtekst grootte", "min": 12, "max": 28, "step": 1, "unit": "px", "default": 17 },
    { "type": "checkbox", "id": "heading_uppercase", "label": "Kop in hoofdletters", "default": true },
    { "type": "checkbox", "id": "heading_italic", "label": "Kop cursief", "default": true },
    { "type": "header", "content": "Opmaak" },
    {
      "type": "select",
      "id": "section_width",
      "label": "Breedte van de inhoud",
      "options": [
        { "value": "narrow", "label": "Smal" },
        { "value": "page", "label": "Pagina" },
        { "value": "full", "label": "Volledige breedte" }
      ],
      "default": "page"
    },
    {
      "type": "select",
      "id": "text_align",
      "label": "Tekst uitlijnen",
      "options": [
        { "value": "left", "label": "Links" },
        { "value": "center", "label": "Gecentreerd" },
        { "value": "right", "label": "Rechts" }
      ],
      "default": "left"
    },
    { "type": "color", "id": "bg_color", "label": "Achtergrondkleur", "default": "#000000" },
    { "type": "color", "id": "text_color", "label": "Tekstkleur", "default": "#ffffff" },
    { "type": "color", "id": "eyebrow_color", "label": "Kleur bovenregel", "default": "#ccff00" },
    { "type": "color", "id": "heading_color", "label": "Kleur kop" },
    { "type": "color", "id": "lead_color", "label": "Kleur introtekst" },
    { "type": "checkbox", "id": "animate", "label": "Animatie aan", "default": true },
    { "type": "header", "content": "Ruimte" },
    { "type": "range", "id": "padding_top", "label": "Ruimte boven (desktop)", "min": 0, "max": 240, "step": 4, "unit": "px", "default": 72 },
    { "type": "range", "id": "padding_bottom", "label": "Ruimte onder (desktop)", "min": 0, "max": 240, "step": 4, "unit": "px", "default": 56 },
    { "type": "range", "id": "padding_top_mobile", "label": "Ruimte boven (mobiel)", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "padding_bottom_mobile", "label": "Ruimte onder (mobiel)", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 40 }
  ],
  "presets": [
    { "name": "Juridisch: Kop" }
  ]
}
{% endschema %}
