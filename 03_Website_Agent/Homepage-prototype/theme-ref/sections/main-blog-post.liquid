

{% liquid
  if section.settings.background_color != blank
    render 'contrast-override', background_color: section.settings.background_color, section_id: section.id
  endif
%}

<div
  class="section-background{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
></div>
<div class="section hg-blog{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}">
  <div
    class="
      spacing-style
      layout-panel-flex
      layout-panel-flex--column
      section-content-wrapper
      mobile-column
    "
    style="
      {% render 'layout-panel-style', settings: section.settings %}
      {% render 'spacing-style', settings: section.settings %}
    "
  >
    {% content_for 'blocks' %}

    {% if blog.comments_enabled? %}
      <div class="blog-post-comments-container">
        <h2 class="h3">{{- 'blogs.article.comments_heading' | t: count: article.comments_count -}}</h2>

        <div class="blog-post-comments">
          {% paginate article.comments by 10 %}
            {% for comment in article.comments %}
              <div class="blog-post-comment">
                {{ comment.content }}
                <div class="blog-post-comment__author">
                  <span class="blog-post-comment__author-name">{{- comment.author -}}</span>
                  <span>{{- 'blogs.article.comment_author_separator' | t -}}</span>
                  <span class="blog-post-comment__date">
                    {{- comment.created_at | time_tag: format: 'date' -}}
                  </span>
                </div>
              </div>
            {% endfor %}

            <div class="blog-post-comments-pagination">
              {{- paginate | default_pagination -}}
            </div>
          {% endpaginate %}
        </div>

        {% render 'blog-comment-form', article: article, section_id: section.id %}
      </div>
    {% endif %}
  </div>
</div>

<script type="application/ld+json">
  {{ article | structured_data }}
</script>

{% stylesheet %}
  /* HÏ Grip blogstijl: bredere leeskolom, Poppins, krappe zwarte koppen met accent */
  .hg-blog {
    --hg-blog-text-width: 56rem;
    --hg-blog-wide-width: 72rem;
    --hg-blog-ink: #0a0a0a;
    --hg-blog-soft: #33312d;
    --hg-blog-accent: #0011a7;
    --hg-blog-line: #e4e2dc;
    --hg-blog-surface: #f4f3ef;

    font-family: var(--font-body--family, 'Poppins', system-ui, sans-serif);
  }

  .hg-blog .section-content-wrapper {
    padding-block: clamp(32px, 5vw, 72px);
  }

  /* Alles in dezelfde bredere kolom, links uitgelijnd */
  .hg-blog.hg-blog .text-block,
  .hg-blog.hg-blog .blog-post-content,
  .hg-blog .blog-post-comments-container {
    width: 100%;
    max-width: var(--hg-blog-text-width);
    margin-inline: auto;
    text-align: left;
  }

  .hg-blog.hg-blog .text-block > * {
    --max-width: 100%;

    max-inline-size: 100%;
    text-align: left;
  }

  .hg-blog .blog-post-featured-image {
    width: 100%;
    max-width: var(--hg-blog-wide-width);
    margin-inline: auto;
    border-radius: 8px;
    overflow: hidden;
  }

  /* Titel: zelfde stijl als de HÏ Grip hero */
  .hg-blog.hg-blog .text-block h1 {
    margin: 0;
    font-size: clamp(30px, 4.2vw, 56px);
    line-height: 1.04;
    font-weight: 900;
    font-style: italic;
    letter-spacing: -0.045em;
    text-transform: uppercase;
    text-wrap: balance;
    padding-bottom: 0.06em;
    color: var(--hg-blog-ink);
  }

  /* Datum / auteur als label */
  .hg-blog .blog-post-info-text,
  .hg-blog [class*='blog-post-details'] {
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--hg-blog-soft);
  }

  /* Tekst */
  .hg-blog.hg-blog .text-block p,
  .hg-blog.hg-blog .text-block li,
  .hg-blog.hg-blog .blog-post-content p,
  .hg-blog.hg-blog .blog-post-content li {
    font-size: 18px;
    line-height: 1.75;
    color: var(--hg-blog-soft);
  }

  .hg-blog.hg-blog .text-block p,
  .hg-blog.hg-blog .blog-post-content p {
    margin: 0 0 1.15em;
  }

  /* Eerste alinea = het korte antwoord, zoals in het concept-blog */
  .hg-blog.hg-blog .blog-post-content > rte-formatter > p:first-child {
    margin-bottom: 2em;
    padding: 22px 24px;
    border-left: 4px solid var(--hg-blog-accent);
    border-radius: 0 8px 8px 0;
    background: var(--hg-blog-surface);
    font-size: 20px;
    line-height: 1.6;
    font-weight: 500;
    color: var(--hg-blog-ink);
  }

  .hg-blog tbody tr:nth-child(even) {
    background: var(--hg-blog-surface);
  }

  .hg-blog td:first-child {
    font-weight: 700;
    color: var(--hg-blog-ink);
  }

  .hg-blog strong {
    color: var(--hg-blog-ink);
  }

  /* Koppen binnen het artikel */
  .hg-blog.hg-blog .text-block h2,
  .hg-blog.hg-blog .text-block h3,
  .hg-blog.hg-blog .blog-post-content h2,
  .hg-blog.hg-blog .blog-post-content h3 {
    color: var(--hg-blog-ink);
    font-weight: 800;
    text-transform: uppercase;
    text-wrap: balance;
    scroll-margin-top: 110px;
  }

  .hg-blog.hg-blog .text-block h2,
  .hg-blog.hg-blog .blog-post-content h2 {
    margin: 1.4em 0 0.5em;
    font-size: clamp(26px, 3vw, 40px);
    line-height: 1.06;
    font-weight: 900;
    font-style: italic;
    letter-spacing: -0.04em;
  }

  .hg-blog.hg-blog .text-block h3,
  .hg-blog.hg-blog .blog-post-content h3 {
    margin: 1.6em 0 0.5em;
    font-size: 19px;
    line-height: 1.2;
    letter-spacing: -0.02em;
  }

  .hg-blog.hg-blog .text-block a,
  .hg-blog.hg-blog .blog-post-content a {
    color: var(--hg-blog-ink);
    font-weight: 600;
    text-decoration: underline;
    text-decoration-color: var(--hg-blog-accent);
    text-decoration-thickness: 2px;
    text-underline-offset: 3px;
  }

  .hg-blog.hg-blog .text-block ul,
  .hg-blog.hg-blog .text-block ol,
  .hg-blog.hg-blog .blog-post-content ul,
  .hg-blog.hg-blog .blog-post-content ol {
    margin: 0 0 1.4em;
    padding-left: 0;
    list-style: none;
  }

  .hg-blog.hg-blog .text-block li,
  .hg-blog.hg-blog .blog-post-content li {
    position: relative;
    margin-bottom: 0.55em;
    padding-left: 28px;
  }

  .hg-blog.hg-blog .text-block ul > li::before,
  .hg-blog.hg-blog .blog-post-content ul > li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.78em;
    width: 14px;
    height: 3px;
    background: var(--hg-blog-accent);
  }

  .hg-blog.hg-blog .text-block img,
  .hg-blog.hg-blog .blog-post-content img {
    display: block;
    width: 100%;
    height: auto;
    margin: 2em 0;
    border-radius: 8px;
  }

  .hg-blog.hg-blog .text-block blockquote,
  .hg-blog.hg-blog .blog-post-content blockquote {
    margin: 2em 0;
    padding: 4px 0 4px 22px;
    border-left: 4px solid var(--hg-blog-ink);
    font-size: 20px;
    line-height: 1.5;
    font-weight: 600;
    font-style: italic;
    color: var(--hg-blog-ink);
  }

  .hg-blog table {
    width: 100% !important;
    border-collapse: collapse;
    font-size: 15px;
    line-height: 1.5;
  }

  .hg-blog :is(th, td) {
    padding: 14px 18px;
    text-align: left;
    vertical-align: top;
    border-bottom: 1px solid var(--hg-blog-line);
  }

  .hg-blog th {
    background: var(--hg-blog-ink);
    color: #fff;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  @media screen and (max-width: 749px) {
    .hg-blog.hg-blog .text-block p,
    .hg-blog.hg-blog .text-block li,
    .hg-blog.hg-blog .blog-post-content p,
    .hg-blog.hg-blog .blog-post-content li {
      font-size: 16px;
    }
  }

  .blog-post-comments-container {
    width: 100%;
    max-width: var(--normal-content-width);
    margin: 0 auto;
  }

  .blog-post-comments {
    display: flex;
    flex-direction: column;
    gap: var(--gap-3xl);
  }

  .blog-post-comment__author {
    display: flex;
    align-items: center;
    gap: var(--gap-2xs);
    margin-top: var(--margin-md);
    font-size: var(--font-size--body-sm);
    color: rgb(var(--color-foreground-rgb) / var(--opacity-subdued-text));
  }

  .blog-post-comments-pagination {
    display: flex;
    justify-content: center;
    gap: var(--gap-2xs);
  }

  .blog-post-comments-pagination,
  .blog-post-comments-pagination a {
    color: var(--color-foreground);
  }

  .blog-post-comments-pagination .current {
    color: var(--color-foreground);
  }

  .blog-post-comments-pagination .current,
  .blog-post-comments-pagination a {
    display: block;
    padding: var(--padding-2xs) var(--padding-xs);
  }

  .blog-post-comments-pagination .current,
  .blog-post-comments-pagination a:hover {
    border-bottom: 1px solid var(--color-foreground);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.blog_post",
  "blocks": [
    {
      "type": "@theme"
    },
    {
      "type": "@app"
    },
    {
      "type": "_blog-post-title"
    },
    {
      "type": "_blog-post-info-text"
    },
    {
      "type": "_blog-post-featured-image"
    },
    {
      "type": "_blog-post-content"
    }
  ],
  "class": "section-wrapper",
  "settings": [
    {
      "type": "select",
      "id": "content_direction",
      "label": "t:settings.direction",
      "options": [
        {
          "value": "column",
          "label": "t:options.vertical"
        }
      ],
      "default": "column",
      "visible_if": "{{ section.settings.gap < 0 }}"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "t:settings.gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": []
}
{% endschema %}
