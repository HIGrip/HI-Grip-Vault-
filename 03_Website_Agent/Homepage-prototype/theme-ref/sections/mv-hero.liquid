<section class="mv-hero mv-band-black{{ '' }}{%- if s.custom_pad %} mv-custom-pad{% endif -%}" data-ab="hero" aria-labelledby="hero-title" {% render 'mv-attrs', s: s %} style="{% render 'mv-vars', s: s %}">
  <div class="mv-hero__frame">
    <div class="mv-hero__media">
      {%- if s.image != blank -%}
        {{ s.image | image_url: width: 1800 | image_tag: loading: 'eager', fetchpriority: 'high', alt: s.image_alt, widths: '800, 1200, 1600, 1800', sizes: '100vw' }}
      {%- else -%}
        <img width="1400" height="1658" fetchpriority="high" decoding="async" alt="{{ s.image_alt | escape }}" src="{{ 'mv-hero-tennis-serve.jpg' | asset_url }}">
      {%- endif -%}
    </div>
    <div class="mv-hero__txt">
      <div class="mv-wrap">
        <h1 class="mv-h1" id="hero-title">
          {%- for block in section.blocks -%}
            {%- if block.type == 'regel' -%}<span class="mv-l"{% render 'mv-ta', d: block.settings.align, m: block.settings.align_m %} {{ block.shopify_attributes }}>{{ block.settings.tekst }}</span>{%- endif -%}
          {%- endfor -%}
        </h1>
      </div>
    </div>
  </div>
</section>
</div>
