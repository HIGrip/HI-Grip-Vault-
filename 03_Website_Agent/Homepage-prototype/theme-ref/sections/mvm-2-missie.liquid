{{ 'mv-page.css' | asset_url | stylesheet_tag }}
<script src="{{ 'mv-page.js' | asset_url }}" defer></script>
{%- assign s = section.settings -%}
<div class="mv">
<script>document.currentScript.parentNode.classList.add("mv-js");window.MV_ASSETS=window.MV_ASSETS||{};MV_ASSETS['gripsokken-tennisclub.jpg']={{ 'mv-gripsokken-tennisclub.jpg' | asset_url | json }};MV_ASSETS['hero-tennis-serve.jpg']={{ 'mv-hero-tennis-serve.jpg' | asset_url | json }};MV_ASSETS['rotterdam-business-school.jpg']={{ 'mv-rotterdam-business-school.jpg' | asset_url | json }};</script>
<section class="mv-band-light mv-pad{%- if s.custom_pad %} mv-custom-pad{% endif -%}" data-ab="plain" aria-labelledby="mv-title" style="{%- if s.bg_color != blank -%}background:{{ s.bg_color }};{%- endif -%}{%- if s.text_color != blank -%}color:{{ s.text_color }};{%- endif -%}--mv-pt:{{ s.padding_top }}px;--mv-pb:{{ s.padding_bottom }}px;--mv-pt-m:{{ s.padding_top_mobile }}px;--mv-pb-m:{{ s.padding_bottom_mobile }}px;--mv-len:{{ s.scroll_length }}vh;--mv-len-m:{{ s.scroll_length_mobile }}vh;" data-ta="{{ s.text_align }}" data-ta-m="{{ s.text_align_m }}" data-w="{{ s.section_width }}" data-anim="{{ s.animate }}"> <div class="mv-wrap"> <div class="mv-mv__head"> <h2 class="mv-h2 mv-rv" id="mv-title">{{ s.t1 }}</h2> <p class="mv-lead mv-rv" style="--d:.12s">{{ s.t2 | escape }}</p> </div> <div class="mv-mv__stack"> <div class="mv-mv__row mv-rv"> <h3>{{ s.t3 | escape }}</h3> <div class="mv-mv__body"> <p class="mv-mv__big">{{ s.t4 | escape }}</p> <p class="mv-muted">{{ s.t5 | escape }}</p> </div> </div> <div class="mv-mv__row mv-rv"> <h3>{{ s.t6 | escape }}</h3> <div class="mv-mv__body"> <p class="mv-mv__big">{{ s.t7 | escape }}</p> <p>{{ s.t8 | escape }}</p> <div class="mv-mv__values" aria-label="Kernwaarden"> {%- for block in section.blocks -%}{%- if block.type == 'b1' -%}{%- assign b = block.settings -%}<span {{ block.shopify_attributes }}><b>{{ b.t1 | escape }}</b> {{ b.t2 | escape }}</span>{%- endif -%}{%- endfor -%}   </div> <p class="mv-muted">{{ s.t9 | escape }} <a class="mv-textlink" href="{{ s.url10 | default: 'https://www.higrip.nl/pages/over-ons' }}">{{ s.t11 | escape }}</a>.</p> </div> </div> <div class="mv-mv__row mv-rv"> <h3>{{ s.t12 | escape }}</h3> <div class="mv-mv__body"> <p class="mv-mv__big">{{ s.t13 | escape }}</p> <p class="mv-muted">{{ s.t14 | escape }}</p> </div> </div> </div> </div> </section>
</div>
