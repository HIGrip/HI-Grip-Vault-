{{ 'mv-page.css' | asset_url | stylesheet_tag }}
<script src="{{ 'mv-page.js' | asset_url }}" defer></script>
{%- assign s = section.settings -%}
<div class="mv">
<script>document.currentScript.parentNode.classList.add("mv-js");window.MV_ASSETS=window.MV_ASSETS||{};MV_ASSETS['gripsokken-tennisclub.jpg']={{ 'mv-gripsokken-tennisclub.jpg' | asset_url | json }};MV_ASSETS['hero-tennis-serve.jpg']={{ 'mv-hero-tennis-serve.jpg' | asset_url | json }};MV_ASSETS['rotterdam-business-school.jpg']={{ 'mv-rotterdam-business-school.jpg' | asset_url | json }};</script>
<section class="mv-band-dark mv-pad{%- if s.custom_pad %} mv-custom-pad{% endif -%}" data-ab="principles" aria-labelledby="why-title" style="{%- if s.bg_color != blank -%}background:{{ s.bg_color }};{%- endif -%}{%- if s.text_color != blank -%}color:{{ s.text_color }};{%- endif -%}--mv-pt:{{ s.padding_top }}px;--mv-pb:{{ s.padding_bottom }}px;--mv-pt-m:{{ s.padding_top_mobile }}px;--mv-pb-m:{{ s.padding_bottom_mobile }}px;--mv-len:{{ s.scroll_length }}vh;--mv-len-m:{{ s.scroll_length_mobile }}vh;" data-ta="{{ s.text_align }}" data-ta-m="{{ s.text_align_m }}" data-w="{{ s.section_width }}" data-anim="{{ s.animate }}"> <div class="mv-wrap"> <div class="mv-why__head"> <h2 class="mv-h2 mv-rv" id="why-title">{{ s.t1 }}</h2> <p class="mv-lead mv-muted mv-rv" style="--d:.12s">{{ s.t2 | escape }}</p> </div> <div class="mv-why__sub mv-rv"> <h3>{{ s.t3 | escape }}</h3> <p>{{ s.t4 | escape }}</p> </div> <ol class="mv-principles"> <li class="mv-pr"> <p class="mv-pr__big" data-w="High-end" aria-hidden="true">{{ s.t5 | escape }}</p> <div class="mv-pr__txt"><h3>{{ s.t6 | escape }}</h3><p class="mv-muted">{{ s.t7 | escape }}</p></div> </li> <li class="mv-pr"> <p class="mv-pr__big" data-w="Eerlijk" aria-hidden="true">{{ s.t8 | escape }}</p> <div class="mv-pr__txt"><h3>{{ s.t9 | escape }}</h3><p class="mv-muted">{{ s.t10 | escape }}</p></div> </li> <li class="mv-pr"> <p class="mv-pr__big" data-w="DNA" aria-hidden="true">{{ s.t11 | escape }}</p> <div class="mv-pr__txt"><h3>{{ s.t12 | escape }}</h3><p class="mv-muted">{{ s.t13 | escape }}</p></div> </li> <li class="mv-pr"> <p class="mv-pr__big" data-w="110%" aria-hidden="true">{{ s.t14 | escape }}</p> <div class="mv-pr__txt"><h3>{{ s.t15 | escape }}</h3><p class="mv-muted">{{ s.t16 | escape }}</p></div> </li> <li class="mv-pr"> <p class="mv-pr__big" data-w="Never give up" aria-hidden="true">{{ s.t17 | escape }}</p> <div class="mv-pr__txt"><h3>{{ s.t18 | escape }}</h3><p class="mv-muted">{{ s.t19 | escape }}</p></div> </li> </ol> </div> </section>
</div>
