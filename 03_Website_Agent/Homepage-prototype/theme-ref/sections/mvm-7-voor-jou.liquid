{{ 'mv-page.css' | asset_url | stylesheet_tag }}
<script src="{{ 'mv-page.js' | asset_url }}" defer></script>
{%- assign s = section.settings -%}
<div class="mv">
<script>document.currentScript.parentNode.classList.add("mv-js");window.MV_ASSETS=window.MV_ASSETS||{};MV_ASSETS['gripsokken-tennisclub.jpg']={{ 'mv-gripsokken-tennisclub.jpg' | asset_url | json }};MV_ASSETS['hero-tennis-serve.jpg']={{ 'mv-hero-tennis-serve.jpg' | asset_url | json }};MV_ASSETS['rotterdam-business-school.jpg']={{ 'mv-rotterdam-business-school.jpg' | asset_url | json }};</script>
<section class="mv-band-warm mv-pad{%- if s.custom_pad %} mv-custom-pad{% endif -%}" data-ab="plain" aria-labelledby="you-title" style="{%- if s.bg_color != blank -%}background:{{ s.bg_color }};{%- endif -%}{%- if s.text_color != blank -%}color:{{ s.text_color }};{%- endif -%}--mv-pt:{{ s.padding_top }}px;--mv-pb:{{ s.padding_bottom }}px;--mv-pt-m:{{ s.padding_top_mobile }}px;--mv-pb-m:{{ s.padding_bottom_mobile }}px;--mv-len:{{ s.scroll_length }}vh;--mv-len-m:{{ s.scroll_length_mobile }}vh;" data-ta="{{ s.text_align }}" data-ta-m="{{ s.text_align_m }}" data-w="{{ s.section_width }}" data-anim="{{ s.animate }}"> <div class="mv-wrap mv-you"> <figure class="mv-you__img mv-rv"> <img width="1000" height="1013" loading="lazy" decoding="async" alt="{{ s.t2 | escape }}" src="{%- if s.ima1 != blank -%}{{ s.ima1 | image_url: width: 1000 }}{%- else -%}{{ 'mv-gripsokken-tennisclub.jpg' | asset_url }}{%- endif -%}"> </figure> <div class="mv-you__copy"> <div class="mv-rv"> <h2 class="mv-h2" id="you-title">{{ s.t3 }}</h2> <p class="mv-lead">{{ s.t4 | escape }}</p> <p class="mv-more mv-muted">{{ s.t5 | escape }}</p> </div> <div class="mv-stat mv-rv" role="group" aria-label="Wetenschappelijk onderzoek naar gripsokken"> <div class="mv-stat__nums"> <div><b>{{ s.t6 | escape }}</b><span>{{ s.t7 | escape }}</span></div> <div class="mv-vs"><b>{{ s.t8 | escape }}</b><span>{{ s.t9 | escape }}</span></div> </div> <p>{{ s.t10 | escape }}</p> <cite>{{ s.t11 | escape }} <i>{{ s.t12 | escape }}</i>{{ s.t13 | escape }}</cite> </div> <div class="mv-you__cta mv-rv"> <a class="mv-pill mv-pill--dark" href="{{ s.url14 | default: 'https://www.higrip.nl/products/performance-gripsokken' }}">{{ s.t15 | escape }}</a> <a class="mv-textlink" href="{{ s.url16 | default: 'https://www.higrip.nl/products/performance-gripsokken-2-0-zwart' }}">{{ s.t17 | escape }}</a> </div> </div> </div> </section>
</div>
