<section class="mv-hero mv-hero--run mv-band-black{%- if s.custom_pad %} mv-custom-pad{% endif -%}" data-ab="hero" aria-labelledby="hero-title" style="{%- if s.bg_color != blank -%}background:{{ s.bg_color }};{%- endif -%}{%- if s.text_color != blank -%}color:{{ s.text_color }};{%- endif -%}--mv-pt:{{ s.padding_top }}px;--mv-pb:{{ s.padding_bottom }}px;--mv-pt-m:{{ s.padding_top_mobile }}px;--mv-pb-m:{{ s.padding_bottom_mobile }}px;--mv-len:{{ s.scroll_length }}vh;--mv-len-m:{{ s.scroll_length_mobile }}vh;" data-ta="{{ s.text_align }}" data-ta-m="{{ s.text_align_m }}" data-w="{{ s.section_width }}" data-anim="{{ s.animate }}"> <div class="mv-hero__frame"> <div class="mv-hero__media"> <img width="1102" height="1102" fetchpriority="high" decoding="async" alt="{{ s.t2 | escape }}" src="{%- if s.ima1 != blank -%}{{ s.ima1 | image_url: width: 1102 }}{%- else -%}{{ 'mv-hardlopen-gripsokken.jpg' | asset_url }}{%- endif -%}"> </div> <div class="mv-hero__txt"> <div class="mv-wrap"> <h1 class="mv-h1" id="hero-title"> <span class="mv-l">{{ s.t3 | escape }}</span> <span class="mv-l">{{ s.t4 | escape }}</span> <span class="mv-l">{{ s.t5 }}</span> </h1> </div> </div> </div> </section>
</div>
{% schema %}
{
  "name": "Visie: Hero",
  "settings": [
    {
      "type": "image_picker",
      "id": "ima1",
      "label": "Afbeelding · hardlopen-gripsokken.jpg"
    },
    {
      "type": "text",
      "id": "t2",
      "label": "Alt-tekst · hardlopen-gripsokken.jpg",
      "default": "Hardloper in witte HÏ Grip-gripsokken loopt over een fietspad tussen het groen, van achteren gezien"
    },
    {
      "type": "text",
      "id": "t3",
      "label": "SPAN · Een generatie",
      "default": "Een generatie"
    },
    {
      "type": "text",
      "id": "t4",
      "label": "SPAN · die blijft gaan,",
      "default": "die blijft gaan,"
    },
    {
      "type": "inline_richtext",
      "id": "t5",
      "label": "SPAN · blijft groeien.",
      "default": "<em>blijft groeien.</em>"
    },
    {
      "type": "header",
      "content": "Opmaak"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Achtergrondkleur"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Tekstkleur"
    },
    {
      "type": "select",
      "id": "text_align",
      "label": "Tekst uitlijnen (desktop)",
      "options": [
        {
          "value": "",
          "label": "Standaard"
        },
        {
          "value": "left",
          "label": "Links"
        },
        {
          "value": "center",
          "label": "Gecentreerd"
        },
        {
          "value": "right",
          "label": "Rechts"
        }
      ],
      "default": ""
    },
    {
      "type": "select",
      "id": "text_align_m",
      "label": "Tekst uitlijnen (mobiel)",
      "options": [
        {
          "value": "",
          "label": "Standaard"
        },
        {
          "value": "left",
          "label": "Links"
        },
        {
          "value": "center",
          "label": "Gecentreerd"
        },
        {
          "value": "right",
          "label": "Rechts"
        }
      ],
      "default": ""
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Breedte",
      "options": [
        {
          "value": "",
          "label": "Pagina"
        },
        {
          "value": "full",
          "label": "Volledig"
        }
      ],
      "default": ""
    },
    {
      "type": "checkbox",
      "id": "custom_pad",
      "label": "Eigen padding gebruiken",
      "default": false
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding boven",
      "min": 0,
      "max": 240,
      "step": 4,
      "unit": "px",
      "default": 96
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding onder",
      "min": 0,
      "max": 240,
      "step": 4,
      "unit": "px",
      "default": 96
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Padding boven (mobiel)",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 52
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Padding onder (mobiel)",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 52
    },
    {
      "type": "checkbox",
      "id": "animate",
      "label": "Animaties aan",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Visie: Hero"
    }
  ]
}
{% endschema %}
