{"@type":"ItemList","@id":"https://www.higrip.nl/collections/gripsokken#itemlist","numberOfItems":3,"itemListElement":[
{"@type":"ListItem","position":1,"url":"https://www.higrip.nl/products/performance-gripsokken","name":"Performance Gripsokken"},
{"@type":"ListItem","position":2,"url":"https://www.higrip.nl/products/performance-gripsokken-2-0-zwart","name":"Performance Gripsokken 2.0 Zwart"},
