<div class="sh-bar{%- if s.custom_pad %} sh-custom-pad{% endif -%}" aria-label="Voordelen" style="{%- if s.bg_color != blank -%}background:{{ s.bg_color }};{%- endif -%}{%- if s.text_color != blank -%}color:{{ s.text_color }};{%- endif -%}--sh-pt:{{ s.padding_top }}px;--sh-pb:{{ s.padding_bottom }}px;--sh-pt-m:{{ s.padding_top_mobile }}px;--sh-pb-m:{{ s.padding_bottom_mobile }}px;--sh-len:{{ s.scroll_length }}vh;--sh-len-m:{{ s.scroll_length_mobile }}vh;" data-ta="{{ s.text_align }}" data-ta-m="{{ s.text_align_m }}" data-w="{{ s.section_width }}" data-anim="{{ s.animate }}"> <ul> {%- for block in section.blocks -%}{%- if block.type == 'b1' -%}{%- assign b = block.settings -%}<li {{ block.shopify_attributes }}>{{ b.t1 | escape }}</li>{%- endif -%}{%- endfor -%}    {%- for block in section.blocks -%}{%- if block.type == 'b2' -%}{%- assign b = block.settings -%}<li aria-hidden="true" {{ block.shopify_attributes }}>{{ b.t1 | escape }}</li>{%- endif -%}{%- endfor -%}    </ul> </div>
</div>
{% schema %}
{
  "name": "Shop: USP-balk",
