{{ 'sh-page.css' | asset_url | stylesheet_tag }}
<script src="{{ 'sh-page.js' | asset_url }}" defer></script>
{%- assign s = section.settings -%}
<div class="sh">
<script>document.currentScript.parentNode.classList.add("sh-js");window.MV_ASSETS=window.MV_ASSETS||{};MV_ASSETS['sok-10.webp']={{ 'sh-sok-10.webp' | asset_url | json }};MV_ASSETS['sok-20-wit.webp']={{ 'sh-sok-20-wit.webp' | asset_url | json }};MV_ASSETS['sok-20-zwart.webp']={{ 'sh-sok-20-zwart.webp' | asset_url | json }};MV_ASSETS['sq-padel.webp']={{ 'sh-sq-padel.webp' | asset_url | json }};MV_ASSETS['sq-tennis.webp']={{ 'sh-sq-tennis.webp' | asset_url | json }};</script>
{% raw %}<script type="application/ld+json">
{"@context":"https://schema.org","@graph":[
