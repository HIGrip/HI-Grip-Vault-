{{ 'padel-page.css' | asset_url | stylesheet_tag }}
{{ 'shop-page.css' | asset_url | stylesheet_tag }}

<section class="hgshop-hero hgshop-grid-bg">
  <div class="hgshop-hero__inner">
    {%- if section.settings.eyebrow != blank -%}
      <span class="hgshop-eyebrow"><span class="dot"></span> {{ section.settings.eyebrow }}</span>
    {%- endif -%}
    <h1>{{ section.settings.heading }}</h1>
    {%- if section.settings.subtext != blank -%}
      <p class="hgshop-sub">{{ section.settings.subtext }}</p>
    {%- endif -%}
    <div class="hgshop-hero-trust">
      <span class="hgshop-stars" aria-hidden="true">&#9733;&#9733;&#9733;&#9733;&#9733;</span>
      {%- if section.settings.rating_text != blank -%}<span>{{ section.settings.rating_text }}</span>{%- endif -%}
      {%- if section.settings.stat_chip_text != blank -%}<span class="hgshop-chip">{{ section.settings.stat_chip_text }}</span>{%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Shop hero",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow (bovenste label)", "default": "Nieuw — 3 maten · 2 kleuren" },
    { "type": "text", "id": "heading", "label": "Titel", "default": "Kies je maat. Kies je kleur. Blijf staan." },
    { "type": "textarea", "id": "subtext", "label": "Ondertekst", "default": "Van maat 35 tot 46, in zwart of wit. Dezelfde grip die 3.500+ sporters al vertrouwen — nu in jouw maat en kleur." },
    { "type": "text", "id": "rating_text", "label": "Beoordelingstekst", "default": "4.5 · gedragen door 3.500+ sporters" },
    { "type": "text", "id": "stat_chip_text", "label": "Statistiek-badge", "default": "95% meer grip, wetenschappelijk getest" }
  ],
  "presets": [ { "name": "Shop hero" } ]
}
{% endschema %}
