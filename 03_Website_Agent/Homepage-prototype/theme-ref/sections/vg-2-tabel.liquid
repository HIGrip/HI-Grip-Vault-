      <tr class="d"><th scope="row">{{ s.t51 | escape }}</th><td><i class="no"><span class="sr">{{ s.t52 | escape }}</span></i></td><td class="v2"><i class="yes"><span class="sr">{{ s.t53 | escape }}</span></i></td></tr>
      <tr class="d"><th scope="row">{{ s.t54 | escape }}</th><td><span class="num">{{ s.t55 | escape }}<br>{{ s.t56 | escape }}</span></td><td class="v2"><span class="num">{{ s.t57 | escape }}<br>{{ s.t58 | escape }}<br>{{ s.t59 | escape }}</span></td></tr>
      <tr class="d"><th scope="row">{{ s.t60 | escape }}</th><td>{{ s.t61 | escape }}</td><td class="v2">{{ s.t62 | escape }}</td></tr>
        </tbody>
        <tbody>
