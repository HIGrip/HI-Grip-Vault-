        </tbody>
        <tfoot><tr><th></th><td><a class="btn btn--o btn--sm" href="{{ s.url72 | default: "https://www.higrip.nl/products/performance-gripsokken" }}">{{ s.t73 | escape }}</a></td><td class="v2"><a class="btn btn--k btn--sm" data-link-20 href="{{ s.url74 | default: "https://www.higrip.nl/products/performance-gripsokken-2-0-zwart" }}">{{ s.t75 | escape }}</a></td></tr></tfoot>
