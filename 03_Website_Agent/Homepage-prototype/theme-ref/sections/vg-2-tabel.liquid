      <tr class="d"><th scope="row">{{ s.t45 | escape }}</th><td><i class="no"><span class="sr">{{ s.t46 | escape }}</span></i></td><td class="v2"><i class="yes"><span class="sr">{{ s.t47 | escape }}</span></i></td></tr>
