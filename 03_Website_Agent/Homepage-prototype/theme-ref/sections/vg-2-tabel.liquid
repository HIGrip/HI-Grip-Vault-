{{ 'vg2-page.css' | asset_url | stylesheet_tag }}
<script src="{{ 'vg2-page.js' | asset_url }}" defer></script>
{%- assign s = section.settings -%}
<div class="vg2">
<section class="cmp{% if s.custom_pad %} vg2-pad{% endif %}" id="vergelijk" aria-labelledby="cmp-titel" style="{%- if s.bg_color != blank -%}background:{{ s.bg_color }};{%- endif -%}{%- if s.text_color != blank -%}color:{{ s.text_color }};{%- endif -%}--vg2-pt:{{ s.padding_top }}px;--vg2-pb:{{ s.padding_bottom }}px;--vg2-pt-m:{{ s.padding_top_mobile }}px;--vg2-pb-m:{{ s.padding_bottom_mobile }}px;">
    <div class="bar" aria-label="Koopbalk">
      <div class="wrap narrow">
        <div class="bar__g">
          <span class="sr">{{ s.t1 | escape }}</span>
          <div class="bar__c"><b>{{ s.t2 | escape }}</b><a class="btn btn--o" href="{{ s.url3 | default: "https://www.higrip.nl/products/performance-gripsokken" }}">{{ s.t4 | escape }} <svg viewbox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7"/></svg></a></div>
          <div class="bar__c"><b>{{ s.t5 | escape }}</b><a class="btn btn--k" data-link-20 href="{{ s.url6 | default: "https://www.higrip.nl/products/performance-gripsokken-2-0-zwart" }}">{{ s.t7 | escape }} <svg viewbox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7"/></svg></a></div>
        </div>
      </div>
    </div>

    <div class="wrap narrow">
      <h2 class="xh2 cmp__h rv" id="cmp-titel">{{ s.t8 | escape }} <em>{{ s.t9 | escape }}</em></h2>
      <table class="cmpt rv">
        <caption class="sr">{{ s.t10 | escape }}</caption>
        <colgroup><col class="c0"><col><col></colgroup>
        <thead><tr>
          <td></td>
          <th scope="col"><div class="ph"><div class="ph__img"><img src="{%- if s.ima11 != blank -%}{{ s.ima11 | image_url: width: 1200 }}{%- else -%}{{ 'vg-sok-10.webp' | asset_url }}{%- endif -%}" width="900" height="900" alt="{{ s.t12 | escape }}"></div><b>{{ s.t13 | escape }}</b><span class="ph__t">{{ s.t14 | escape }}</span><div class="pr__sw"><span class="sw__s" data-c="wit" title="Wit"><span></span></span></div></div></th>
          <th scope="col" class="v2"><div class="ph"><div class="ph__img"><img data-img-20 src="{%- if s.ima15 != blank -%}{{ s.ima15 | image_url: width: 1200 }}{%- else -%}{{ 'vg-sok-20-zwart.webp' | asset_url }}{%- endif -%}" width="900" height="900" alt="{{ s.t16 | escape }}"></div><b>{{ s.t17 | escape }}</b><span class="ph__t ph__t--v">{{ s.t18 | escape }}</span>
            <div class="pr__sw" role="group" aria-label="Kleur">
              <a class="sw__a" data-c="zwart" aria-current="true" href="{{ s.url19 | default: "https://www.higrip.nl/products/performance-gripsokken-2-0-zwart" }}"><span></span><b class="sr">{{ s.t20 | escape }}</b></a>
              <a class="sw__a" data-c="wit" aria-current="false" href="{{ s.url21 | default: "https://www.higrip.nl/products/performance-gripsokken-2-0-wit" }}"><span></span><b class="sr">{{ s.t22 | escape }}</b></a>
            </div></div></th>
        </tr></thead>
        <tbody>
      <tr class="grp"><th scope="colgroup" colspan="3">{{ s.t23 | escape }}</th></tr>
      <tr class="d"><th scope="row">{{ s.t24 | escape }}</th><td><span class="num">{{ s.t25 | escape }}</span><small>{{ s.t26 | escape }}</small></td><td class="v2"><span class="num">{{ s.t27 | escape }}</span><small>{{ s.t28 | escape }}</small></td></tr>
      <tr class="d"><th scope="row">{{ s.t29 | escape }}</th><td>{{ s.t30 | escape }}</td><td class="v2">{{ s.t31 | escape }}</td></tr>
      <tr class="d"><th scope="row">{{ s.t32 | escape }}</th><td>{{ s.t33 | escape }}<small class="num">{{ s.t34 | escape }}</small></td><td class="v2"><span class="num">{{ s.t35 | escape }}</span></td></tr>
