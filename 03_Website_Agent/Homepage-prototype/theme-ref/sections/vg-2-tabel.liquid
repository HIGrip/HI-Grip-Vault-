      <tr><th scope="row">{{ s.t64 | escape }}</th><td><i class="yes"><span class="sr">{{ s.t65 | escape }}</span></i></td><td class="v2"><i class="yes"><span class="sr">{{ s.t66 | escape }}</span></i></td></tr>
