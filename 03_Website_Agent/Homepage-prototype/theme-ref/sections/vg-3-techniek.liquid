{{ 'vg2-page.css' | asset_url | stylesheet_tag }}
<script src="{{ 'vg2-page.js' | asset_url }}" defer></script>
{%- assign s = section.settings -%}
<div class="vg2">
<section class="dark sec{% if s.custom_pad %} vg2-pad{% endif %}" aria-labelledby="tech-titel" style="{%- if s.bg_color != blank -%}background:{{ s.bg_color }};{%- endif -%}{%- if s.text_color != blank -%}color:{{ s.text_color }};{%- endif -%}--vg2-pt:{{ s.padding_top }}px;--vg2-pb:{{ s.padding_bottom }}px;--vg2-pt-m:{{ s.padding_top_mobile }}px;--vg2-pb-m:{{ s.padding_bottom_mobile }}px;">
    <div class="wrap">
      <div class="tech__head">
        <h2 class="xh2 rv" id="tech-titel">{{ s.t1 | escape }} <em>{{ s.t2 | escape }}</em></h2>
        <p class="lead rv d1">{{ s.t3 | escape }}</p>
      </div>
      <div class="tech__grid">
        <ol class="callouts rv">
          <li class="co" tabindex="0" data-p="1"><i>{{ s.t4 | escape }}</i><b>{{ s.t5 | escape }}</b><span>{{ s.t6 | escape }}</span></li>
          <li class="co" tabindex="0" data-p="2"><i>{{ s.t7 | escape }}</i><b>{{ s.t8 | escape }}</b><span>{{ s.t9 | escape }}</span></li>
          <li class="co" tabindex="0" data-p="3"><i>{{ s.t10 | escape }}</i><b>{{ s.t11 | escape }}</b><span>{{ s.t12 | escape }}</span></li>
          <li class="co" tabindex="0" data-p="4"><i>{{ s.t13 | escape }}</i><b>{{ s.t14 | escape }}</b><span>{{ s.t15 | escape }}</span></li>
        </ol>
        <figure class="tech__fig rv d1">
          <img src="{%- if s.ima16 != blank -%}{{ s.ima16 | image_url: width: 1200 }}{%- else -%}{{ 'vg-sok-20-zwart.webp' | asset_url }}{%- endif -%}" width="900" height="900" alt="{{ s.t17 | escape }}" loading="lazy">
          <span class="pt" data-p="1" style="left:48%;top:28%" aria-hidden="true">{{ s.t18 | escape }}</span>
          <span class="pt" data-p="2" style="left:45%;top:44%" aria-hidden="true">{{ s.t19 | escape }}</span>
          <span class="pt" data-p="3" style="left:53%;top:58%" aria-hidden="true">{{ s.t20 | escape }}</span>
          <span class="pt" data-p="4" style="left:34%;top:83%" aria-hidden="true">{{ s.t21 | escape }}</span>
          <span class="pt" data-p="5" style="left:70%;top:52%" aria-hidden="true">{{ s.t22 | escape }}</span>
          <span class="pt" data-p="6" style="left:74%;top:70%" aria-hidden="true">{{ s.t23 | escape }}</span>
          <span class="pt" data-p="7" style="left:57%;top:89%" aria-hidden="true">{{ s.t24 | escape }}</span>
          <span class="pt" data-p="8" style="left:42%;top:14%" aria-hidden="true">{{ s.t25 | escape }}</span>
        </figure>
        <ol class="callouts rv d2" start="5">
          <li class="co" tabindex="0" data-p="5"><i>{{ s.t26 | escape }}</i><b>{{ s.t27 | escape }}</b><span>{{ s.t28 | escape }}</span></li>
          <li class="co" tabindex="0" data-p="6"><i>{{ s.t29 | escape }}</i><b>{{ s.t30 | escape }}</b><span>{{ s.t31 | escape }}</span></li>
          <li class="co" tabindex="0" data-p="7"><i>{{ s.t32 | escape }}</i><b>{{ s.t33 | escape }}</b><span>{{ s.t34 | escape }}</span></li>
          <li class="co" tabindex="0" data-p="8"><i>{{ s.t35 | escape }}</i><b>{{ s.t36 | escape }}</b><span>{{ s.t37 | escape }}</span></li>
        </ol>
      </div>
      <div class="tech__foot">
        <p><b>{{ s.t38 | escape }}</b> {{ s.t39 | escape }}</p>
        <a class="btn btn--w" data-link-20 href="{{ s.url40 | default: "https://www.higrip.nl/products/performance-gripsokken-2-0-zwart" }}">{{ s.t41 | escape }} <svg viewbox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7"/></svg></a>
      </div>
    </div>
  </section>
</div>
