{{ 'vg2-page.css' | asset_url | stylesheet_tag }}
<script src="{{ 'vg2-page.js' | asset_url }}" defer></script>
{%- assign s = section.settings -%}
<div class="vg2">
<section class="warm sec{% if s.custom_pad %} vg2-pad{% endif %}" aria-labelledby="story-titel" style="{%- if s.bg_color != blank -%}background:{{ s.bg_color }};{%- endif -%}{%- if s.text_color != blank -%}color:{{ s.text_color }};{%- endif -%}--vg2-pt:{{ s.padding_top }}px;--vg2-pb:{{ s.padding_bottom }}px;--vg2-pt-m:{{ s.padding_top_mobile }}px;--vg2-pb-m:{{ s.padding_bottom_mobile }}px;">
    <div class="wrap story">
      <figure class="story__img rv"><img src="{%- if s.ima1 != blank -%}{{ s.ima1 | image_url: width: 1200 }}{%- else -%}{{ 'vg-lif-padel.webp' | asset_url }}{%- endif -%}" width="900" height="1100" alt="{{ s.t2 | escape }}" loading="lazy"></figure>
      <div class="story__txt rv d1">
        <h2 class="xh2" id="story-titel">{{ s.t3 | escape }} <em>{{ s.t4 | escape }}</em></h2>
        <p class="lead">{{ s.t5 | escape }}</p>
        <ul class="feat3">
          <li><svg class="ic" viewbox="0 0 96 96" aria-hidden="true"><path d="M75.19 39.95 46 79.95H36.49L32.58 75.05L42.36 72.97L41.12 67.1L30.36 69.39L24.78 62.4L37.5 59.69L36.25 53.83L21.58 56.94L16 49.95L19.07 47.49L45.17 37.61Q45.81 37.87 46.88 38.52Q50.1 40.47 52.51 40.87L52.72 40.9L52.94 40.92Q57.91 41.39 61.24 38.73Q64.78 35.89 65.27 30.55Q65.75 25.72 63.73 21.49L69.9 20.19ZM26.1 20.19C27.18 19.96 28.33 19.7 29.54 19.43C34.9 18.23 41.28 16.79 47 16.95L52.5 18.45C57 20.45 59.8 24.95 59.3 29.95Q59.04 32.8 57.49 34.04Q56.05 35.19 53.5 34.95C50.5 34.45 48.5 31.45 44.5 31.45L20.67 40.47ZM10.65 16.05 20.31 18.64 14.35 40.85 4.69 38.27ZM85.35 16.05 91.31 38.27 81.65 40.85 75.69 18.64ZM77.85 46.49 91.27 54.24 83.84 59.31 72.85 53.33ZM69.29 58.22 81.04 64.62 73.71 69.94 64.24 65.13ZM60.66 70.04 68.88 74.22 61.69 79.91 55.52 77.08Z"/></svg><b>{{ s.t6 | escape }}</b><span>{{ s.t7 | escape }}</span></li>
          <li><svg class="ic" viewbox="0 0 96 96" aria-hidden="true"><path d="M48 13.8 86 29 48 44.2 10 29ZM26.24 60.51 48 70.04 69.76 60.51 86 67 48 82.2 10 67ZM26.24 41.51 48 51.04 69.76 41.51 86 48 48 63.2 10 48Z"/></svg><b>{{ s.t8 | escape }}</b><span>{{ s.t9 | escape }}</span></li>
          <li><svg class="ic" viewbox="0 0 96 96" aria-hidden="true"><path d="M58.67 45.33C58.67 54.6 52.21 62.37 43.56 64.38V72H52.44V80H43.56V88H34.67V80H25.78V72H34.67V64.38C26.01 62.37 19.56 54.6 19.56 45.33C19.56 34.53 28.31 25.78 39.11 25.78C42.9 25.78 46.44 26.86 49.44 28.72L61.99 16.17L57.59 11.77L76.44 8L72.67 26.86L68.27 22.46L55.72 35.01C57.59 38 58.67 41.54 58.67 45.33ZM49.78 45.33C49.78 39.44 45 34.67 39.11 34.67C33.22 34.67 28.44 39.44 28.44 45.33C28.44 51.22 33.22 56 39.11 56C45 56 49.78 51.22 49.78 45.33Z"/></svg><b>{{ s.t10 | escape }}</b><span>{{ s.t11 | escape }}</span></li>
        </ul>
        <div class="story__buy"><p class="num">{{ s.t12 | escape }}</p><a class="btn btn--k" href="{{ s.url13 | default: "https://www.higrip.nl/products/performance-gripsokken" }}">{{ s.t14 | escape }} <svg viewbox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7"/></svg></a></div>
      </div>
    </div>
  </section>
</div>
