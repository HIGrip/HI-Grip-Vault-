{{ 'vg2-page.css' | asset_url | stylesheet_tag }}
<script src="{{ 'vg2-page.js' | asset_url }}" defer></script>
{%- assign s = section.settings -%}
<div class="vg2">
<section class="sec{% if s.custom_pad %} vg2-pad{% endif %}" aria-labelledby="end-titel" style="{%- if s.bg_color != blank -%}background:{{ s.bg_color }};{%- endif -%}{%- if s.text_color != blank -%}color:{{ s.text_color }};{%- endif -%}--vg2-pt:{{ s.padding_top }}px;--vg2-pb:{{ s.padding_bottom }}px;--vg2-pt-m:{{ s.padding_top_mobile }}px;--vg2-pb-m:{{ s.padding_bottom_mobile }}px;">
    <div class="wrap">
      <h2 class="xh2 end__head rv" id="end-titel">{{ s.t1 | escape }} <em>{{ s.t2 | escape }}</em></h2>
      <div class="duo">
        <a class="dc rv" href="{{ s.url3 | default: "https://www.higrip.nl/products/performance-gripsokken" }}">
          <div class="dc__img"><img src="{%- if s.ima4 != blank -%}{{ s.ima4 | image_url: width: 1200 }}{%- else -%}{{ 'vg-sok-10.webp' | asset_url }}{%- endif -%}" width="900" height="900" alt="{{ s.t5 | escape }}" loading="lazy"></div>
          <div class="dc__txt"><b>{{ s.t6 | escape }}</b><span>{{ s.t7 | escape }}</span><span class="dc__go">{{ s.t8 | escape }} <svg viewbox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7"/></svg></span></div>
        </a>
        <a class="dc dc--20 rv d1" data-link-20 href="{{ s.url9 | default: "https://www.higrip.nl/products/performance-gripsokken-2-0-zwart" }}">
          <div class="dc__img"><img data-img-20b src="{%- if s.ima10 != blank -%}{{ s.ima10 | image_url: width: 1200 }}{%- else -%}{{ 'vg-sok-20-zwart.webp' | asset_url }}{%- endif -%}" width="900" height="900" alt="{{ s.t11 | escape }}" loading="lazy"></div>
          <div class="dc__txt"><b>{{ s.t12 | escape }}</b><span>{{ s.t13 | escape }}</span><span class="dc__go">{{ s.t14 | escape }} <svg viewbox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7"/></svg></span></div>
        </a>
      </div>
      <ul class="proofbar" aria-label="Waarom HÏ Grip">
        <li><b class="num">{{ s.t15 | escape }}</b><span>{{ s.t16 | escape }}</span></li>
        <li><a href="{{ s.url17 | default: "https://nl.trustpilot.com/review/higrip.nl" }}"><b class="num">{{ s.t18 | escape }}</b><span><span class="stars" aria-hidden="true"><svg viewbox="0 0 24 24"><path d="M12 2l3 7h7l-5.6 4.6L18.5 21 12 16.8 5.5 21l2.1-7.4L2 9h7z"/></svg><svg viewbox="0 0 24 24"><path d="M12 2l3 7h7l-5.6 4.6L18.5 21 12 16.8 5.5 21l2.1-7.4L2 9h7z"/></svg><svg viewbox="0 0 24 24"><path d="M12 2l3 7h7l-5.6 4.6L18.5 21 12 16.8 5.5 21l2.1-7.4L2 9h7z"/></svg><svg viewbox="0 0 24 24"><path d="M12 2l3 7h7l-5.6 4.6L18.5 21 12 16.8 5.5 21l2.1-7.4L2 9h7z"/></svg><svg viewbox="0 0 24 24"><path d="M12 2l3 7h7l-5.6 4.6L18.5 21 12 16.8 5.5 21l2.1-7.4L2 9h7z"/></svg></span> {{ s.t19 | escape }}</span></a></li>
        <li><b class="num">{{ s.t20 | escape }}</b><span>{{ s.t21 | escape }}</span></li>
        <li><b class="num">{{ s.t22 | escape }}</b><span>{{ s.t23 | escape }}</span></li>
      </ul>
    </div>
  </section>
</div>
