          <div class="padel-comparison__card-row">
            <span class="padel-comparison__card-label">Wrijvingscoëfficiënt</span>
            <span class="padel-comparison__card-value">~0,90</span>
          </div>
          <div class="padel-comparison__card-row">
            <span class="padel-comparison__card-label">Levensduur</span>
            <span class="padel-comparison__card-value">3&ndash;6 maanden</span>
          </div>
          <div class="padel-comparison__card-row">
            <span class="padel-comparison__card-label">Prijs per paar</span>
            <span class="padel-comparison__card-value">&euro;20+</span>
          </div>
          <div class="padel-comparison__card-row">
            <span class="padel-comparison__card-label">Garantie</span>
            <span class="padel-comparison__card-value"><span class="padel-comparison__cross">✗</span> Nee</span>
          </div>
        </div>
      </div>

      <div class="padel-comparison__card padel-comparison__card--higrip">
        <div class="padel-comparison__card-header">HÏ Grip Gripsokken</div>
        <div class="padel-comparison__card-body">
          <div class="padel-comparison__card-row">
            <span class="padel-comparison__card-label">Grip in schoen</span>
            <span class="padel-comparison__card-value"><span class="padel-comparison__check">✓</span> Anti-slip</span>
          </div>
          <div class="padel-comparison__card-row">
            <span class="padel-comparison__card-label">Wrijvingscoëfficiënt</span>
            <span class="padel-comparison__card-value"><strong>1,17</strong></span>
          </div>
          <div class="padel-comparison__card-row">
            <span class="padel-comparison__card-label">Levensduur</span>
            <span class="padel-comparison__card-value"><strong>6&ndash;12 maanden</strong></span>
          </div>
          <div class="padel-comparison__card-row">
            <span class="padel-comparison__card-label">Prijs per paar</span>
            <span class="padel-comparison__card-value"><strong>vanaf &euro;13</strong></span>
          </div>
          <div class="padel-comparison__card-row">
            <span class="padel-comparison__card-label">Garantie</span>
            <span class="padel-comparison__card-value"><span class="padel-comparison__check">✓</span> <strong>30 dagen</strong></span>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>
