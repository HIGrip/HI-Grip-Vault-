<section class="padel-comparison" id="vergelijking">
  <div class="page-width">
    <h2>Eerlijke vergelijking</h2>
    <p class="padel-comparison__lead">Drie veelgebruikte opties, één eerlijke vergelijking.</p>

    <!-- Desktop: table -->
    <div class="padel-comparison__table-wrap">
      <table class="padel-comparison__table" aria-label="Vergelijking normale sokken, premium gripsokken en HÏ Grip gripsokken voor padel">
        <thead>
          <tr>
            <th scope="col">Eigenschap</th>
            <th scope="col">Normale sokken</th>
            <th scope="col">Premium gripsokken (&euro;20+)</th>
            <th scope="col" class="padel-comparison__th-higrip">HÏ Grip Gripsokken</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td>Grip in schoen</td>
            <td><span class="padel-comparison__cross" aria-hidden="true">✗</span> Glad</td>
            <td><span class="padel-comparison__check" aria-hidden="true">✓</span> Anti-slip</td>
            <td class="padel-comparison__td-higrip"><span class="padel-comparison__check" aria-hidden="true">✓</span> Anti-slip</td>
          </tr>
          <tr>
            <td>Wrijvingscoëfficiënt</td>
            <td>0,60</td>
            <td>~0,90</td>
            <td class="padel-comparison__td-higrip"><strong>1,17</strong></td>
          </tr>
          <tr>
            <td>Stabiliteit bij sidesteps</td>
            <td>Laag</td>
            <td>Gemiddeld</td>
            <td class="padel-comparison__td-higrip"><strong>Hoog</strong></td>
          </tr>
          <tr>
            <td>Blaarvorming</td>
            <td>Verhoogd risico</td>
            <td>Minder kans</td>
            <td class="padel-comparison__td-higrip"><strong>Minder kans</strong></td>
          </tr>
          <tr>
            <td>Ademend materiaal</td>
            <td>Variabel</td>
            <td>Ja</td>
            <td class="padel-comparison__td-higrip"><strong>Ja</strong></td>
          </tr>
          <tr>
            <td>Levensduur bij intensief gebruik</td>
            <td>2&ndash;4 maanden</td>
            <td>3&ndash;6 maanden</td>
            <td class="padel-comparison__td-higrip"><strong>6&ndash;12 maanden</strong></td>
          </tr>
          <tr>
            <td>Prijs per paar</td>
            <td>~&euro;8</td>
            <td>&euro;20+</td>
            <td class="padel-comparison__td-higrip"><strong>vanaf &euro;13</strong></td>
          </tr>
          <tr>
            <td>Geld-terug-garantie</td>
            <td><span class="padel-comparison__cross" aria-hidden="true">✗</span> Nee</td>
            <td><span class="padel-comparison__cross" aria-hidden="true">✗</span> Nee</td>
            <td class="padel-comparison__td-higrip"><span class="padel-comparison__check" aria-hidden="true">✓</span> <strong>30 dagen</strong></td>
          </tr>
        </tbody>
      </table>
    </div>

    <!-- Mobile: cards -->
    <div class="padel-comparison__cards">

