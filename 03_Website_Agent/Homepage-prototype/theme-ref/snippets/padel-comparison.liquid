          <div class="padel-comparison__card-row">
            <span class="padel-comparison__card-label">Garantie</span>
            <span class="padel-comparison__card-value"><span class="padel-comparison__cross">✗</span> Nee</span>
          </div>
        </div>
      </div>

      <div class="padel-comparison__card">
