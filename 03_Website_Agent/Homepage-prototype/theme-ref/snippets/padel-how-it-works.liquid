<section class="padel-how-it-works" id="hoe-het-werkt">
  <div class="page-width">
    <h2 class="padel-how__heading">Zo houdt HÏ Grip je voet vast</h2>
    <p class="padel-how__sub">Drie technische lagen, één doel: zero slip.</p>

    <!-- Desktop: hotspot diagram (aria-hidden, visual only) -->
    <div class="padel-how__diagram" aria-hidden="true">
      <img
        src="{{ 'padel-sock-cutaway.png' | file_img_url: '1200x900' }}"
        alt=""
        width="1200"
        height="900"
        loading="lazy"
      >

      <div class="padel-how__hotspot" style="--x:16%;--y:20%;">
        <button class="padel-how__dot" tabindex="-1" aria-hidden="true">1</button>
        <div class="padel-how__pop">
          <strong>Anti-slip silicone print</strong>
          <p>Microdots aan de binnenkant grijpen je huid vast — geen bewegingsruimte voor je voet.</p>
        </div>
      </div>

      <div class="padel-how__hotspot" style="--x:66%;--y:40%;">
        <button class="padel-how__dot" tabindex="-1" aria-hidden="true">2</button>
        <div class="padel-how__pop">
          <strong>Versterkte zool &amp; hiel</strong>
          <p>Extra steun precies waar padel het meeste vraagt: bij sidesteps en snelle stops.</p>
        </div>
      </div>

      <div class="padel-how__hotspot" style="--x:30%;--y:72%;">
        <button class="padel-how__dot" tabindex="-1" aria-hidden="true">3</button>
        <div class="padel-how__pop">
          <strong>Ademend katoen-mix</strong>
          <p>Vocht wordt afgevoerd, voet blijft droog — minder wrijving, minder blaren.</p>
        </div>
      </div>
    </div>

    <!-- Mobile & accessible: stacked step list -->
    <ol class="padel-how__steps" aria-label="Hoe HÏ Grip werkt in 3 stappen">
      <li class="padel-how__step">
        <span class="padel-how__step-num" aria-hidden="true">1</span>
        <div class="padel-how__step-body">
          <strong>Anti-slip silicone print</strong>
          <p>Microdots aan de binnenkant grijpen je huid vast — geen bewegingsruimte voor je voet.</p>
        </div>
      </li>
      <li class="padel-how__step">
        <span class="padel-how__step-num" aria-hidden="true">2</span>
        <div class="padel-how__step-body">
          <strong>Versterkte zool &amp; hiel</strong>
          <p>Extra steun precies waar padel het meeste vraagt: bij sidesteps en snelle stops.</p>
        </div>
      </li>
      <li class="padel-how__step">
        <span class="padel-how__step-num" aria-hidden="true">3</span>
        <div class="padel-how__step-body">
          <strong>Ademend katoen-mix</strong>
          <p>Vocht wordt afgevoerd, voet blijft droog — minder wrijving, minder blaren.</p>
        </div>
      </li>
    </ol>
  </div>
</section>
