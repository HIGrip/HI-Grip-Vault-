{% comment %}
  HÏ Grip — Product + FAQ Schema Markup
  Voeg toe aan: snippets/product-schema.liquid
  Render in layout/theme.liquid via:
  {% render 'product-schema' %}
  (Alleen op productpagina's — de if-check hieronder zorgt daarvoor)
{% endcomment %}

{% if template == 'product' or template contains 'product' %}

{% assign review_count = product.metafields.reviews.count | default: 7 %}
{% assign review_rating = product.metafields.reviews.rating | default: 4.5 %}

<script type="application/ld+json">
{
  "@context": "https://schema.org/",
  "@type": "Product",
  "name": {{ product.title | json }},
  "description": {{ product.description | strip_html | strip_newlines | json }},
  "sku": {{ product.selected_or_first_available_variant.sku | json }},
  "mpn": {{ product.selected_or_first_available_variant.barcode | json }},
  "brand": {
    "@type": "Brand",
    "name": "HÏ Grip"
  },
  "image": [
    {% for image in product.images %}
      {{ image | image_url: width: 1200 | prepend: 'https:' | json }}{% unless forloop.last %},{% endunless %}
    {% endfor %}
  ],
  "offers": {
    "@type": "AggregateOffer",
    "priceCurrency": "EUR",
    "lowPrice": {{ product.price_min | divided_by: 100.0 | json }},
    "highPrice": {{ product.price_max | divided_by: 100.0 | json }},
    "offerCount": {{ product.variants | size }},
    "availability": {% if product.available %}"https://schema.org/InStock"{% else %}"https://schema.org/OutOfStock"{% endif %},
    "url": {{ shop.url | append: product.url | json }},
    "seller": {
      "@type": "Organization",
      "name": {{ shop.name | json }}
    }
  },
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "{{ review_rating }}",
    "reviewCount": "{{ review_count }}",
    "bestRating": "5",
    "worstRating": "1"
  }
}
</script>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Welke maat moet ik kiezen?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "We hebben 3 maten: 35-38 (kleinere voeten, dames en jeugd), 39-42 (meest gekozen) en 43-47 (grotere voeten). De gripsokken sluiten strak aan voor maximale grip. Twijfel je tussen twee maten? Kies de grotere."
      }
    },
    {
      "@type": "Question",
      "name": "Hoe werkt het grippatroon van HÏ Grip?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Het innovatieve grippatroon van HÏ Grip biedt een wrijvingscoëfficiënt van 1.17 versus 0.60 bij een standaard sok — dat is 95% meer grip, wetenschappelijk getest. De silicon nopjes zijn strategisch geplaatst voor maximale traction bij elke beweging."
      }
    },
    {
      "@type": "Question",
      "name": "Welk pack is het voordeligst?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Het 3-pack is het meest gekozen en biedt de beste prijs-kwaliteitverhouding. Met het 5-pack bespaar je nog meer per paar en heb je altijd een reserve klaar liggen."
      }
    },
    {
      "@type": "Question",
      "name": "Zijn de HÏ Grip sokken geschikt voor meerdere sporten?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Ja, de gripsokken zijn geschikt voor voetbal, padel, fitness, yoga, pilates en andere sporten waarbij grip en stabiliteit belangrijk zijn. Ze worden gedragen door meer dan 3.500 sporters."
      }
    },
    {
      "@type": "Question",
      "name": "Hoe lang duurt de levering?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Bestellingen geplaatst op werkdagen voor 17:00 worden dezelfde dag verzonden. Bezorgtijd is 1-2 werkdagen binnen Nederland."
      }
    },
    {
      "@type": "Question",
      "name": "Wat is het retourbeleid van HÏ Grip?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Je kunt ongedragen producten binnen 30 dagen retourneren. Neem contact op via het contactformulier op de website voor een retourlabel."
      }
    }
  ]
}
</script>

{% endif %}
