        "text_7meHcq": {
          "type": "text",
          "name": "t:names.heading",
          "settings": {
            "text": "<h2><strong>Waarom deze trend snel groeit bij amateurclubs</strong></h2>",
            "width": "fit-content",
            "max_width": "normal",
            "alignment": "left",
            "type_preset": "h3",
            "font": "var(--font-body--family)",
            "font_size": "1rem",
            "line_height": "normal",
