{{ 'hg-zakelijk.css' | asset_url | stylesheet_tag }}
{{ 'hg-zakelijk-more.css' | asset_url | stylesheet_tag }}
{{ 'hg-zakelijk-v2.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign s = section.settings
  assign tag = s.heading_tag | default: 'h2'
-%}
{% render 'hg-style', s: s, section_id: section.id, cls: 'zk' %}
{%- comment -%} Zelfde opbouw als de FAQ op de sportpagina's (sport-guide), zonder accentkleur en compacter {%- endcomment -%}
<section class="zk zk--light zk-gf" id="{{ s.anchor | default: 'faq' }}" style="{% render 'zk-vars', s: s %}{% if s.rule_top %}border-top:1px solid var(--z-line);{% endif %}" {{ section.shopify_attributes }}>
  <div class="zk__wrap zk-gf__wrap">
    {%- if s.eyebrow != blank or s.heading != blank -%}
      <div class="zk-gf__head">
        {%- if s.eyebrow != blank -%}<p class="zk-gf__eyebrow">{{ s.eyebrow }}</p>{%- endif -%}
        {%- if s.heading != blank -%}<{{ tag }} class="zk-gf__title">{{ s.heading }}</{{ tag }}>{%- endif -%}
      </div>
    {%- endif -%}
    <div class="zk-gf__items">
      {%- for block in section.blocks -%}
        <details class="zk-gf__item" {% if s.first_open and forloop.first %}open{% endif %} {{ block.shopify_attributes }}>
          <summary><h3 class="zk-gf__q">{{ block.settings.question }}</h3></summary>
          <div class="zk-gf__a">{{ block.settings.answer }}</div>
        </details>
      {%- endfor -%}
    </div>
  </div>
</section>
{%- if section.blocks.size > 0 and s.schema_markup -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {%- for block in section.blocks -%}
    {
      "@type": "Question",
      "name": {{ block.settings.question | json }},
      "acceptedAnswer": { "@type": "Answer", "text": {{ block.settings.answer | strip_html | json }} }
    }{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
  ]
}
</script>
{%- endif -%}

{% schema %}
{
  "name": "Zakelijk: FAQ",
  "settings": [
    { "type": "text", "id": "anchor", "label": "Anker (voor de navigatiebalk)", "default": "faq" },
    { "type": "text", "id": "eyebrow", "label": "Bovenregel (leeg = verborgen)", "default": "FAQ" },
    { "type": "text", "id": "heading", "label": "Kop (leeg = verborgen)", "default": "Veelgestelde vragen" },
    { "type": "select", "id": "heading_tag", "label": "Kopniveau (SEO)", "options": [ { "value": "h2", "label": "H2" }, { "value": "h3", "label": "H3" }, { "value": "p", "label": "Gewone tekst (p)" } ], "default": "h2" },
    { "type": "checkbox", "id": "first_open", "label": "Eerste vraag open", "default": false },
    { "type": "checkbox", "id": "schema_markup", "label": "FAQ-gegevens voor Google (structured data)", "default": true },
    { "type": "select", "id": "text_align", "label": "Tekst uitlijnen (kop)", "options": [ { "value": "default", "label": "Standaard" }, { "value": "left", "label": "Links" }, { "value": "center", "label": "Gecentreerd" }, { "value": "right", "label": "Rechts" } ], "default": "default" },
    { "type": "header", "content": "Kleuren en ruimte" },
    { "type": "color", "id": "bg_color", "label": "Achtergrondkleur", "default": "#ffffff" },
    { "type": "color", "id": "text_color", "label": "Tekstkleur", "default": "#000000" },
    { "type": "color", "id": "heading_color", "label": "Kleur kop (leeg = tekstkleur)" },
    { "type": "color", "id": "accent_color", "label": "Kleur bovenregel", "default": "#5c5d5f" },
    { "type": "checkbox", "id": "rule_top", "label": "Lijn boven de sectie", "default": true },
    { "type": "range", "id": "padding_top", "label": "Ruimte boven (desktop)", "min": 0, "max": 240, "step": 4, "unit": "px", "default": 96 },
    { "type": "range", "id": "padding_bottom", "label": "Ruimte onder (desktop)", "min": 0, "max": 240, "step": 4, "unit": "px", "default": 96 },
    { "type": "range", "id": "padding_top_mobile", "label": "Ruimte boven (mobiel)", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 56 },
    { "type": "range", "id": "padding_bottom_mobile", "label": "Ruimte onder (mobiel)", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 56 }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "Vraag",
      "settings": [
        { "type": "text", "id": "question", "label": "Vraag", "default": "Wat kost het?" },
        { "type": "richtext", "id": "answer", "label": "Antwoord", "default": "<p>Antwoord.</p>" }
      ]
    }
  ],
  "presets": [ { "name": "Zakelijk: FAQ" } ]
}
{% endschema %}
