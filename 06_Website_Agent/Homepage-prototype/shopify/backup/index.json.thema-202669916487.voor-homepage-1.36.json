    "section_qhKhKi": {
      "type": "section",
      "blocks": {
        "text_BkeMQz": {
          "type": "text",
          "name": "t:names.heading",
          "settings": {
            "text": "<h3><strong>Veelgestelde vragen</strong></h3>",
            "width": "fit-content",
