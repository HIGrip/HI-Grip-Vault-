{% comment %}
  Section contract.
  HÏ homepage 02 · Kies je paar: productkaarten (blokken) met sfeerbeeld bij hover/tik, optionele kleurstaaltjes,
  en daaronder de vergelijkknop ("duel"). Motion: kaarten schuiven scroll-gekoppeld in, staaltjes vegen.
  @example
  <!-- Homepage > HÏ 02 · Kies je paar -->
{% endcomment %}
{%- liquid
  assign s = section.settings
  assign tag = s.heading_tag | default: 'h2'
-%}
{%- render 'hp-base' -%}
<style>
#shopify-section-{{ section.id }} {--hp-02-h2_c: {{ s.h2_c }}; --hp-02-media_bg: {{ s.media_bg }}; --hp-02-tag_bg: {{ s.tag_bg }}; --hp-02-tag_fg: {{ s.tag_fg }}; --hp-02-tag_volt: {{ s.tag_volt }}; --hp-02-title_c: {{ s.title_c }}; --hp-02-price_c: {{ s.price_c }}; --hp-02-bul_c: {{ s.bul_c }}; --hp-02-dot_c: {{ s.dot_c }}; --hp-02-sizes_c: {{ s.sizes_c }}; --hp-02-cname_c: {{ s.cname_c }}; --hp-02-duel_bg: {{ s.duel_bg }}; --hp-02-duel_fg: {{ s.duel_fg }}; --hp-02-duel_k_c: {{ s.duel_k_c }}; --hp-02-duel_disc: {{ s.duel_disc }}; --hp-02-duel_cbg: {{ s.duel_cbg }}; --hp-02-duel_cfg: {{ s.duel_cfg }}; --hp-02-duel_vs_bg: {{ s.duel_vs_bg }}; --hp-02-duel_vs_fg: {{ s.duel_vs_fg }}; --hp-02-bg: {{ s.bg }}; --hp-02-fg: {{ s.fg }}; --hp-btn-bg: {{ s.btn_bg }}; --hp-btn-fg: {{ s.btn_fg }}; --hp-btn-cbg: {{ s.btn_cbg }}; --hp-btn-cfg: {{ s.btn_cfg }}; --hp-btn-bd: {{ s.btn_bd }}; --hp-btn-bw: {{ s.btn_bw }}px; --hp-btn-r: {{ s.btn_r }}px; --hp-btn-hbg: {{ s.btn_hbg }}; --hp-btn-hfg: {{ s.btn_hfg }}; --hp-btn-hbd: {{ s.btn_hbd }}; --hp-btn-hcbg: {{ s.btn_hcbg }}; --hp-btn-hcfg: {{ s.btn_hcfg }};}
@media (max-width: 768px) { #shopify-section-{{ section.id }} {--hp-02-h2-k: {{ s.h2_m | times: 1.0 | divided_by: 32 }}; --hp-02-r-k: {{ s.img_r_m | times: 1.0 | divided_by: 16 }}; --hp-02-tag-k: {{ s.tag_m | times: 1.0 | divided_by: 11 }}; --hp-02-title-k: {{ s.title_m | times: 1.0 | divided_by: 17 }}; --hp-02-price-k: {{ s.price_m | times: 1.0 | divided_by: 15 }}; --hp-02-sub-k: {{ s.sub_m | times: 1.0 | divided_by: 11 }}; --hp-02-sub_c: {{ s.sub_c_m }}; --hp-02-bul-k: {{ s.bul_m | times: 1.0 | divided_by: 12 }}; --hp-02-sizes-k: {{ s.sizes_m | times: 1.0 | divided_by: 11 }}; --hp-02-duelk-k: {{ s.duel_k_m | times: 1.0 | divided_by: 11 }}; --hp-02-duelv-k: {{ s.duel_v_m | times: 1.0 | divided_by: 16 }}; --hp-pt-k: {{ s.pt_m | times: 1.0 | divided_by: 64 }}; --hp-pt-add: 0px; --hp-pb-k: {{ s.pb_m | times: 1.0 | divided_by: 32 }}; --hp-pb-add: 0px; --hp-btn-k: {{ s.btn_m | times: 1.0 | divided_by: 12 }};} }
@media (min-width: 769px) { #shopify-section-{{ section.id }} {--hp-02-h2-k: {{ s.h2_d | times: 1.0 | divided_by: 64 }}; --hp-02-r-k: {{ s.img_r_d | times: 1.0 | divided_by: 26 }}; --hp-02-tag-k: {{ s.tag_d | times: 1.0 | divided_by: 11 }}; --hp-02-title-k: {{ s.title_d | times: 1.0 | divided_by: 29 }}; --hp-02-price-k: {{ s.price_d | times: 1.0 | divided_by: 23 }}; --hp-02-sub-k: {{ s.sub_d | times: 1.0 | divided_by: 12 }}; --hp-02-sub_c: {{ s.sub_c_d }}; --hp-02-bul-k: {{ s.bul_d | times: 1.0 | divided_by: 16 }}; --hp-02-sizes-k: {{ s.sizes_d | times: 1.0 | divided_by: 13 }}; --hp-02-duelk-k: {{ s.duel_k_d | times: 1.0 | divided_by: 11 }}; --hp-02-duelv-k: {{ s.duel_v_d | times: 1.0 | divided_by: 22 }}; --hp-pt-k: {{ s.pt_d | times: 1.0 | divided_by: 32 }}; --hp-pt-add: 0px; --hp-pb-k: {{ s.pb_d | times: 1.0 | divided_by: 32 }}; --hp-pb-add: 0px; --hp-btn-k: {{ s.btn_d | times: 1.0 | divided_by: 14 }};} }
{%- unless s.anim_cards -%}#shopify-section-{{ section.id }} .hp-02-card { transform: none !important; }{%- endunless -%}
{%- unless s.anim_mood -%}#shopify-section-{{ section.id }} .hp-02-media__mood { display: none; } #shopify-section-{{ section.id }} .hp-02-media .hp-02-media__prod { transform: none !important; }{%- endunless -%}
{%- unless s.anim_duel -%}#shopify-section-{{ section.id }} .hp-02-duel__disc { animation: none !important; }{%- endunless -%}
</style>
<section class="hp-section hp-02" data-hp="02" aria-labelledby="hp-02-h2-{{ section.id }}">
  <div class="hp-container hp-02-inner">
    {%- if s.heading != blank -%}
      <header class="hp-head hp-02-headblock"><{{ tag }} class="hp-h2 hp-02-h2" id="hp-02-h2-{{ section.id }}">{{ s.heading }}</{{ tag }}></header>
    {%- endif -%}

    <ul class="hp-02-list" data-hp-02-list>
      {%- for block in section.blocks -%}
        {%- liquid
          assign b = block.settings
          assign two = false
          if b.image_b != blank
            assign two = true
          endif
          assign mod = forloop.index | modulo: 2
          if mod == 1
            assign cls = 'hp-02-card--10'
          else
            assign cls = 'hp-02-card--20'
          endif
          assign price = b.price
          if price == blank and b.product != blank
            assign price = b.product.price | money
          endif
          assign link_a = b.link_a | default: b.cta_link
        -%}
        <li class="hp-02-card {{ cls }}" data-hp-02-card{% if two %} data-color="zwart"{% endif %} style="--hp-02-sw-a: {{ b.swatch_a }}; --hp-02-sw-b: {{ b.swatch_b }};" {{ block.shopify_attributes }}>
          <button class="hp-02-media" type="button" aria-pressed="false" aria-label="{{ b.media_label | escape }}">
            {%- if two -%}
              {%- render 'hp-img', image: b.image, class: 'hp-02-media__prod hp-02-media__prod--zwart', sizes: '(min-width: 769px) 50vw, 50vw', widths: '450,900' -%}
              {%- render 'hp-img', image: b.image_b, class: 'hp-02-media__prod hp-02-media__prod--wit', sizes: '(min-width: 769px) 50vw, 50vw', widths: '450,900', attrs: 'aria-hidden="true"' -%}
            {%- else -%}
              {%- render 'hp-img', image: b.image, class: 'hp-02-media__prod', sizes: '(min-width: 769px) 50vw, 50vw', widths: '450,900' -%}
            {%- endif -%}
            {%- render 'hp-img', image: b.mood, class: 'hp-02-media__mood', sizes: '(min-width: 769px) 50vw, 50vw', widths: '400,800' -%}
            {%- if b.tag != blank -%}<span class="hp-02-tag{% if b.tag_style == 'volt' %} hp-02-tag--volt{% endif %}">{{ b.tag }}</span>{%- endif -%}
          </button>
          <div class="hp-02-head">
            <h3 class="hp-02-title">{{ b.title }}</h3>
            {%- if price != blank -%}<span class="hp-02-price">{{ price }}</span>{%- endif -%}
          </div>
          {%- if b.sub != blank -%}<p class="hp-02-sub">{{ b.sub }}</p>{%- endif -%}
          {%- assign lines = b.bullets | newline_to_br | split: '<br />' -%}
          {%- if b.bullets != blank -%}
            <ul class="hp-02-bullets">
              {%- for l in lines -%}{%- assign t = l | strip -%}{%- if t != blank -%}<li>{{ t }}</li>{%- endif -%}{%- endfor -%}
            </ul>
          {%- endif -%}
          <div class="hp-02-foot">
            {%- if two -%}
              <div class="hp-02-colors" role="group" aria-label="{{ s.colors_label | escape }}">
                <button class="hp-02-swatch hp-02-swatch--zwart" type="button" aria-pressed="true" data-color="zwart" data-href="{{ link_a }}"><span class="hp-sr">{{ b.name_a }}</span></button>
                <button class="hp-02-swatch hp-02-swatch--wit" type="button" aria-pressed="false" data-color="wit" data-href="{{ b.link_b | default: link_a }}"><span class="hp-sr">{{ b.name_b }}</span></button>
                <span class="hp-02-colorname" aria-hidden="true"><span class="hp-02-colorname__zwart">{{ b.name_a }}</span><span class="hp-02-colorname__wit">{{ b.name_b }}</span></span>
              </div>
            {%- elsif b.sizes != blank -%}
              <p class="hp-02-sizes">{{ b.sizes }}</p>
            {%- endif -%}
            {%- if b.cta_label != blank -%}
              <a class="hp-pill hp-pill--light hp-02-cta" href="{% if two %}{{ link_a }}{% else %}{{ b.cta_link }}{% endif %}"{% if two %} data-hp-02-cta{% endif %}{% if b.cta_aria != blank %} aria-label="{{ b.cta_aria | escape }}"{% endif %}>{{ b.cta_label }}<span class="hp-pill__chev" aria-hidden="true"><svg viewBox="0 0 14 14"><path d="M5 2.5 9.5 7 5 11.5" fill="none" stroke="currentColor" stroke-width="2"/></svg></span></a>
            {%- endif -%}
          </div>
        </li>
      {%- endfor -%}
    </ul>

    {%- if s.show_compare -%}
      <div class="hp-02-compare">
        <a class="hp-02-duel" href="{{ s.compare_link }}" aria-label="{{ s.compare_aria | escape }}"><span class="hp-02-duel__socks" aria-hidden="true"><span class="hp-02-duel__disc hp-02-duel__disc--a">{%- render 'hp-img', image: s.disc_a, sizes: '72px', widths: '150,300', decorative: true -%}</span><span class="hp-02-duel__disc hp-02-duel__disc--b">{%- render 'hp-img', image: s.disc_b, sizes: '72px', widths: '150,300', decorative: true -%}</span><span class="hp-02-duel__vs">{{ s.vs }}</span></span><span class="hp-02-duel__txt"><span class="hp-02-duel__k">{{ s.compare_k }}</span><span class="hp-02-duel__v">{{ s.compare_v }}</span></span><span class="hp-pill__chev" aria-hidden="true"><svg viewBox="0 0 14 14"><path d="M5 2.5 9.5 7 5 11.5" fill="none" stroke="currentColor" stroke-width="2"/></svg></span></a>
      </div>
    {%- endif -%}
  </div>
</section>
