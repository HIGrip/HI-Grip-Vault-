{% comment %}
  Section contract.
  HÏ homepage 02 · Kies je paar: productkaarten (blokken) met sfeerbeeld bij hover/tik, optionele kleurstaaltjes,
  en daaronder de vergelijkknop ("duel"). Motion: kaarten schuiven scroll-gekoppeld in, staaltjes vegen.
  @example
  <!-- Homepage > HÏ 02 · Kies je paar -->
{% endcomment %}
{%- liquid
  assign s = section.settings
  assign tag = s.heading_tag | default: 'h2'
-%}
{%- render 'hp-base' -%}
{%- assign hp_a_feat_line = s.feat_line_a | divided_by: 100.0 -%}
<style>
