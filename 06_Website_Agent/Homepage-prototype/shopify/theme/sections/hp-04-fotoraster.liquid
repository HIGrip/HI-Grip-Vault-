{% comment %}
  Section contract.
  HÏ homepage 04 · Fotoraster: kop met intro en vier sportfoto's (blokken) die doorlinken. Laptop: groot links,
  twee kleine rechtsboven, breed rechtsonder. Hover/tik: foto zoomt, pijl schuift.
  @example
  <!-- Homepage > HÏ 04 · Fotoraster -->
{% endcomment %}
{%- liquid
  assign s = section.settings
  assign tag = s.heading_tag | default: 'h2'
  assign cells = 'a,b,c,d' | split: ','
-%}
{%- render 'hp-base' -%}
{%- assign hp_a_scrim = s.scrim_a | divided_by: 100.0 -%}
<style>
#shopify-section-{{ section.id }} {--hp-04-h2_c: {{ s.h2_c }}; --hp-04-lead_c: {{ s.lead_c }}; --hp-04-gh: {{ s.grid_h }}svh; --hp-04-gw: {{ s.grid_hw }}vw; --hp-04-gap: {{ s.gap }}px; --hp-04-label_c: {{ s.label_c }}; --hp-04-chev_bg: {{ s.chev_bg }}; --hp-04-chev_fg: {{ s.chev_fg }}; --hp-04-scrim: {{ s.scrim | color_modify: 'alpha', hp_a_scrim }}; --hp-04-scrim-h: {{ s.scrim_h }}%; --hp-04-bg: {{ s.bg }}; --hp-04-fg: {{ s.fg }};}
@media (max-width: 768px) { #shopify-section-{{ section.id }} {--hp-h2-k: {{ s.h2_m | times: 1.0 | divided_by: 32 }}; --hp-lead-k: {{ s.lead_m | times: 1.0 | divided_by: 17 }}; --hp-04-r-k: {{ s.img_r_m | times: 1.0 | divided_by: 16 }}; --hp-04-sport-a-k: {{ s.sport_m | times: 1.0 | divided_by: 28 }}; --hp-04-sport-k: {{ s.sport_s_m | times: 1.0 | divided_by: 26 }}; --hp-04-go-k: {{ s.go_m | times: 1.0 | divided_by: 13 }}; --hp-pt-k: {{ s.pt_m | times: 1.0 | divided_by: 44 }}; --hp-pt-add: 0px; --hp-pb-k: {{ s.pb_m | times: 1.0 | divided_by: 44 }}; --hp-pb-add: 0px;} }
@media (min-width: 769px) { #shopify-section-{{ section.id }} {--hp-h2-k: {{ s.h2_d | times: 1.0 | divided_by: 64 }}; --hp-lead-k: {{ s.lead_d | times: 1.0 | divided_by: 19 }}; --hp-04-r-k: {{ s.img_r_d | times: 1.0 | divided_by: 26 }}; --hp-04-sport-a-k: {{ s.sport_d | times: 1.0 | divided_by: 100 }}; --hp-04-sport-k: {{ s.sport_s_d | times: 1.0 | divided_by: 58 }}; --hp-04-go-k: {{ s.go_d | times: 1.0 | divided_by: 13 }}; --hp-pt-k: {{ s.pt_d | times: 1.0 | divided_by: 72 }}; --hp-pt-add: 0px; --hp-pb-k: {{ s.pb_d | times: 1.0 | divided_by: 72 }}; --hp-pb-add: 0px;} }
{%- if s.head_layout == 'stack' -%}@media (min-width: 769px) { #shopify-section-{{ section.id }} .hp-04-head { grid-template-columns: minmax(0, 1fr); } #shopify-section-{{ section.id }} .hp-04-head .hp-lead { justify-self: start; } }{%- endif -%}{%- if s.head_layout == 'center' -%}#shopify-section-{{ section.id }} .hp-04-head { justify-items: center; text-align: center; } #shopify-section-{{ section.id }} .hp-04-head > * { margin-inline: auto; } @media (min-width: 769px) { #shopify-section-{{ section.id }} .hp-04-head { grid-template-columns: minmax(0, 1fr); } #shopify-section-{{ section.id }} .hp-04-head .hp-lead { justify-self: center; } }{%- endif -%}
{%- unless s.zoom -%}#shopify-section-{{ section.id }} .hp-04-card .hp-04-img { scale: 1 !important; }{%- endunless -%}
</style>
<section class="hp-section hp-04" data-hp="04" aria-labelledby="hp-04-h2-{{ section.id }}">
  <div class="hp-container hp-04-inner">
    {%- if s.heading != blank or s.lead != blank -%}
      <header class="hp-head hp-04-head">
        {%- if s.heading != blank -%}<{{ tag }} class="hp-h2 hp-04-h2" id="hp-04-h2-{{ section.id }}">{{ s.heading }}</{{ tag }}>{%- endif -%}
        {%- if s.lead != blank -%}<p class="hp-lead hp-04-lead">{{ s.lead }}</p>{%- endif -%}
      </header>
    {%- endif -%}

    <ul class="hp-04-grid">
      {%- for block in section.blocks limit: 4 -%}
        {%- liquid
          assign b = block.settings
          assign i = forloop.index0
          assign cell = cells[i]
          if i == 0 or i == 3
            assign sz = '(min-width: 769px) 50vw, 100vw'
          else
            assign sz = '(min-width: 769px) 25vw, 50vw'
          endif
          capture pos
            echo '--hp-04-pos: ' | append: b.pos_x | append: '% ' | append: b.pos_y | append: '%'
          endcapture
        -%}
        <li class="hp-04-cell hp-04-cell--{{ cell }}" {{ block.shopify_attributes }}>
          <a class="hp-04-card" href="{{ b.link }}">
            {%- render 'hp-img', image: b.image, class: 'hp-04-img', sizes: sz, widths: '450,900,1350,1800', alt: b.alt, style: pos -%}
            <span class="hp-04-label"><span class="hp-04-sport">{{ b.sport }}</span><span class="hp-04-go">{{ b.go }}<span class="hp-04-chev" aria-hidden="true"><svg viewBox="0 0 14 14"><path d="M5 2.5 9.5 7 5 11.5" fill="none" stroke="currentColor" stroke-width="2"/></svg></span></span></span>
          </a>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>
