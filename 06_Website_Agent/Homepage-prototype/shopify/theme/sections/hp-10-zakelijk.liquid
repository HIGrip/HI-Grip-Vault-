{% comment %}
  Section contract.
  HÏ homepage 10 · Zakelijk: kop met intro, een sample-ticket als hoofdknop en drie kaarten (blokken) met een hard
  feit op het beeld. Mobiel: fotoraster (personalisatie breed bovenaan). De cijfers tellen op bij binnenkomst.
  @example
  <!-- Homepage > HÏ 10 · Zakelijk -->
{% endcomment %}
{%- liquid
  assign s = section.settings
  assign tag = s.heading_tag | default: 'h2'
-%}
{%- render 'hp-base' -%}
<style>
#shopify-section-{{ section.id }} {--hp-10-h2_c: {{ s.h2_c }}; --hp-10-lead_c: {{ s.lead_c }}; --hp-10-ticket_bg: {{ s.ticket_bg }}; --hp-10-ticket_fg: {{ s.ticket_fg }}; --hp-10-ticket_sub_c: {{ s.ticket_sub_c }}; --hp-btn-bg: {{ s.btn_bg }}; --hp-btn-fg: {{ s.btn_fg }}; --hp-btn-cbg: {{ s.btn_cbg }}; --hp-btn-cfg: {{ s.btn_cfg }}; --hp-btn-bd: {{ s.btn_bd }}; --hp-btn-bw: {{ s.btn_bw }}px; --hp-btn-r: {{ s.btn_r }}px; --hp-btn-hbg: {{ s.btn_hbg }}; --hp-btn-hfg: {{ s.btn_hfg }}; --hp-btn-hbd: {{ s.btn_hbd }}; --hp-btn-hcbg: {{ s.btn_hcbg }}; --hp-btn-hcfg: {{ s.btn_hcfg }}; --hp-10-title_c: {{ s.title_c }}; --hp-10-stat_bg: {{ s.stat_bg }}; --hp-10-stat_fg: {{ s.stat_fg }}; --hp-10-stat_k_c: {{ s.stat_k_c }}; --hp-10-media_light: {{ s.media_light }}; --hp-10-bg: {{ s.bg }}; --hp-10-fg: {{ s.fg }};}
@media (max-width: 768px) { #shopify-section-{{ section.id }} {--hp-btn-k: {{ s.btn_m | times: 1.0 | divided_by: 14 }}; --hp-10-text_c: {{ s.text_c_m }}; --hp-pt-k: {{ s.pt_m | times: 1.0 | divided_by: 44 }}; --hp-pt-add: 0px; --hp-pb-k: {{ s.pb_m | times: 1.0 | divided_by: 44 }}; --hp-pb-add: 0px;} }
@media (min-width: 769px) { #shopify-section-{{ section.id }} {--hp-btn-k: {{ s.btn_d | times: 1.0 | divided_by: 14 }}; --hp-10-text_c: {{ s.text_c_d }}; --hp-pt-k: {{ s.pt_d | times: 1.0 | divided_by: 72 }}; --hp-pt-add: 0px; --hp-pb-k: {{ s.pb_d | times: 1.0 | divided_by: 72 }}; --hp-pb-add: 0px;} }
@media (max-width: 899px) { #shopify-section-{{ section.id }} {--hp-10-h2-k: {{ s.h2_m | times: 1.0 | divided_by: 36 }}; --hp-10-lead-k: {{ s.lead_m | times: 1.0 | divided_by: 17 }}; --hp-10-tb-k: {{ s.ticket_big_m | times: 1.0 | divided_by: 36 }}; --hp-10-ts-k: {{ s.ticket_sub_m | times: 1.0 | divided_by: 14 }}; --hp-10-title-k: {{ s.title_m | times: 1.0 | divided_by: 18 }}; --hp-10-text-k: {{ s.text_m | times: 1.0 | divided_by: 12 }}; --hp-10-cue-k: {{ s.cue_m | times: 1.0 | divided_by: 10 }}; --hp-10-sv-k: {{ s.stat_v_m | times: 1.0 | divided_by: 16 }}; --hp-10-r-k: {{ s.img_r_m | times: 1.0 | divided_by: 1 }};} }
@media (min-width: 900px) { #shopify-section-{{ section.id }} {--hp-10-h2-k: {{ s.h2_d | times: 1.0 | divided_by: 78 }}; --hp-10-lead-k: {{ s.lead_d | times: 1.0 | divided_by: 19 }}; --hp-10-tb-k: {{ s.ticket_big_d | times: 1.0 | divided_by: 64 }}; --hp-10-ts-k: {{ s.ticket_sub_d | times: 1.0 | divided_by: 14 }}; --hp-10-title-k: {{ s.title_d | times: 1.0 | divided_by: 29 }}; --hp-10-text-k: {{ s.text_d | times: 1.0 | divided_by: 15 }}; --hp-10-cue-k: {{ s.cue_d | times: 1.0 | divided_by: 13 }}; --hp-10-sv-k: {{ s.stat_v_d | times: 1.0 | divided_by: 52 }}; --hp-10-r-k: {{ s.img_r_d | times: 1.0 | divided_by: 26 }};} }
</style>
<section class="hp-section hp-10" data-hp="10" aria-labelledby="hp-10-h2-{{ section.id }}"{% unless s.count %} data-counting="off"{% endunless %}>
  <div class="hp-container hp-10-inner">
    <header class="hp-10-head">
      {%- if s.heading != blank -%}<{{ tag }} class="hp-10-h2" id="hp-10-h2-{{ section.id }}">{{ s.heading }}</{{ tag }}>{%- endif -%}
      {%- if s.lead != blank -%}<p class="hp-10-lead">{{ s.lead }}</p>{%- endif -%}
    </header>

    {%- if s.show_ticket -%}
      <a class="hp-10-ticket" href="{{ s.ticket_link }}">
        <span class="hp-10-ticket__top">
          <span class="hp-10-ticket__big">{{ s.ticket_big }}</span>
          <span class="hp-10-ticket__sub">{{ s.ticket_sub }}</span>
        </span>
        <span class="hp-pill hp-10-ticket__cta">{{ s.ticket_cta }}<span class="hp-pill__chev" aria-hidden="true"><svg viewBox="0 0 14 14"><path d="M5 2.5 9.5 7 5 11.5" fill="none" stroke="currentColor" stroke-width="2"/></svg></span></span>
      </a>
    {%- endif -%}

    <ul class="hp-10-cards">
      {%- for block in section.blocks -%}
        {%- liquid
          assign b = block.settings
          assign i = forloop.index0
          assign num = b.stat_v | plus: 0
        -%}
        <li class="hp-10-item" {{ block.shopify_attributes }}>
          <a class="hp-10-card" href="{{ b.link }}" aria-labelledby="hp-10-t-{{ i }}-{{ section.id }}" aria-describedby="hp-10-d-{{ i }}-{{ section.id }}">
            <span class="hp-10-media{% if b.img_style != 'cover' %} hp-10-media--light{% endif %}">
              {%- if b.img_style == 'contain' -%}{%- assign ic = 'hp-10-img hp-10-img--contain' -%}{%- elsif b.img_style == 'sheet' -%}{%- assign ic = 'hp-10-img hp-10-img--sheet' -%}{%- else -%}{%- assign ic = 'hp-10-img' -%}{%- endif -%}
              {%- render 'hp-img', image: b.image, class: ic, sizes: '(min-width: 900px) 30vw, 92vw', widths: '450,800,1000', alt: b.alt -%}
              {%- if b.stat_v != blank -%}<span class="hp-10-stat"><span class="hp-10-stat__k">{{ b.stat_k }}</span><span class="hp-10-stat__v"{% if b.stat_count and num > 0 %} data-count="{{ num }}"{% endif %}>{{ b.stat_v }}</span></span>{%- endif -%}
            </span>
            <span class="hp-10-body">
              <h3 class="hp-10-title" id="hp-10-t-{{ i }}-{{ section.id }}">{{ b.title }}</h3>
              <span class="hp-10-text" id="hp-10-d-{{ i }}-{{ section.id }}">{{ b.text }}</span>
              <span class="hp-10-cue"><span>{{ b.cue }}</span><span class="hp-10-chev" aria-hidden="true"><svg viewBox="0 0 14 14"><path d="M5 2.5 9.5 7 5 11.5" fill="none" stroke="currentColor" stroke-width="2"/></svg></span></span>
            </span>
          </a>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>
