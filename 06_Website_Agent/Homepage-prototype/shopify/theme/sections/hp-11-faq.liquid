{% comment %}
  Section contract.
  HÏ homepage 11 · Veelgestelde vragen: kop en een genummerde lijst uitklappers (blokken) met optionele links onder
  het antwoord. Zet ook de FAQPage-structured data (JSON-LD) op basis van dezelfde blokken.
  @example
  <!-- Homepage > HÏ 11 · Veelgestelde vragen -->
{% endcomment %}
{%- liquid
  assign s = section.settings
  assign tag = s.heading_tag | default: 'h2'
-%}
{%- render 'hp-base' -%}
{%- assign hp_a_line_c = s.line_c_a | divided_by: 100.0 -%}
<style>
#shopify-section-{{ section.id }} {--hp-11-h2_c: {{ s.h2_c }}; --hp-11-q_c: {{ s.q_c }}; --hp-11-no_c: {{ s.no_c }}; --hp-11-a_c: {{ s.a_c }}; --hp-11-open_bg: {{ s.open_bg }}; --hp-11-btn_c: {{ s.btn_c }}; --hp-11-line_top: {{ s.line_top }}; --hp-11-line_c: {{ s.line_c | color_modify: 'alpha', hp_a_line_c }}; --hp-11-bg: {{ s.bg }}; --hp-11-fg: {{ s.fg }};}
@media (max-width: 768px) { #shopify-section-{{ section.id }} {--hp-11-h2-k: {{ s.h2_m | times: 1.0 | divided_by: 32 }}; --hp-11-q-k: {{ s.q_m | times: 1.0 | divided_by: 15 }}; --hp-11-no-k: {{ s.no_m | times: 1.0 | divided_by: 15 }}; --hp-11-a-k: {{ s.a_m | times: 1.0 | divided_by: 15 }}; --hp-pt-k: {{ s.pt_m | times: 1.0 | divided_by: 44 }}; --hp-pt-add: 0px; --hp-pb-k: {{ s.pb_m | times: 1.0 | divided_by: 44 }}; --hp-pb-add: 0px;} }
@media (min-width: 769px) { #shopify-section-{{ section.id }} {--hp-11-h2-k: {{ s.h2_d | times: 1.0 | divided_by: 64 }}; --hp-11-q-k: {{ s.q_d | times: 1.0 | divided_by: 17 }}; --hp-11-no-k: {{ s.no_d | times: 1.0 | divided_by: 17 }}; --hp-11-a-k: {{ s.a_d | times: 1.0 | divided_by: 15 }}; --hp-pt-k: {{ s.pt_d | times: 1.0 | divided_by: 72 }}; --hp-pt-add: 0px; --hp-pb-k: {{ s.pb_d | times: 1.0 | divided_by: 72 }}; --hp-pb-add: 0px;} }
</style>
<section class="hp-section hp-11" data-hp="11" aria-labelledby="hp-11-h2-{{ section.id }}">
  <div class="hp-container hp-11-wrap">
    {%- if s.heading != blank -%}<{{ tag }} class="hp-11-h2" id="hp-11-h2-{{ section.id }}">{{ s.heading }}</{{ tag }}>{%- endif -%}
    <div class="hp-11-list">
      {%- for block in section.blocks -%}
        {%- assign b = block.settings -%}
        <details class="hp-11-item"{% if b.open %} open{% endif %} {{ block.shopify_attributes }}>
          <summary class="hp-11-sum"><h3 class="hp-11-q">{{ b.q }}</h3></summary>
          <div class="hp-11-a">{{ b.a }}
            {%- if b.l1_label != blank or b.l2_label != blank -%}
              <p class="hp-11-links">
                {%- if b.l1_label != blank -%}<a class="hp-11-link" href="{{ b.l1_url }}"{% if b.l1_tab %} target="_blank" rel="noopener"{% endif %}>{{ b.l1_label }}</a>{%- endif -%}
                {%- if b.l1_label != blank and b.l2_label != blank %} {% endif -%}
                {%- if b.l2_label != blank -%}<a class="hp-11-link" href="{{ b.l2_url }}"{% if b.l2_tab %} target="_blank" rel="noopener"{% endif %}>{{ b.l2_label }}</a>{%- endif -%}
              </p>
            {%- endif -%}
          </div>
        </details>
      {%- endfor -%}
    </div>
  </div>
  {%- if s.schema and section.blocks.size > 0 -%}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {%- for block in section.blocks -%}
      {
        "@type": "Question",
        "name": {{ block.settings.q | strip_html | json }},
        "acceptedAnswer": { "@type": "Answer", "text": {{ block.settings.a | strip_html | strip_newlines | strip | json }} }
      }{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ]
  }
  </script>
  {%- endif -%}
</section>
{% schema %}
{
  "name": "HÏ 11 · FAQ",
  "tag": "div",
  "class": "hp-shopify-section",
  "settings": [
