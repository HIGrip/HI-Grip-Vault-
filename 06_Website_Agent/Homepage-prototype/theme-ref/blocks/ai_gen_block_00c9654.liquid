{% doc %}
  @prompt
    Een catchy knop waar op staat ''Lees meer'' nadat mensen het stuk hebben gelezen in het kort over ''hoe is hi grip ontstaan?''
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-read-more-button-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
  }

  .ai-read-more-link-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 14px 32px;
    background-color: {{ block.settings.button_bg_color }};
    color: {{ block.settings.button_text_color }};
    text-decoration: none;
    border-radius: {{ block.settings.border_radius }}px;
    font-size: {{ block.settings.font_size }}px;
    font-weight: 600;
    transition: all 0.3s ease;
    border: {{ block.settings.border_width }}px solid {{ block.settings.border_color }};
    position: relative;
    overflow: hidden;
  }

  .ai-read-more-link-{{ ai_gen_id }}::before {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(90deg, transparent, {{ block.settings.button_hover_bg_color }}26, transparent);
    transition: left 0.5s ease;
  }

  .ai-read-more-link-{{ ai_gen_id }}:hover::before {
    left: 100%;
  }

  .ai-read-more-link-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_bg_color }};
    color: {{ block.settings.button_hover_text_color }};
    border-color: {{ block.settings.border_hover_color }};
    transform: translateY(-2px);
    box-shadow: 0 4px 12px {{ block.settings.button_hover_bg_color }}40;
  }

  .ai-read-more-icon-{{ ai_gen_id }} {
    width: 20px;
    height: 20px;
    transition: transform 0.3s ease;
  }

  .ai-read-more-link-{{ ai_gen_id }}:hover .ai-read-more-icon-{{ ai_gen_id }} {
    transform: translateX(4px);
  }

  @media screen and (max-width: 749px) {
    .ai-read-more-button-{{ ai_gen_id }} {
      width: 100%;
    }

    .ai-read-more-link-{{ ai_gen_id }} {
      padding: 12px 24px;
      font-size: {{ block.settings.font_size | times: 0.9 }}px;
    }
  }
{% endstyle %}

<div class="ai-read-more-button-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <a href="{{ block.settings.button_link }}" class="ai-read-more-link-{{ ai_gen_id }}">
    <span>{{ block.settings.button_text }}</span>
    <svg class="ai-read-more-icon-{{ ai_gen_id }}" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <line x1="5" y1="12" x2="19" y2="12"></line>
      <polyline points="12 5 19 12 12 19"></polyline>
    </svg>
  </a>
</div>

{% schema %}
{
  "name": "Lees meer knop",
  "settings": [
    {
      "type": "header",
      "content": "Knop"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Knoptekst",
      "default": "Lees meer"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Knop link"
    },
    {
      "type": "range",
      "id": "font_size",
      "label": "Tekstgrootte",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop breedte",
      "min": 20,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 30
    },
    {
      "type": "header",
      "content": "Kleuren"
    },
    {
      "type": "color",
      "id": "button_bg_color",
      "label": "Achtergrondkleur",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Tekstkleur",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "button_hover_bg_color",
      "label": "Hover achtergrondkleur",
      "default": "#333333"
    },
    {
      "type": "color",
      "id": "button_hover_text_color",
      "label": "Hover tekstkleur",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Rand"
    },
    {
      "type": "range",
      "id": "border_width",
      "label": "Randbreedte",
      "min": 0,
      "max": 4,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Randkleur",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "border_hover_color",
      "label": "Hover randkleur",
      "default": "#333333"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Afronding",
      "min": 0,
      "max": 50,
      "step": 2,
      "unit": "px",
      "default": 26
    }
  ],
  "presets": [
    {
      "name": "Lees meer knop"
    }
  ],
  "tag": null
}
{% endschema %}
