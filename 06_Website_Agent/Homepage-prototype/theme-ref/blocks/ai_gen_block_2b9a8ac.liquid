{% doc %}
  @prompt
    Een koptekst met een geanimeerd gloei-effect
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-glow-heading-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding: {{ block.settings.padding_vertical }}px {{ block.settings.padding_horizontal }}px;
    text-align: {{ block.settings.text_alignment }};
  }

  .ai-glow-heading__text-{{ ai_gen_id }} {
    font-size: {{ block.settings.font_size }}px;
    color: {{ block.settings.text_color }};
    margin: 0;
    position: relative;
    display: inline-block;
    text-shadow: 
      0 0 {{ block.settings.glow_intensity }}px {{ block.settings.glow_color }},
      0 0 {{ block.settings.glow_intensity | times: 2 }}px {{ block.settings.glow_color }},
      0 0 {{ block.settings.glow_intensity | times: 3 }}px {{ block.settings.glow_color }};
  }

  @media screen and (max-width: 749px) {
    .ai-glow-heading__text-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.font_size }}px * 0.7);
    }
  }
{% endstyle %}

<div
  class="ai-glow-heading-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  {% if block.settings.heading_text != blank %}
    <{{ block.settings.heading_tag | default: "h2" }} class="ai-glow-heading__text-{{ ai_gen_id }}">
      {{ block.settings.heading_text }}
    </{{ block.settings.heading_tag | default: "h2" }}>
  {% else %}
    <{{ block.settings.heading_tag | default: "h2" }} class="ai-glow-heading__text-{{ ai_gen_id }}">
      Voeg je koptekst toe
    </{{ block.settings.heading_tag | default: "h2" }}>
  {% endif %}
</div>

{% schema %}
{
  "name": "Gloeiende koptekst",
  "settings": [
    { "type": "select", "id": "heading_tag", "label": "Kopniveau (SEO)", "options": [ {"value":"h1","label":"H1"}, {"value":"h2","label":"H2"}, {"value":"h3","label":"H3"}, {"value":"h4","label":"H4"}, {"value":"p","label":"Geen kop (alinea)"} ], "default": "h2" },
    {
      "type": "text",
      "id": "heading_text",
      "label": "Koptekst"
    },
    {
      "type": "range",
      "id": "font_size",
      "label": "Lettergrootte",
      "min": 20,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Uitlijning",
      "options": [
        {
          "value": "left",
          "label": "Links"
        },
        {
          "value": "center",
          "label": "Midden"
        },
        {
          "value": "right",
          "label": "Rechts"
        }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Breedte op desktop",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "header",
      "content": "Gloei-effect"
    },
    {
      "type": "color",
      "id": "glow_color",
      "label": "Gloei kleur",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "glow_intensity",
      "label": "Gloei intensiteit",
      "min": 5,
      "max": 50,
      "step": 5,
      "unit": "px",
      "default": 20
    },
    {
      "type": "header",
      "content": "Kleuren"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Tekstkleur",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Afstand"
    },
    {
      "type": "range",
      "id": "padding_vertical",
      "label": "Verticale padding",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_horizontal",
      "label": "Horizontale padding",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 20
    }
  ],
  "presets": [
    {
      "name": "Gloeiende koptekst"
    }
  ]
}
{% endschema %}