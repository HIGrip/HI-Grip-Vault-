{% doc %}
  @prompt
    Ik wil een sectie waarin onze drie kernwaarden ''comfort'' , ''vertrouwen'' en ''innovatie'' als punten terugkomen in een sportieve stijl voor ons sportmerk. het moet overzichtelijke, energiek, sportief, modern en stijlvol eruit., de pictogrammen moet ik kunnen aanpassen en ook wil ik een pop up hebben als mensen op de homepage komen, nee niet zo een pop up maar de drie kernwaarden van net die wil ik terug en die wil ik animeren en de pictogrammen kunnen aanpassen, ik wil de grootte van de picogrammen ook kunnen aanpassen, ik wil de grootte van de drie pictogrammen nog groter kunnen maken
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-core-values-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding: {{ block.settings.section_padding }}px 20px;
    background: {{ block.settings.background_gradient_start }};
    background: linear-gradient(135deg, {{ block.settings.background_gradient_start }} 0%, {{ block.settings.background_gradient_end }} 100%);
  }

  .ai-core-values-container-{{ ai_gen_id }} {
    max-width: 1200px;
    margin: 0 auto;
  }

  .ai-core-values-header-{{ ai_gen_id }} {
    text-align: center;
    margin-bottom: {{ block.settings.header_spacing }}px;
  }

  .ai-core-values-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    color: {{ block.settings.title_color }};
    margin: 0 0 16px 0;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 2px;
  }

  .ai-core-values-subtitle-{{ ai_gen_id }} {
    font-size: {{ block.settings.subtitle_size }}px;
    color: {{ block.settings.subtitle_color }};
    margin: 0;
    font-weight: 400;
  }

  .ai-core-values-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: {{ block.settings.grid_gap }}px;
    margin-top: {{ block.settings.grid_spacing }}px;
  }

  .ai-core-values-item-{{ ai_gen_id }} {
    position: relative;
    background: {{ block.settings.card_background }};
    border-radius: {{ block.settings.card_border_radius }}px;
    padding: {{ block.settings.card_padding }}px;
    text-align: center;
    overflow: hidden;
    border: {{ block.settings.card_border_width }}px solid {{ block.settings.card_border_color }};
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .ai-core-values-item-{{ ai_gen_id }}:hover {
    transform: translateY(-8px);
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.15);
  }

  .ai-core-values-item-{{ ai_gen_id }}::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 5px;
    background: linear-gradient(90deg, {{ block.settings.accent_color_1 }}, {{ block.settings.accent_color_2 }});
  }

  .ai-core-values-icon-wrapper-{{ ai_gen_id }} {
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    margin: 0 auto {{ block.settings.icon_spacing }}px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, {{ block.settings.icon_bg_color_1 }}, {{ block.settings.icon_bg_color_2 }});
    border-radius: 50%;
    position: relative;
  }

  .ai-core-values-item-{{ ai_gen_id }}:hover .ai-core-values-icon-wrapper-{{ ai_gen_id }} {
    animation: ai-pulse-{{ ai_gen_id }} 0.6s ease;
  }

  @keyframes ai-pulse-{{ ai_gen_id }} {
    0%, 100% {
      transform: scale(1);
    }
    50% {
      transform: scale(1.1);
    }
  }

  .ai-core-values-icon-{{ ai_gen_id }} {
    width: {{ block.settings.icon_image_size }}%;
    height: {{ block.settings.icon_image_size }}%;
    object-fit: contain;
  }

  .ai-core-values-icon-svg-{{ ai_gen_id }} {
    width: {{ block.settings.icon_image_size }}%;
    height: {{ block.settings.icon_image_size }}%;
    stroke: {{ block.settings.icon_color }};
    fill: none;
    stroke-width: 2.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .ai-core-values-item-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.item_title_size }}px;
    color: {{ block.settings.item_title_color }};
    margin: 0 0 12px 0;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1px;
  }

  .ai-core-values-item-text-{{ ai_gen_id }} {
    font-size: {{ block.settings.item_text_size }}px;
    color: {{ block.settings.item_text_color }};
    line-height: 1.7;
    margin: 0;
  }

  @media screen and (max-width: 989px) {
    .ai-core-values-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media screen and (max-width: 749px) {
    .ai-core-values-{{ ai_gen_id }} {
      width: 100%;
    }

    .ai-core-values-grid-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: {{ block.settings.grid_gap | times: 0.8 }}px;
    }

    .ai-core-values-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size | times: 0.7 }}px;
    }

    .ai-core-values-subtitle-{{ ai_gen_id }} {
      font-size: {{ block.settings.subtitle_size | times: 0.9 }}px;
    }

    .ai-core-values-item-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.item_title_size | times: 0.9 }}px;
    }

    .ai-core-values-icon-wrapper-{{ ai_gen_id }} {
      width: {{ block.settings.icon_size | times: 0.8 }}px;
      height: {{ block.settings.icon_size | times: 0.8 }}px;
    }
  }
{% endstyle %}

<core-values-{{ ai_gen_id }} class="ai-core-values-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-core-values-container-{{ ai_gen_id }}">
    {% if block.settings.show_header %}
      <div class="ai-core-values-header-{{ ai_gen_id }}">
        {% if block.settings.title != blank %}
          <{{ block.settings.heading_tag | default: "h2" }} class="ai-core-values-title-{{ ai_gen_id }}">{{ block.settings.title }}</{{ block.settings.heading_tag | default: "h2" }}>
        {% endif %}
        {% if block.settings.subtitle != blank %}
          <p class="ai-core-values-subtitle-{{ ai_gen_id }}">{{ block.settings.subtitle }}</p>
        {% endif %}
      </div>
    {% endif %}

    <div class="ai-core-values-grid-{{ ai_gen_id }}">
      <div class="ai-core-values-item-{{ ai_gen_id }}" data-index="0">
        <div class="ai-core-values-icon-wrapper-{{ ai_gen_id }}">
          {% if block.settings.value_1_icon %}
            <img 
              src="{{ block.settings.value_1_icon | image_url: width: 400 }}" 
              alt="{{ block.settings.value_1_title }}"
              class="ai-core-values-icon-{{ ai_gen_id }}"
              loading="lazy"
            >
          {% else %}
            <svg class="ai-core-values-icon-svg-{{ ai_gen_id }}" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
              <path d="M12 2L2 7v10c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V7l-10-5z"/>
              <path d="M9 12l2 2 4-4"/>
            </svg>
          {% endif %}
        </div>
        <h3 class="ai-core-values-item-title-{{ ai_gen_id }}">{{ block.settings.value_1_title }}</h3>
        <p class="ai-core-values-item-text-{{ ai_gen_id }}">{{ block.settings.value_1_text }}</p>
      </div>

      <div class="ai-core-values-item-{{ ai_gen_id }}" data-index="1">
        <div class="ai-core-values-icon-wrapper-{{ ai_gen_id }}">
          {% if block.settings.value_2_icon %}
            <img 
              src="{{ block.settings.value_2_icon | image_url: width: 400 }}" 
              alt="{{ block.settings.value_2_title }}"
              class="ai-core-values-icon-{{ ai_gen_id }}"
              loading="lazy"
            >
          {% else %}
            <svg class="ai-core-values-icon-svg-{{ ai_gen_id }}" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
              <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
              <circle cx="12" cy="7" r="4"/>
            </svg>
          {% endif %}
        </div>
        <h3 class="ai-core-values-item-title-{{ ai_gen_id }}">{{ block.settings.value_2_title }}</h3>
        <p class="ai-core-values-item-text-{{ ai_gen_id }}">{{ block.settings.value_2_text }}</p>
      </div>

      <div class="ai-core-values-item-{{ ai_gen_id }}" data-index="2">
        <div class="ai-core-values-icon-wrapper-{{ ai_gen_id }}">
          {% if block.settings.value_3_icon %}
            <img 
              src="{{ block.settings.value_3_icon | image_url: width: 400 }}" 
              alt="{{ block.settings.value_3_title }}"
              class="ai-core-values-icon-{{ ai_gen_id }}"
              loading="lazy"
            >
          {% else %}
            <svg class="ai-core-values-icon-svg-{{ ai_gen_id }}" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
              <circle cx="12" cy="12" r="3"/>
              <path d="M12 1v6m0 6v6M4.22 4.22l4.24 4.24m5.08 5.08l4.24 4.24M1 12h6m6 0h6M4.22 19.78l4.24-4.24m5.08-5.08l4.24-4.24"/>
            </svg>
          {% endif %}
        </div>
        <h3 class="ai-core-values-item-title-{{ ai_gen_id }}">{{ block.settings.value_3_title }}</h3>
        <p class="ai-core-values-item-text-{{ ai_gen_id }}">{{ block.settings.value_3_text }}</p>
      </div>
    </div>
  </div>
</core-values-{{ ai_gen_id }}>

<script>
  (function() {
    class CoreValues{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.items = this.querySelectorAll('.ai-core-values-item-{{ ai_gen_id }}');
        this.setupObserver();
      }

      setupObserver() {
        const options = {
          threshold: 0.2,
          rootMargin: '0px'
        };

        const observer = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              const index = parseInt(entry.target.dataset.index);
              setTimeout(() => {
                entry.target.style.opacity = '1';
                entry.target.style.transform = 'translateY(0) scale(1)';
              }, index * 150);
            }
          });
        }, options);

        this.items.forEach((item) => {
          item.style.opacity = '0';
          item.style.transform = 'translateY(30px) scale(0.95)';
          item.style.transition = 'opacity 0.6s ease, transform 0.6s cubic-bezier(0.34, 1.56, 0.64, 1)';
          observer.observe(item);
        });
      }
    }

    customElements.define('core-values-{{ ai_gen_id }}', CoreValues{{ ai_gen_id }});
  })();
</script>

