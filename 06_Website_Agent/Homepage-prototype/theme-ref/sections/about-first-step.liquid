    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding onder desktop",
      "min": 0,
      "max": 240,
      "step": 4,
      "default": 160,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
