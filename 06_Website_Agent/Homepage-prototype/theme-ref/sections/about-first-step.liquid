  "blocks": [
    {
      "type": "polaroid",
      "name": "Polaroid",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Foto",
          "info": "Leeg = standaard kinderfoto uit het thema."
        },
        {
          "type": "text",
          "id": "alt",
          "label": "Alt-tekst",
          "default": "Founder als kind"
        },
        {
          "type": "text",
          "id": "caption",
          "label": "Bijschrift"
        },
        {
