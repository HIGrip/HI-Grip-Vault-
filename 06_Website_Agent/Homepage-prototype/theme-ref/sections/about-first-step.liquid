    },
    {
      "type": "select",
      "id": "heading_align",
      "label": "Kop uitlijnen (desktop)",
      "options": [
        {
          "value": "left",
          "label": "Links"
        },
        {
          "value": "center",
          "label": "Gecentreerd"
        },
        {
          "value": "right",
          "label": "Rechts"
        }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "heading_align_m",
      "label": "Kop uitlijnen (mobiel)",
      "options": [
        {
          "value": "left",
          "label": "Links"
        },
        {
          "value": "center",
          "label": "Gecentreerd"
        },
        {
          "value": "right",
          "label": "Rechts"
        }
      ],
      "default": "left"
    },
    {
      "type": "textarea",
      "id": "lead",
      "label": "Lead",
      "default": "Dit zijn wij, jaren geleden. Die eerste stap bepaalt nog steeds hoe we naar sport kijken."
    },
    {
      "type": "select",
      "id": "lead_align",
      "label": "Inleiding uitlijnen (desktop)",
      "options": [
        {
          "value": "left",
          "label": "Links"
        },
        {
          "value": "center",
          "label": "Gecentreerd"
        },
        {
          "value": "right",
          "label": "Rechts"
        }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "lead_align_m",
      "label": "Inleiding uitlijnen (mobiel)",
      "options": [
        {
          "value": "left",
          "label": "Links"
        },
        {
          "value": "center",
          "label": "Gecentreerd"
        },
        {
          "value": "right",
          "label": "Rechts"
        }
      ],
      "default": "left"
    },
    {
      "type": "header",
      "content": "Kop"
    },
    {
      "type": "select",
      "id": "heading_tag",
