{{ 'about-page.css' | asset_url | stylesheet_tag }}
<script src="{{ 'about-page.js' | asset_url }}" defer></script>
<script>document.documentElement.classList.add('ab-js');</script>
{%- liquid
  assign s = section.settings
  assign tag = s.heading_tag | default: 'h2'
-%}
<section class="ab ab-fs ab-pad" data-ab="firststep" data-anim="{{ s.animate }}" aria-label="Waar het begon" style="{% render 'about-vars', s: s %}">
  <div class="ab-wrap ab-fs__grid">
    <div>
      <{{ tag }} class="ab-h"{% render 'about-ta', d: s.heading_align, m: s.heading_align_m %}>{{ s.heading }}</{{ tag }}>
      {%- if s.lead != blank -%}<p class="ab-lead"{% render 'about-ta', d: s.lead_align, m: s.lead_align_m %}>{{ s.lead | escape }}</p>{%- endif -%}
    </div>
    <div class="ab-polas">
      {%- for block in section.blocks -%}
        {%- assign b = block.settings -%}
        {%- assign fb = 'about-kid-' | append: forloop.index | append: '.jpg' -%}
        <figure class="ab-pola" style="--t:{{ b.tape }};" {{ block.shopify_attributes }}>
          {%- if b.image != blank -%}
            {{ b.image | image_url: width: 700 | image_tag: loading: 'lazy', sizes: '(min-width: 800px) 22vw, 40vw', widths: '300, 450, 700', alt: b.image.alt | default: b.alt }}
          {%- else -%}
            <img src="{{ fb | asset_url }}" alt="{{ b.alt | escape }}" loading="lazy" width="600" height="800">
          {%- endif -%}
          {%- if b.caption != blank -%}<figcaption {% render 'about-ta', d: b.caption_align, m: b.caption_align_m %}>{{ b.caption | escape }}</figcaption>{%- endif -%}
        </figure>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Over ons: Eerste stap",
  "settings": [
    {
      "type": "header",
      "content": "Tekst"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
