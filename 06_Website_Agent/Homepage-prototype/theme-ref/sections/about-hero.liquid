{{ 'about-page.css' | asset_url | stylesheet_tag }}
<script src="{{ 'about-page.js' | asset_url }}" defer></script>
<script>document.documentElement.classList.add('ab-js');</script>
{%- liquid
  assign s = section.settings
  assign tag = s.heading_tag | default: 'h1'
  assign alt = s.image.alt | default: s.image_alt
-%}
{% render 'about-schema' %}
<style>
  .ab-hero[data-anim="true"] .ab-l:nth-child(4) { animation-delay: .44s; }
</style>
<section class="ab ab-hero" data-ab="hero" data-anim="{{ s.animate }}" data-zoom="{{ s.zoom }}" aria-label="Manifest"
  style="{% render 'about-vars', s: s %}--ab-hh:{{ s.height_desktop }};--ab-hh-m:{{ s.height_mobile }};--ab-fx:{{ s.focus_x }}%;--ab-fy:{{ s.focus_y }}%;--ab-ov:{{ s.overlay | divided_by: 100.0 }};">
  <div class="ab-hero__frame">
    <div class="ab-hero__media">
      {%- if s.media_type == 'video' and s.video != blank -%}
        {{ s.video | video_tag: autoplay: true, muted: true, loop: true, playsinline: true, controls: false, image_size: '1920x' }}
      {%- elsif s.media_type == 'video' and s.video_url.type == 'youtube' -%}
        <iframe src="https://www.youtube.com/embed/{{ s.video_url.id }}?autoplay=1&mute=1&loop=1&playlist={{ s.video_url.id }}&controls=0&playsinline=1&rel=0" title="{{ alt | escape }}" allow="autoplay; encrypted-media" loading="lazy"></iframe>
      {%- elsif s.media_type == 'video' and s.video_url.type == 'vimeo' -%}
        <iframe src="https://player.vimeo.com/video/{{ s.video_url.id }}?background=1&autoplay=1&loop=1&muted=1" title="{{ alt | escape }}" allow="autoplay" loading="lazy"></iframe>
      {%- elsif s.image != blank -%}
        {{ s.image | image_url: width: 2400 | image_tag: loading: 'eager', fetchpriority: 'high', sizes: '100vw', widths: '800, 1200, 1600, 2000, 2400', alt: alt }}
      {%- else -%}
        {{ 'image' | placeholder_svg_tag: 'ab-hero__ph' }}
      {%- endif -%}
    </div>
    <div class="ab-hero__txt ab-wrap">
      <{{ tag }} class="ab-h">{%- if s.line_1 != blank -%}<span class="ab-l"{% render 'about-ta', d: s.line_1_align, m: s.line_1_align_m %}>{{ s.line_1 }} </span>{%- endif -%}{%- if s.line_2 != blank -%}<span class="ab-l"{% render 'about-ta', d: s.line_2_align, m: s.line_2_align_m %}>{{ s.line_2 }} </span>{%- endif -%}{%- if s.line_3 != blank -%}<span class="ab-l"{% render 'about-ta', d: s.line_3_align, m: s.line_3_align_m %}>{{ s.line_3 }} </span>{%- endif -%}{%- if s.line_4 != blank -%}<span class="ab-l"{% render 'about-ta', d: s.line_4_align, m: s.line_4_align_m %}>{{ s.line_4 }} </span>{%- endif -%}</{{ tag }}>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Over ons: Hero",
  "settings": [
    {
      "type": "header",
      "content": "Media"
    },
    {
      "type": "select",
      "id": "media_type",
      "label": "Mediatype",
      "options": [
        {
          "value": "image",
          "label": "Foto"
        },
        {
          "value": "video",
          "label": "Video"
        }
      ],
      "default": "image"
