{{ 'gripsocks2-launch.css' | asset_url | stylesheet_tag }}
<script src="{{ 'g2-countdown.js' | asset_url }}" defer></script>

{%- liquid
  assign s = section.settings
-%}

<section class="g2 g2-showcase">
  <div class="g2-showcase__grid">
    {%- for block in section.blocks limit: 2 -%}
      <div class="g2-showcase__photo" {{ block.shopify_attributes }}>
        {%- if block.settings.image != blank -%}
          {{ block.settings.image | image_url: width: 1400 | image_tag: loading: 'lazy', widths: '480,800,1100,1400', sizes: '50vw', alt: block.settings.caption | default: 'Performance Grip Socks 2.0' }}
        {%- else -%}
          <div class="g2-showcase__placeholder"><span>Foto ontbreekt nog</span></div>
        {%- endif -%}
      </div>
    {%- endfor -%}
  </div>

  <div class="g2-showcase__bottom" style="--g2-showcase-lift: {{ s.content_lift | default: 40 }}px;">
    {%- if s.eyebrow != blank -%}<span class="g2-eyebrow"><span class="dot"></span> {{ s.eyebrow }}</span>{%- endif -%}
    {%- if s.heading != blank -%}<p class="g2-showcase__heading">{{ s.heading }}</p>{%- endif -%}
    {%- if s.promo_title_main != blank or s.promo_title_accent != blank -%}
      <p class="g2-showcase__promo-title">{{ s.promo_title_main }} <span class="g2-showcase__promo-accent">{{ s.promo_title_accent }}</span></p>
    {%- endif -%}
    {%- if s.promo_line != blank -%}<p class="g2-showcase__promo-line">{{ s.promo_line }}</p>{%- endif -%}
    {%- if s.promo_end_iso != blank -%}
      {%- render 'g2-countdown', end_iso: s.promo_end_iso, label: s.promo_label, expired_text: s.promo_expired_text, extra_class: 'g2-countdown--lg' -%}
    {%- endif -%}
    {%- if s.cta_text != blank -%}<a href="{{ s.cta_url | default: '#' }}" class="g2-btn">{{ s.cta_text }} &rarr;</a>{%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Gripsocks 2.0 — showcase",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Kicker (klein, boven producttitel)", "default": "The next gen grip" },
    { "type": "text", "id": "heading", "label": "Producttitel", "default": "Performance Grip Socks 2.0" },
    { "type": "header", "content": "Positionering" },
    { "type": "range", "id": "content_lift", "label": "Tekstblok omhoog vanaf onderrand", "min": 0, "max": 300, "step": 10, "unit": "px", "default": 100 },
    { "type": "header", "content": "Pre-order 2+2 — actie" },
    { "type": "text", "id": "promo_title_main", "label": "Actie-titel (normaal)", "default": "2+2" },
    { "type": "text", "id": "promo_title_accent", "label": "Actie-titel (accentkleur)", "default": "gratis" },
    { "type": "textarea", "id": "promo_line", "label": "Toelichting", "default": "Bestel 2 paar Performance Grip Socks 2.0, ontvang er automatisch 2 gratis bij — alleen tijdens de pre-order fase." },
    { "type": "text", "id": "promo_label", "label": "Label bij teller (leeg = geen countdown)", "default": "Nog" },
    { "type": "text", "id": "promo_end_iso", "label": "Einddatum pre-order (ISO met tijdzone)", "info": "Bijv. 2026-08-28T23:59:00+02:00", "default": "2026-08-28T23:59:00+02:00" },
    { "type": "text", "id": "promo_expired_text", "label": "Tekst na afloop", "default": "Pre-order gesloten" },
    { "type": "header", "content": "Knop" },
    { "type": "text", "id": "cta_text", "label": "Knoptekst (leeg = geen knop)", "default": "Shop nu" },
    { "type": "url", "id": "cta_url", "label": "Knop-link" }
  ],
  "blocks": [
    {
      "type": "photo",
      "name": "Foto",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Foto" },
        { "type": "text", "id": "caption", "label": "Alt-tekst (optioneel)" }
      ]
    }
  ],
  "max_blocks": 2,
  "presets": [
    {
      "name": "Gripsocks 2.0 — showcase",
      "blocks": [
        { "type": "photo", "settings": {} },
        { "type": "photo", "settings": {} }
      ]
    }
  ]
}
{% endschema %}
