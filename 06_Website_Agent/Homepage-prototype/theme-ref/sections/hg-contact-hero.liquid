{{ 'hg-contact.css' | asset_url | stylesheet_tag }}
<script src="{{ 'hg-contact.js' | asset_url }}" defer></script>
{%- liquid
  assign s = section.settings
  assign tag = s.heading_tag | default: 'h1'
-%}
{% render 'hg-style', s: s, section_id: section.id, cls: 'hgc' %}
<section
  class="hgc hgc-hero"
  data-animate="{{ s.animate }}"
  style="
    {% if s.bg_color != blank %}--c-bg:{{ s.bg_color }};{% endif %}
    {% if s.text_color != blank %}--c-fg:{{ s.text_color }};{% endif %}
    {% if s.accent_color != blank %}--c-accent:{{ s.accent_color }};{% endif %}
    {% if s.heading_color != blank %}--c-heading:{{ s.heading_color }};{% endif %}
    --c-pt:{{ s.padding_top }}px;--c-pb:{{ s.padding_bottom }}px;--c-pt-m:{{ s.padding_top_mobile }}px;--c-pb-m:{{ s.padding_bottom_mobile }}px;
  "
  {{ section.shopify_attributes }}
>
  <div class="hgc__wrap">
    <div class="hgc-hero__grid">
      <div>
        {%- if s.eyebrow != blank -%}<p class="hgc__eyebrow">{{ s.eyebrow }}</p>{%- endif -%}
        {%- if s.heading != blank -%}<{{ tag }} class="hgc__h1">{{ s.heading }}</{{ tag }}>{%- endif -%}
        {%- if s.lead != blank -%}<p class="hgc__lead">{{ s.lead }}</p>{%- endif -%}
      </div>
      {%- if s.cta_label != blank and s.cta_link != blank -%}
        <div class="hgc-cta">
          <a class="hgc__pill" href="{{ s.cta_link }}">
            {{- s.cta_label -}}
            <svg aria-hidden="true" viewBox="0 0 16 16"><path d="M5.5 2.5 11 8l-5.5 5.5" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="square"/></svg>
          </a>
        </div>
      {%- endif -%}
    </div>

    {%- if section.blocks.size > 0 -%}
      <div class="hgc-hero__channels">
        {%- for block in section.blocks -%}
          {%- assign b = block.settings -%}
          <article class="hgc-ch{% if b.style == 'main' %} hgc-ch--main{% endif %}" {{ block.shopify_attributes }}>
            <div class="hgc-ch__top">
              <span class="hgc__label">{{ b.label }}</span>
              <svg class="hgc-ch__icon" viewBox="0 0 40 40" aria-hidden="true">
                {%- case b.icon -%}
                  {%- when 'phone' -%}<rect x="12" y="5" width="16" height="30" fill="none" stroke="currentColor" stroke-width="2"/><path d="M18 30h4" stroke="currentColor" stroke-width="2"/>
                  {%- when 'building' -%}<path d="M6 34V14l14-8 14 8v20" fill="none" stroke="currentColor" stroke-width="2"/><path d="M15 34V22h10v12" fill="none" stroke="currentColor" stroke-width="2"/>
                  {%- else -%}<rect x="5" y="9" width="30" height="22" fill="none" stroke="currentColor" stroke-width="2"/><path d="M5 10l15 12 15-12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square"/>
                {%- endcase -%}
              </svg>
            </div>
            {%- if b.title != blank -%}<h2 class="hgc__h3">{{ b.title }}</h2>{%- endif -%}
            {%- if b.value != blank -%}<div class="hgc-ch__value">{{ b.value }}</div>{%- endif -%}
            {%- if b.text != blank -%}<p>{{ b.text }}</p>{%- endif -%}
            {%- if b.button_label != blank or b.show_copy -%}
              <div class="hgc-ch__actions">
                {%- if b.button_label != blank and b.button_link != blank -%}
                  <a
                    class="hgc__pill hgc__pill--sm{% if b.button_style == 'dark' %} hgc__pill--dark{% elsif b.button_style == 'ghost' %} hgc__pill--ghost{% endif %}"
                    href="{{ b.button_link }}"
                    {% if b.new_tab %}target="_blank" rel="noopener"{% endif %}
                  >
                    {{- b.button_label -}}
                    <svg aria-hidden="true" viewBox="0 0 16 16"><path d="M5.5 2.5 11 8l-5.5 5.5" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="square"/></svg>
                  </a>
                {%- endif -%}
                {%- if b.show_copy and b.value != blank -%}
                  <button class="hgc-copy" type="button" data-hgc-copy="{{ b.value | escape }}" data-copied="{{ s.copied_label | escape }}">{{ s.copy_label }}</button>
                {%- endif -%}
              </div>
            {%- endif -%}
          </article>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Contact: Kop en kanalen",
  "settings": [
    { "type": "header", "content": "Tekst" },
    { "type": "text", "id": "eyebrow", "label": "Bovenregel", "default": "Klantenservice" },
    { "type": "text", "id": "heading", "label": "Kop", "default": "Neem contact op" },
    { "type": "select", "id": "heading_tag", "label": "Kopniveau (SEO)", "options": [ { "value": "h1", "label": "H1" }, { "value": "h2", "label": "H2" }, { "value": "h3", "label": "H3" }, { "value": "p", "label": "Gewone tekst (p)" } ], "default": "h1" },
    { "type": "textarea", "id": "lead", "label": "Introtekst", "default": "Mail, bel of stuur een bericht. We helpen je verder." },
    { "type": "select", "id": "text_align", "label": "Tekst uitlijnen", "options": [ { "value": "default", "label": "Standaard" }, { "value": "left", "label": "Links" }, { "value": "center", "label": "Gecentreerd" }, { "value": "right", "label": "Rechts" } ], "default": "default" },
    { "type": "text", "id": "cta_label", "label": "Knop: tekst", "default": "Stuur bericht" },
    { "type": "text", "id": "cta_link", "label": "Knop: link", "default": "#formulier" },
    { "type": "color", "id": "button_bg", "label": "Knoppen: achtergrondkleur (leeg = standaard)" },
    { "type": "color", "id": "button_fg", "label": "Knoppen: tekstkleur" },
    { "type": "color", "id": "button_border", "label": "Knoppen: randkleur" },
    { "type": "range", "id": "button_radius", "label": "Knoppen: hoekafronding", "min": 0, "max": 40, "step": 2, "unit": "px", "default": 40 },
    { "type": "text", "id": "copy_label", "label": "Tekst kopieerknop", "default": "Kopieer" },
    { "type": "text", "id": "copied_label", "label": "Tekst na kopiëren", "default": "Gekopieerd" },
    { "type": "header", "content": "Kleuren" },
    { "type": "color", "id": "bg_color", "label": "Achtergrondkleur", "default": "#000000" },
    { "type": "color", "id": "text_color", "label": "Tekstkleur", "default": "#ffffff" },
    { "type": "color", "id": "accent_color", "label": "Accentkleur (bovenregel, rand bij hover)", "default": "#ccff00" },
    { "type": "color", "id": "heading_color", "label": "Kleur koppen (leeg = tekstkleur)" },
    { "type": "checkbox", "id": "animate", "label": "Animatie aan", "default": true },
    { "type": "header", "content": "Ruimte" },
    { "type": "range", "id": "padding_top", "label": "Ruimte boven (desktop)", "min": 0, "max": 240, "step": 4, "unit": "px", "default": 96 },
    { "type": "range", "id": "padding_bottom", "label": "Ruimte onder (desktop)", "min": 0, "max": 240, "step": 4, "unit": "px", "default": 96 },
    { "type": "range", "id": "padding_top_mobile", "label": "Ruimte boven (mobiel)", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 56 },
    { "type": "range", "id": "padding_bottom_mobile", "label": "Ruimte onder (mobiel)", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 64 }
  ],
  "blocks": [
    {
      "type": "channel",
      "name": "Kanaal",
      "settings": [
        { "type": "select", "id": "style", "label": "Stijl", "options": [ { "value": "main", "label": "Hoofdkaart (wit)" }, { "value": "dark", "label": "Donker" } ], "default": "dark" },
        { "type": "text", "id": "label", "label": "Label", "default": "Klantenservice" },
        { "type": "select", "id": "icon", "label": "Icoon", "options": [ { "value": "mail", "label": "E-mail" }, { "value": "phone", "label": "Telefoon" }, { "value": "building", "label": "Gebouw" } ], "default": "mail" },
        { "type": "text", "id": "title", "label": "Titel", "default": "Mail ons" },
        { "type": "text", "id": "value", "label": "Groot (e-mailadres / telefoonnummer)" },
        { "type": "textarea", "id": "text", "label": "Tekst" },
        { "type": "text", "id": "button_label", "label": "Knop: tekst" },
        { "type": "text", "id": "button_link", "label": "Knop: link", "info": "Bijv. mailto:info@higrip.nl of tel:+31624566547" },
        { "type": "select", "id": "button_style", "label": "Knop: stijl", "options": [ { "value": "light", "label": "Wit" }, { "value": "dark", "label": "Zwart" }, { "value": "ghost", "label": "Alleen rand" } ], "default": "light" },
        { "type": "checkbox", "id": "new_tab", "label": "Knop openen in nieuw tabblad", "default": false },
        { "type": "checkbox", "id": "show_copy", "label": "Kopieerknop tonen", "default": false }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [ { "name": "Contact: Kop en kanalen" } ]
}
{% endschema %}