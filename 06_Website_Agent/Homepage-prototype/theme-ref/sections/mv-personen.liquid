{{ 'mv-page.css' | asset_url | stylesheet_tag }}
<script src="{{ 'mv-page.js' | asset_url }}" defer></script>
{%- assign s = section.settings -%}
<div class="mv">
<script>document.currentScript.parentNode.classList.add('mv-js');</script>
<section class="mv-band-light mv-pad{%- if s.custom_pad %} mv-custom-pad{% endif -%}" data-ab="who" {% render 'mv-attrs', s: s %} style="{% render 'mv-vars', s: s %}">
  <div class="mv-wrap">
    <div class="mv-who__head">{%- for block in section.blocks -%}{% render 'mv-gen', block: block, i: forloop.index0, zone: 'boven' %}{%- endfor -%}</div>
    {%- if s.image != blank or s.show_default_image -%}
      <figure class="mv-who__strip mv-rv">
        {%- if s.image != blank -%}
          {{ s.image | image_url: width: 2000 | image_tag: loading: 'lazy', alt: s.image_alt, widths: '800, 1200, 1600, 2000', sizes: '120vw' }}
        {%- else -%}
          <img width="2000" height="382" loading="lazy" decoding="async" alt="{{ s.image_alt | escape }}" src="{{ 'mv-rotterdam-business-school.jpg' | asset_url }}">
        {%- endif -%}
      </figure>
    {%- endif -%}
    <div class="mv-people">
      {%- for block in section.blocks -%}
        {%- if block.type == 'persoon' -%}
          {%- assign b = block.settings -%}
          <article class="mv-person mv-rv" {{ block.shopify_attributes }}>
            <h3{% render 'mv-ta', d: b.naam_align, m: b.naam_align_m %}>{{ b.naam | escape }}</h3>
            <div{% render 'mv-ta', d: b.align, m: b.align_m %}><p class="mv-role">{{ b.rol | escape }}</p><p class="mv-muted">{{ b.tekst | escape }}</p></div>
          </article>
        {%- endif -%}
      {%- endfor -%}
    </div>
    <div class="mv-who__foot">{%- for block in section.blocks -%}{% render 'mv-gen', block: block, i: forloop.index0, zone: 'onder' %}{%- endfor -%}</div>
  </div>
</section>
</div>
