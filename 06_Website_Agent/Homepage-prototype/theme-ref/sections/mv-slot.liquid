{{ 'mv-page.css' | asset_url | stylesheet_tag }}
<script src="{{ 'mv-page.js' | asset_url }}" defer></script>
{%- assign s = section.settings -%}
<div class="mv">
<script>document.currentScript.parentNode.classList.add('mv-js');</script>
<section class="mv-band-black mv-pad{%- if s.custom_pad %} mv-custom-pad{% endif -%}" data-ab="outro" aria-label="Afsluiting" {% render 'mv-attrs', s: s %} style="{% render 'mv-vars', s: s %}">
  <div class="mv-wrap">
    <p class="mv-out__text" data-words{% render 'mv-ta', d: s.tekst_align, m: s.tekst_align_m %}>{{ s.tekst }}</p>
    <div class="mv-out__row">{%- for block in section.blocks -%}{% render 'mv-gen', block: block, i: forloop.index0, zone: 'onder' %}{%- endfor -%}</div>
  </div>
</section>
</div>
