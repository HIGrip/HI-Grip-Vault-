{{ 'mv-page.css' | asset_url | stylesheet_tag }}
<script src="{{ 'mv-page.js' | asset_url }}" defer></script>
{%- assign s = section.settings -%}
<div class="mv">
<script>document.currentScript.parentNode.classList.add('mv-js');</script>
<section class="mv-band-warm mv-pad{%- if s.custom_pad %} mv-custom-pad{% endif -%}" data-ab="plain" {% render 'mv-attrs', s: s %} style="{% render 'mv-vars', s: s %}">
  <div class="mv-wrap mv-you">
    <figure class="mv-you__img mv-rv">
      {%- if s.image != blank -%}
        {{ s.image | image_url: width: 1400 | image_tag: loading: 'lazy', alt: s.image_alt, widths: '600, 900, 1200, 1400', sizes: '(min-width: 900px) 40vw, 100vw' }}
      {%- else -%}
        <img width="1000" height="1013" loading="lazy" decoding="async" alt="{{ s.image_alt | escape }}" src="{{ 'mv-gripsokken-tennisclub.jpg' | asset_url }}">
      {%- endif -%}
    </figure>
    <div class="mv-you__copy">
      {%- for block in section.blocks -%}
        {%- if block.type == 'cijfers' -%}
          {%- assign b = block.settings -%}
          <div class="mv-stat mv-rv" role="group" aria-label="Onderzoek"{% render 'mv-ta', d: b.align, m: b.align_m %} {{ block.shopify_attributes }}>
            <div class="mv-stat__nums">
              <div><b>{{ b.cijfer_1 | escape }}</b><span>{{ b.label_1 | escape }}</span></div>
              <div class="mv-vs"><b>{{ b.cijfer_2 | escape }}</b><span>{{ b.label_2 | escape }}</span></div>
            </div>
            <p>{{ b.tekst | escape }}</p>
            <cite>{{ b.bron | escape }}</cite>
          </div>
        {%- else -%}
          {% render 'mv-gen', block: block, i: forloop.index0, zone: '' %}
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>
</div>
