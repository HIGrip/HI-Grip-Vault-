{{ 'mv-page.css' | asset_url | stylesheet_tag }}
<script src="{{ 'mv-page.js' | asset_url }}" defer></script>
{%- assign s = section.settings -%}
<div class="mv">
<script>document.currentScript.parentNode.classList.add("mv-js");window.MV_ASSETS=window.MV_ASSETS||{};MV_ASSETS['gripsokken-tennisclub.jpg']={{ 'mv-gripsokken-tennisclub.jpg' | asset_url | json }};MV_ASSETS['hero-tennis-serve.jpg']={{ 'mv-hero-tennis-serve.jpg' | asset_url | json }};MV_ASSETS['rotterdam-business-school.jpg']={{ 'mv-rotterdam-business-school.jpg' | asset_url | json }};</script>
<section class="mv-band-warm mv-pad{%- if s.custom_pad %} mv-custom-pad{% endif -%}" data-ab="strip" aria-labelledby="perf-title" style="{%- if s.bg_color != blank -%}background:{{ s.bg_color }};{%- endif -%}{%- if s.text_color != blank -%}color:{{ s.text_color }};{%- endif -%}--mv-pt:{{ s.padding_top }}px;--mv-pb:{{ s.padding_bottom }}px;--mv-pt-m:{{ s.padding_top_mobile }}px;--mv-pb-m:{{ s.padding_bottom_mobile }}px;--mv-len:{{ s.scroll_length }}vh;--mv-len-m:{{ s.scroll_length_mobile }}vh;" data-ta="{{ s.text_align }}" data-ta-m="{{ s.text_align_m }}" data-w="{{ s.section_width }}" data-anim="{{ s.animate }}"> <div class="mv-wrap"> <div class="mv-mv__head"> <h2 class="mv-h2 mv-rv" id="perf-title">{{ s.t1 }}</h2> <p class="mv-lead mv-rv" style="--d:.12s">{{ s.t2 | escape }}</p> </div> <div class="mv-perf__vp" role="region" aria-label="Zes omschrijvingen van performance" tabindex="0"> <div class="mv-perf__track"> {%- for block in section.blocks -%}{%- if block.type == 'b1' -%}{%- assign b = block.settings -%}<div class="mv-perf__card{% if b.mod1 %} mv-perf__card--key{% endif %}" {{ block.shopify_attributes }}><p>{{ b.t1 | escape }}</p></div>{%- endif -%}{%- endfor -%}      </div> </div> <p class="mv-perf__after mv-muted mv-rv">{{ s.t3 | escape }}</p> </div> </section>
</div>
{% schema %}
{
  "name": "Missie: Performance",
  "settings": [
    {
      "type": "inline_richtext",
      "id": "t1",
      "label": "H2 · Wat is performance volgens HÏ Grip?",
      "default": "Wat is performance volgens <em>HÏ Grip?</em>"
    },
    {
      "type": "textarea",
      "id": "t2",
      "label": "P · Performance is voor HÏ Grip meer dan de winnende goal: het is ",
      "default": "Performance is voor HÏ Grip meer dan de winnende goal: het is elk moment waarop iemand net langer doorgaat dan normaal, op het veld én daarbuiten, en presteren is het centrale begrip achter alles wat HÏ Grip maakt, zegt en kiest."
    },
    {
      "type": "text",
      "id": "t3",
      "label": "P · Die momenten zijn de brandstof voor alles wat we maken en late",
      "default": "Die momenten zijn de brandstof voor alles wat we maken en laten zien."
    },
    {
      "type": "header",
      "content": "Opmaak"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Achtergrondkleur"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Tekstkleur"
    },
    {
      "type": "select",
      "id": "text_align",
      "label": "Tekst uitlijnen (desktop)",
      "options": [
        {
          "value": "",
          "label": "Standaard"
        },
        {
          "value": "left",
          "label": "Links"
        },
        {
          "value": "center",
          "label": "Gecentreerd"
        },
        {
          "value": "right",
          "label": "Rechts"
        }
      ],
      "default": ""
    },
    {
      "type": "select",
      "id": "text_align_m",
      "label": "Tekst uitlijnen (mobiel)",
      "options": [
        {
          "value": "",
          "label": "Standaard"
        },
        {
          "value": "left",
          "label": "Links"
        },
        {
          "value": "center",
          "label": "Gecentreerd"
        },
        {
          "value": "right",
          "label": "Rechts"
        }
      ],
      "default": ""
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Breedte",
      "options": [
        {
          "value": "",
          "label": "Pagina"
        },
        {
          "value": "full",
          "label": "Volledig"
        }
      ],
      "default": ""
    },
    {
      "type": "checkbox",
      "id": "custom_pad",
      "label": "Eigen padding gebruiken",
      "default": false
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding boven",
      "min": 0,
      "max": 240,
      "step": 4,
      "unit": "px",
      "default": 96
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding onder",
      "min": 0,
      "max": 240,
      "step": 4,
      "unit": "px",
      "default": 96
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Padding boven (mobiel)",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 52
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Padding onder (mobiel)",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 52
    },
    {
      "type": "checkbox",
      "id": "animate",
      "label": "Animaties aan",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "b1",
      "name": "1. perf__card",
      "settings": [
        {
          "type": "text",
          "id": "t1",
          "label": "P · Een gevoel van onsterfelijkheid.",
          "default": "Een gevoel van onsterfelijkheid."
        },
        {
          "type": "checkbox",
          "id": "mod1",
          "label": "Variant: perf__card--key",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Missie: Performance"
    }
  ]
}
{% endschema %}
