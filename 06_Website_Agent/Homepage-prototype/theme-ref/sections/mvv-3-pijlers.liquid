{{ 'mv-page.css' | asset_url | stylesheet_tag }}
<script src="{{ 'mv-page.js' | asset_url }}" defer></script>
{%- assign s = section.settings -%}
<div class="mv">
<script>document.currentScript.parentNode.classList.add("mv-js");window.MV_ASSETS=window.MV_ASSETS||{};MV_ASSETS['academy-tvb-open.jpg']={{ 'mv-academy-tvb-open.jpg' | asset_url | json }};MV_ASSETS['hardlopen-gripsokken.jpg']={{ 'mv-hardlopen-gripsokken.jpg' | asset_url | json }};MV_ASSETS['voetbal-gripsokken-wit.jpg']={{ 'mv-voetbal-gripsokken-wit.jpg' | asset_url | json }};</script>
<section class="mv-band-dark mv-pad{%- if s.custom_pad %} mv-custom-pad{% endif -%}" data-ab="principles" aria-labelledby="pil-title" style="{%- if s.bg_color != blank -%}background:{{ s.bg_color }};{%- endif -%}{%- if s.text_color != blank -%}color:{{ s.text_color }};{%- endif -%}--mv-pt:{{ s.padding_top }}px;--mv-pb:{{ s.padding_bottom }}px;--mv-pt-m:{{ s.padding_top_mobile }}px;--mv-pb-m:{{ s.padding_bottom_mobile }}px;--mv-len:{{ s.scroll_length }}vh;--mv-len-m:{{ s.scroll_length_mobile }}vh;" data-ta="{{ s.text_align }}" data-ta-m="{{ s.text_align_m }}" data-w="{{ s.section_width }}" data-anim="{{ s.animate }}"> <div class="mv-wrap"> <div class="mv-why__head"> <h2 class="mv-h2 mv-rv" id="pil-title">{{ s.t1 }}</h2> <p class="mv-lead mv-muted mv-rv" style="--d:.12s">{{ s.t2 | escape }}</p> </div> <ol class="mv-principles"> <li class="mv-pr"> <p class="mv-pr__big" data-w="Geloof" aria-hidden="true">{{ s.t3 | escape }}</p> <div class="mv-pr__txt"><h3>{{ s.t4 | escape }}</h3><p class="mv-muted">{{ s.t5 | escape }}</p></div> </li> <li class="mv-pr"> <p class="mv-pr__big" data-w="Impact" aria-hidden="true">{{ s.t6 | escape }}</p> <div class="mv-pr__txt"><h3>{{ s.t7 | escape }}</h3><p class="mv-muted">{{ s.t8 | escape }}</p></div> </li> <li class="mv-pr"> <p class="mv-pr__big" data-w="Waarde" aria-hidden="true">{{ s.t9 | escape }}</p> <div class="mv-pr__txt"><h3>{{ s.t10 | escape }}</h3><p class="mv-muted">{{ s.t11 | escape }}</p></div> </li> <li class="mv-pr"> <p class="mv-pr__big" data-w="Team" aria-hidden="true">{{ s.t12 | escape }}</p> <div class="mv-pr__txt"><h3>{{ s.t13 | escape }}</h3><p class="mv-muted">{{ s.t14 | escape }}</p></div> </li> </ol> </div> </section>
</div>
