{{ 'mv-page.css' | asset_url | stylesheet_tag }}
<script src="{{ 'mv-page.js' | asset_url }}" defer></script>
{%- assign s = section.settings -%}
<div class="mv">
<script>document.currentScript.parentNode.classList.add("mv-js");window.MV_ASSETS=window.MV_ASSETS||{};MV_ASSETS['academy-tvb-open.jpg']={{ 'mv-academy-tvb-open.jpg' | asset_url | json }};MV_ASSETS['hardlopen-gripsokken.jpg']={{ 'mv-hardlopen-gripsokken.jpg' | asset_url | json }};MV_ASSETS['voetbal-gripsokken-wit.jpg']={{ 'mv-voetbal-gripsokken-wit.jpg' | asset_url | json }};</script>
<section class="mv-band-light mv-pad{%- if s.custom_pad %} mv-custom-pad{% endif -%}" data-ab="panels" aria-labelledby="amb-title" style="{%- if s.bg_color != blank -%}background:{{ s.bg_color }};{%- endif -%}{%- if s.text_color != blank -%}color:{{ s.text_color }};{%- endif -%}--mv-pt:{{ s.padding_top }}px;--mv-pb:{{ s.padding_bottom }}px;--mv-pt-m:{{ s.padding_top_mobile }}px;--mv-pb-m:{{ s.padding_bottom_mobile }}px;--mv-len:{{ s.scroll_length }}vh;--mv-len-m:{{ s.scroll_length_mobile }}vh;" data-ta="{{ s.text_align }}" data-ta-m="{{ s.text_align_m }}" data-w="{{ s.section_width }}" data-anim="{{ s.animate }}"> <div class="mv-wrap"> <div class="mv-mv__head"> <h2 class="mv-h2 mv-rv" id="amb-title">{{ s.t1 }}</h2> <p class="mv-lead mv-rv" style="--d:.12s">{{ s.t2 | escape }}</p> </div> <div class="mv-panels mv-rv"> {%- for block in section.blocks -%}{%- if block.type == 'b1' -%}{%- assign b = block.settings -%}<article class="mv-panel{% if b.mod1 %} mv-is-open{% endif %}" tabindex="0" {{ block.shopify_attributes }}> <h3>{{ b.t1 | escape }}</h3> <p class="mv-txt">{{ b.t2 | escape }}</p> </article>{%- endif -%}{%- endfor -%}    </div> </div> </section>
</div>
{% schema %}
{
  "name": "Visie: Ambities",
  "settings": [
    {
      "type": "inline_richtext",
      "id": "t1",
      "label": "H2 · Welke ambities heeft HÏ Grip?",
      "default": "Welke ambities heeft <em>HÏ Grip?</em>"
    },
    {
      "type": "textarea",
      "id": "t2",
      "label": "P · HÏ Grip heeft vier ambities die de visie de komende jaren conc",
      "default": "HÏ Grip heeft vier ambities die de visie de komende jaren concreet maken en laten zien hoe het merk wil groeien: als community voor sporters, als partner van het onderwijs, als assortiment voor clubs en retail, en als innovator met een eigen R&D-team."
    },
    {
      "type": "header",
      "content": "Opmaak"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Achtergrondkleur"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Tekstkleur"
    },
    {
      "type": "select",
      "id": "text_align",
      "label": "Tekst uitlijnen (desktop)",
      "options": [
        {
          "value": "",
          "label": "Standaard"
        },
        {
          "value": "left",
          "label": "Links"
        },
        {
          "value": "center",
          "label": "Gecentreerd"
        },
        {
          "value": "right",
          "label": "Rechts"
        }
      ],
      "default": ""
    },
    {
      "type": "select",
      "id": "text_align_m",
      "label": "Tekst uitlijnen (mobiel)",
      "options": [
        {
          "value": "",
          "label": "Standaard"
        },
        {
          "value": "left",
          "label": "Links"
        },
        {
          "value": "center",
          "label": "Gecentreerd"
        },
        {
          "value": "right",
          "label": "Rechts"
        }
      ],
      "default": ""
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Breedte",
      "options": [
        {
          "value": "",
          "label": "Pagina"
        },
        {
          "value": "full",
          "label": "Volledig"
        }
      ],
      "default": ""
    },
    {
      "type": "checkbox",
      "id": "custom_pad",
      "label": "Eigen padding gebruiken",
      "default": false
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding boven",
      "min": 0,
      "max": 240,
      "step": 4,
      "unit": "px",
      "default": 96
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding onder",
      "min": 0,
      "max": 240,
      "step": 4,
      "unit": "px",
      "default": 96
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Padding boven (mobiel)",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 52
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Padding onder (mobiel)",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 52
    },
    {
      "type": "checkbox",
      "id": "animate",
      "label": "Animaties aan",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "b1",
      "name": "1. panel",
      "settings": [
        {
          "type": "text",
          "id": "t1",
          "label": "H3 · Performance Academy",
          "default": "Performance Academy"
        },
        {
          "type": "text",
          "id": "t2",
          "label": "P · Eigen HÏ Grip-sportevents, meebeslissen over nieuwe producten ",
          "default": "Eigen HÏ Grip-sportevents, meebeslissen over nieuwe producten en toegang tot ons educatieve sportplatform met workouts en tips."
        },
        {
          "type": "checkbox",
          "id": "mod1",
          "label": "Variant: is-open",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Visie: Ambities"
    }
  ]
}
{% endschema %}
