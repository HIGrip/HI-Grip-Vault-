{{ 'mv-page.css' | asset_url | stylesheet_tag }}
<script src="{{ 'mv-page.js' | asset_url }}" defer></script>
{%- assign s = section.settings -%}
<div class="mv">
<script>document.currentScript.parentNode.classList.add("mv-js");window.MV_ASSETS=window.MV_ASSETS||{};MV_ASSETS['academy-tvb-open.jpg']={{ 'mv-academy-tvb-open.jpg' | asset_url | json }};MV_ASSETS['hardlopen-gripsokken.jpg']={{ 'mv-hardlopen-gripsokken.jpg' | asset_url | json }};MV_ASSETS['voetbal-gripsokken-wit.jpg']={{ 'mv-voetbal-gripsokken-wit.jpg' | asset_url | json }};</script>
<section class="mv-band-black mv-pad{%- if s.custom_pad %} mv-custom-pad{% endif -%}" data-ab="outro" aria-label="Afsluiting" style="{%- if s.bg_color != blank -%}background:{{ s.bg_color }};{%- endif -%}{%- if s.text_color != blank -%}color:{{ s.text_color }};{%- endif -%}--mv-pt:{{ s.padding_top }}px;--mv-pb:{{ s.padding_bottom }}px;--mv-pt-m:{{ s.padding_top_mobile }}px;--mv-pb-m:{{ s.padding_bottom_mobile }}px;--mv-len:{{ s.scroll_length }}vh;--mv-len-m:{{ s.scroll_length_mobile }}vh;" data-ta="{{ s.text_align }}" data-ta-m="{{ s.text_align_m }}" data-w="{{ s.section_width }}" data-anim="{{ s.animate }}"> <div class="mv-wrap"> <p class="mv-out__text" data-words>{{ s.t1 }}</p> <div class="mv-out__row mv-rv"> <p>{{ s.t2 | escape }} <a class="mv-textlink" href="{{ s.url3 | default: 'https://www.higrip.nl/pages/over-ons' }}">{{ s.t4 | escape }}</a>.</p> <a class="mv-pill mv-pill--light" href="{{ s.url5 | default: 'https://www.higrip.nl/pages/onze-missie' }}">{{ s.t6 | escape }}</a> </div> </div> </section>
</div>
{% schema %}
{
  "name": "Visie: Afsluiting",
  "settings": [
    {
      "type": "inline_richtext",
      "id": "t1",
      "label": "P · Wie alles geeft, wordt zelf de grens.",
      "default": "Wie alles geeft, wordt zelf de <em>grens.</em>"
    },
    {
      "type": "text",
      "id": "t2",
      "label": "P · De visie is waar we naartoe gaan. Waar het vandaag begint, lee",
      "default": "De visie is waar we naartoe gaan. Waar het vandaag begint, lees je in de missie. Benieuwd wie erachter zitten? Maak kennis met"
    },
    {
      "type": "url",
      "id": "url3",
      "label": "Link · de founders van HÏ Grip op Over ons"
    },
    {
      "type": "text",
      "id": "t4",
      "label": "A · de founders van HÏ Grip op Over ons",
      "default": "de founders van HÏ Grip op Over ons"
    },
    {
      "type": "url",
      "id": "url5",
      "label": "Link · Lees de missie"
    },
    {
      "type": "text",
      "id": "t6",
      "label": "A · Lees de missie",
      "default": "Lees de missie"
    },
    {
      "type": "header",
      "content": "Opmaak"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Achtergrondkleur"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Tekstkleur"
    },
    {
      "type": "select",
      "id": "text_align",
      "label": "Tekst uitlijnen (desktop)",
      "options": [
        {
          "value": "",
          "label": "Standaard"
        },
        {
          "value": "left",
          "label": "Links"
        },
        {
          "value": "center",
          "label": "Gecentreerd"
        },
        {
          "value": "right",
          "label": "Rechts"
        }
      ],
      "default": ""
    },
    {
      "type": "select",
      "id": "text_align_m",
      "label": "Tekst uitlijnen (mobiel)",
      "options": [
        {
          "value": "",
          "label": "Standaard"
        },
        {
          "value": "left",
          "label": "Links"
        },
        {
          "value": "center",
          "label": "Gecentreerd"
        },
        {
          "value": "right",
          "label": "Rechts"
        }
      ],
      "default": ""
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Breedte",
      "options": [
        {
          "value": "",
          "label": "Pagina"
        },
        {
          "value": "full",
          "label": "Volledig"
        }
      ],
      "default": ""
    },
    {
      "type": "checkbox",
      "id": "custom_pad",
      "label": "Eigen padding gebruiken",
      "default": false
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding boven",
      "min": 0,
      "max": 240,
      "step": 4,
      "unit": "px",
      "default": 96
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding onder",
      "min": 0,
      "max": 240,
      "step": 4,
      "unit": "px",
      "default": 96
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Padding boven (mobiel)",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 52
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Padding onder (mobiel)",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 52
    },
    {
      "type": "checkbox",
      "id": "animate",
      "label": "Animaties aan",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Visie: Afsluiting"
    }
  ]
}
{% endschema %}
