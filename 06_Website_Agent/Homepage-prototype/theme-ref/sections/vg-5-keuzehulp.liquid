          <div class="res__img"><img data-res-img src="{%- if s.ima60 != blank -%}{{ s.ima60 | image_url: width: 1200 }}{%- else -%}{{ 'vg-sok-10.webp' | asset_url }}{%- endif -%}" width="900" height="900" alt="{{ s.t61 | escape }}"></div>
