          <p class="res__tag" data-res-tag>{{ s.t64 | escape }}</p>
          <ul class="res__why" data-res-why><li>{{ s.t65 | escape }}</li></ul>
          <p class="res__size" data-res-size hidden></p>
          <p class="res__note" data-res-note hidden></p>
          <div class="res__act">
            <a class="btn btn--k" data-res-link href="{{ s.url66 | default: "https://www.higrip.nl/products/performance-gripsokken" }}"><span data-res-cta>{{ s.t67 | escape }}</span> <svg viewbox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7"/></svg></a>
