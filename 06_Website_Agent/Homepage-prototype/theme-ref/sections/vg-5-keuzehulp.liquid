        <fieldset class="q"><legend><span class="q__n" aria-hidden="true">{{ s.t20 | escape }}</span>{{ s.t21 | escape }}</legend><div class="opts"><span class="opt"><input type="radio" name="vaak" id="v0" value="laag" checked><label for="v0">{{ s.t22 | escape }}</label></span><span class="opt"><input type="radio" name="vaak" id="v1" value="hoog"><label for="v1">{{ s.t23 | escape }}</label></span></div></fieldset>
