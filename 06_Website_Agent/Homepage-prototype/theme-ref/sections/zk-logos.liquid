{{ 'hg-zakelijk.css' | asset_url | stylesheet_tag }}
{{ 'hg-zakelijk-v2.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign s = section.settings
  assign cls = 'zk zk--light zk-logobar'
  if s.grayscale
    assign cls = cls | append: ' zk-logobar--grey'
  endif
  if s.rule_top
    assign cls = cls | append: ' zk-logobar--rule-top'
  endif
  if s.rule_bottom
    assign cls = cls | append: ' zk-logobar--rule-bottom'
  endif
-%}
<section class="{{ cls }}" id="{{ s.anchor | default: 'vertrouwd' }}" aria-label="{{ s.aria_label | escape }}" style="{% render 'zk-vars', s: s %}--z-cols:{{ s.columns }};--z-cols-m:{{ s.columns_mobile }};--z-logo-h:{{ s.logo_height }}px;--z-logo-h-m:{{ s.logo_height_mobile }}px;--z-gap:{{ s.gap }}px;" {{ section.shopify_attributes }}>
  <div class="zk__wrap">
    <ul class="zk-logobar__row">
      {%- for block in section.blocks -%}
        {%- assign b = block.settings -%}
        <li {{ block.shopify_attributes }}>
          {%- if b.image != blank -%}
            {%- assign alt = b.alt | default: b.image.alt -%}
            {%- if b.link != blank -%}<a href="{{ b.link }}"{% if b.new_tab %} target="_blank" rel="noopener"{% endif %}>{%- endif -%}
            {{- b.image | image_url: width: 320 | image_tag: loading: 'lazy', widths: '160, 320', sizes: '160px', alt: alt -}}
            {%- if b.link != blank -%}</a>{%- endif -%}
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Zakelijk: Logostrook",
  "settings": [
    { "type": "text", "id": "anchor", "label": "Anker (voor de navigatiebalk)", "default": "vertrouwd" },
    { "type": "text", "id": "aria_label", "label": "Toegankelijke naam (niet zichtbaar)", "default": "Vertrouwd door" },
    { "type": "header", "content": "Logo's" },
    { "type": "checkbox", "id": "grayscale", "label": "Logo's in grijstinten (kleur bij hover)", "default": false },
    { "type": "range", "id": "logo_height", "label": "Logohoogte (desktop)", "min": 32, "max": 160, "step": 4, "unit": "px", "default": 80 },
    { "type": "range", "id": "logo_height_mobile", "label": "Logohoogte (mobiel)", "min": 24, "max": 120, "step": 4, "unit": "px", "default": 56 },
    { "type": "range", "id": "columns", "label": "Logo's per rij (desktop)", "min": 2, "max": 8, "step": 1, "default": 4 },
    { "type": "range", "id": "columns_mobile", "label": "Logo's per rij (mobiel)", "min": 1, "max": 4, "step": 1, "default": 2 },
    { "type": "range", "id": "gap", "label": "Ruimte tussen logo's", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 48 },
    { "type": "header", "content": "Kleuren en ruimte" },
    { "type": "color", "id": "bg_color", "label": "Achtergrondkleur", "default": "#ffffff" },
    { "type": "color", "id": "text_color", "label": "Kleur lijnen", "default": "#000000" },
    { "type": "checkbox", "id": "rule_top", "label": "Lijn boven", "default": false },
    { "type": "checkbox", "id": "rule_bottom", "label": "Lijn onder", "default": true },
    { "type": "range", "id": "padding_top", "label": "Ruimte boven (desktop)", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 44 },
    { "type": "range", "id": "padding_bottom", "label": "Ruimte onder (desktop)", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 44 },
    { "type": "range", "id": "padding_top_mobile", "label": "Ruimte boven (mobiel)", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 28 },
    { "type": "range", "id": "padding_bottom_mobile", "label": "Ruimte onder (mobiel)", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 28 }
  ],
  "blocks": [
    {
      "type": "logo",
      "name": "Logo",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Logo" },
        { "type": "text", "id": "alt", "label": "Naam (alt-tekst, leeg = alt van de afbeelding)" },
        { "type": "url", "id": "link", "label": "Link (optioneel)" },
        { "type": "checkbox", "id": "new_tab", "label": "Link in nieuw tabblad", "default": false }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [ { "name": "Zakelijk: Logostrook" } ]
}
{% endschema %}
