                  "blocks": {
                    "text_XzYErU": {
                      "type": "text",
                      "settings": {
                        "text": "<p>Ontdek <a href=\"/pages/ontdek-jouw-sport\" title=\"Ontdek jouw sport\">hier</a> waarom gripsokken ook voor jouw sport de beste keuze zijn. Meer stabiliteit & controle zodat je sneller bent dan je tegenstanders.</p>",
                        "width": "100%",
                        "max_width": "normal",
