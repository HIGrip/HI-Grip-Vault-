              "settings": {
                "custom_liquid": "{%- if request.locale.iso_code == 'en' -%}\n<div class=\"hi-social-strip\">\n  <span class=\"hi-social-strip__stars\" aria-hidden=\"true\">★★★★½</span>\n  <span class=\"hi-social-strip__dot\">·</span>\n  <span class=\"hi-social-strip__count\">3,500+ athletes went before you</span>\n  <span class=\"hi-social-strip__dot\">·</span>\n  <span class=\"hi-social-strip__claim\">\"More grip. More control. More wins.\"</span>\n</div>\n{%- else -%}\n<div class=\"hi-social-strip\">\n  <span class=\"hi-social-strip__stars\" aria-hidden=\"true\">★★★★½</span>\n  <span class=\"hi-social-strip__dot\">·</span>\n  <span class=\"hi-social-strip__count\">3.500+ sporters gingen je voor</span>\n  <span class=\"hi-social-strip__dot\">·</span>\n  <span class=\"hi-social-strip__claim\">\"Meer grip. Meer controle. Meer winnen.\"</span>\n</div>\n{%- endif -%}"
