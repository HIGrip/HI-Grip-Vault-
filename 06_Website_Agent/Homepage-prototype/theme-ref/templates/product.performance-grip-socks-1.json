              },
              "blocks": {
                "text_eNHepE": {
                  "type": "text",
                  "name": "t:names.heading",
                  "settings": {
                    "text": "<h2><strong>Gripsokken</strong></h2>",
                    "width": "100%",
                    "max_width": "normal",
                    "alignment": "left",
                    "type_preset": "h4",
                    "font": "var(--font-body--family)",
                    "font_size": "1rem",
                    "line_height": "normal",
