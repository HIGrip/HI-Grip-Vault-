              "type": "custom-liquid",
              "name": "2.0 spec-strip",
              "disabled": true,
              "settings": {
                "custom_liquid": "{%- if request.locale.iso_code == 'en' -%}\n<div class=\"hi-g2-specs\">\n  <p class=\"hi-g2-specs__title\">New in the 2.0</p>\n  <dl class=\"hi-g2-specs__grid\">\n    <div class=\"hi-g2-spec\"><dt>Compression</dt><dd>15–20 mmHg</dd></div>\n    <div class=\"hi-g2-spec\"><dt>Construction</dt><dd>Seamless</dd></div>\n    <div class=\"hi-g2-spec\"><dt>Moisture control</dt><dd>Coolmax®</dd></div>\n    <div class=\"hi-g2-spec\"><dt>Sizing</dt><dd>3 sizes, 35–47</dd></div>\n  </dl>\n  <a class=\"hi-g2-specs__link\" href=\"#anatomie\">View all seven zones</a>\n</div>\n{%- else -%}\n<div class=\"hi-g2-specs\">\n  <p class=\"hi-g2-specs__title\">Nieuw in de 2.0</p>\n  <dl class=\"hi-g2-specs__grid\">\n    <div class=\"hi-g2-spec\"><dt>Compressie</dt><dd>15–20 mmHg</dd></div>\n    <div class=\"hi-g2-spec\"><dt>Constructie</dt><dd>Naadloos</dd></div>\n    <div class=\"hi-g2-spec\"><dt>Vochtregulatie</dt><dd>Coolmax®</dd></div>\n    <div class=\"hi-g2-spec\"><dt>Maatvoering</dt><dd>3 maten, 35–47</dd></div>\n  </dl>\n  <a class=\"hi-g2-specs__link\" href=\"#anatomie\">Bekijk alle zeven zones</a>\n</div>\n{%- endif -%}"
