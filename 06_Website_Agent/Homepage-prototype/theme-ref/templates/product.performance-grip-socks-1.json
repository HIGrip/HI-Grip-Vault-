              "type": "custom-liquid",
              "name": "t:names.custom_liquid",
              "disabled": true,
              "settings": {
                "custom_liquid": "{%- if request.locale.iso_code == 'en' -%}\n<ul class=\"hi-g2-usp\">\n  <li><strong>Seamless knit:</strong> no stitching, so no friction against your skin.</li>\n  <li><strong>15–20 mmHg compression:</strong> supports your circulation during exercise.</li>\n  <li><strong>Coolmax®:</strong> wicks moisture away instantly, for dry feet right up to the final minutes.</li>\n  <li><strong>Ordered? Shipped within 1 business day</strong></li>\n</ul>\n{%- else -%}\n<ul class=\"hi-g2-usp\">\n  <li><strong>Naadloos gebreid:</strong> geen stiksels, dus geen wrijving tegen je huid.</li>\n  <li><strong>15–20 mmHg compressie:</strong> ondersteunt je doorbloeding tijdens inspanning.</li>\n  <li><strong>Coolmax®:</strong> voert vocht direct af, voor droge voeten tot het laatste kwartier.</li>\n  <li><strong>Besteld? Binnen 1 werkdag verzonden</strong></li>\n</ul>\n{%- endif -%}"
