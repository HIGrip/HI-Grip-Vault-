{%- doc -%}
  Actiestrook voor de ad-landingspagina's (zoals het Performance Days-dealblok op de productpagina).
  Verdwijnt vanzelf na de eindtijd: in Liquid bij het renderen en in hi-adl.js voor pagina's uit de cache.
  De aftelling vult assets/hg-pd-timer.js via [data-pd-cd].

  @param {string} end - eindtijd, bijv. '2026-11-30 23:59'
  @param {string} badge - bijv. 'x2'
  @param {string} title - bijv. 'Verdubbel je order'
  @param {string} text - regel onder de titel; [timer] wordt de aftelling
  @param {string} [extra] - extra regel, bijv. de prijs per paar
  @param {string} [modifier] - 'light' voor een lichte achtergrond

  @example
  {% render 'hi-adl-deal', end: s.deal_end, badge: 'x2', title: 'Verdubbel je order', text: 'Eindigt over [timer]' %}
{%- enddoc -%}
{%- liquid
  assign deal_now = 'now' | date: '%s' | plus: 0
  assign deal_end = end | date: '%s' | plus: 0
  if end == blank or deal_now >= deal_end
    break
  endif
  assign deal_end_ms = deal_end | times: 1000
-%}
<div class="adl-deal{% if modifier != blank %} adl-deal--{{ modifier }}{% endif %}" data-deal-end="{{ deal_end_ms }}">
  <span class="adl-deal__x">{{ badge }}</span>
  <div class="adl-deal__t">
    <b>{{ title }}</b>
    <span>{{ text | replace: '[timer]', '<b class="adl-deal__cd" data-pd-cd>--</b>' }}</span>
    {%- if extra != blank -%}
      <span class="adl-deal__extra">{{ extra }}</span>
    {%- endif -%}
  </div>
</div>
