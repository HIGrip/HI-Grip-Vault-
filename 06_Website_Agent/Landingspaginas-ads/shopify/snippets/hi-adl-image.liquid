{%- doc -%}
  Responsieve afbeelding voor de ad-landingspagina's. Rendert niets als er geen afbeelding is gekozen.

  @param {object} image - afbeelding uit een image_picker
  @param {string} [sizes] - sizes-attribuut
  @param {string} [alt] - alt-tekst; standaard de alt uit Bestanden
  @param {boolean} [eager] - true voor het eerste beeld boven de vouw
  @param {number} [width] - maximale breedte in px, standaard 1600

  @example
  {% render 'hi-adl-image', image: block.settings.image, sizes: '100vw' %}
{%- enddoc -%}
{%- liquid
  if image == blank
    break
  endif
  assign max_width = width | default: 1600
  assign image_alt = alt | default: image.alt | escape
  assign image_sizes = sizes | default: '100vw'
  if eager
    assign loading = 'eager'
    assign priority = 'high'
  else
    assign loading = 'lazy'
    assign priority = 'auto'
  endif
-%}
{{ image | image_url: width: max_width | image_tag: widths: '240, 480, 720, 960, 1200, 1600', sizes: image_sizes, alt: image_alt, loading: loading, fetchpriority: priority }}
