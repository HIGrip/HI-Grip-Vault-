{% comment %}
  Section contract.
  HÏ homepage 01 · Hero: schermvullende foto met eigen kopbalk (logo, menu), kop, subregel, definitiezin en knop.
  Motion: kop schuift in, foto ademt en zoomt bij scrollen (hp-home.js, sectie 01). Alles is instelbaar in de editor.
  @example
  <!-- Homepage > HÏ 01 · Hero -->
{% endcomment %}
{%- liquid
  assign s = section.settings
  assign tag = s.heading_tag | default: 'h1'
-%}
{%- render 'hp-base' -%}
{%- assign hp_a_scrim_t = s.scrim_t_a | divided_by: 100.0 -%}
{%- assign hp_a_scrim_b = s.scrim_b_a | divided_by: 100.0 -%}
<style>
#shopify-section-{{ section.id }} {--hp-01-logo-h: {{ s.logo_h }}px; --hp-01-menu-bg: {{ s.menu_bg }}; --hp-01-menu-fg: {{ s.menu_fg }}; --hp-01-scrim-t: {{ s.scrim_t | color_modify: 'alpha', hp_a_scrim_t }}; --hp-01-scrim-b: {{ s.scrim_b | color_modify: 'alpha', hp_a_scrim_b }}; --hp-01-h1-c: {{ s.h1_c }}; --hp-01-sub-c: {{ s.sub_c }}; --hp-01-def-c: {{ s.def_c }}; --hp-01-def-o: calc({{ s.def_o }} / 100); --hp-01-bg: {{ s.bg }}; --hp-01-fg: {{ s.fg }}; --hp-01-h: {{ s.h_svh }}svh; --hp-01-maxh: {{ s.maxh }}px; --hp-btn-bg: {{ s.btn_bg }}; --hp-btn-fg: {{ s.btn_fg }}; --hp-btn-cbg: {{ s.btn_cbg }}; --hp-btn-cfg: {{ s.btn_cfg }}; --hp-btn-bd: {{ s.btn_bd }}; --hp-btn-bw: {{ s.btn_bw }}px; --hp-btn-r: {{ s.btn_r }}px; --hp-btn-hbg: {{ s.btn_hbg }}; --hp-btn-hfg: {{ s.btn_hfg }}; --hp-btn-hbd: {{ s.btn_hbd }}; --hp-btn-hcbg: {{ s.btn_hcbg }}; --hp-btn-hcfg: {{ s.btn_hcfg }};}
@media (max-width: 768px) { #shopify-section-{{ section.id }} {--hp-01-logo-k: {{ s.logo_m | times: 1.0 | divided_by: 22 }}; --hp-01-nav-k: {{ s.nav_m | times: 1.0 | divided_by: 13 }}; --hp-01-px: {{ s.pos_m_x }}%; --hp-01-py: {{ s.pos_m_y }}%; --hp-01-h1-k: {{ s.h1_m | times: 1.0 | divided_by: 41 }}; --hp-01-h1-mw: {{ s.h1_mw_m }}ch; --hp-01-sub-k: {{ s.sub_m | times: 1.0 | divided_by: 15 }}; --hp-01-def-k: {{ s.def_m | times: 1.0 | divided_by: 13 }}; --hp-01-minh: {{ s.minh_m }}px; --hp-01-spb-k: {{ s.stage_pb_m | times: 1.0 | divided_by: 32 }}; --hp-01-spb-add: 0px; --hp-btn-k: {{ s.btn_m | times: 1.0 | divided_by: 14 }};} }
@media (min-width: 769px) { #shopify-section-{{ section.id }} {--hp-01-logo-k: {{ s.logo_d | times: 1.0 | divided_by: 26 }}; --hp-01-nav-k: {{ s.nav_d | times: 1.0 | divided_by: 13 }}; --hp-01-px: {{ s.pos_d_x }}%; --hp-01-py: {{ s.pos_d_y }}%; --hp-01-h1-k: {{ s.h1_d | times: 1.0 | divided_by: 74 }}; --hp-01-h1-mw: {{ s.h1_mw_d }}ch; --hp-01-sub-k: {{ s.sub_d | times: 1.0 | divided_by: 19 }}; --hp-01-def-k: {{ s.def_d | times: 1.0 | divided_by: 14 }}; --hp-01-minh: {{ s.minh_d }}px; --hp-01-spb-k: {{ s.stage_pb_d | times: 1.0 | divided_by: 64 }}; --hp-01-spb-add: 0px; --hp-btn-k: {{ s.btn_d | times: 1.0 | divided_by: 14 }};} }
{%- if s.align == 'center' -%}#shopify-section-{{ section.id }} .hp-01-copy { justify-items: center; text-align: center; } #shopify-section-{{ section.id }} .hp-01-h1, #shopify-section-{{ section.id }} .hp-01-sub, #shopify-section-{{ section.id }} .hp-01-def { margin-inline: auto; } @media (min-width: 769px) { #shopify-section-{{ section.id }} .hp-01-copy { grid-template-columns: minmax(0, 1fr); } #shopify-section-{{ section.id }} .hp-01-cta { grid-column: 1; grid-row: auto; justify-self: center; margin-top: var(--hp-space-xs); } }{%- endif -%}
{%- unless s.anim_rise -%}#shopify-section-{{ section.id }} .hp-01-h1, #shopify-section-{{ section.id }} .hp-01-sub, #shopify-section-{{ section.id }} .hp-01-cta { animation: none !important; }{%- endunless -%}
{%- unless s.anim_breathe -%}#shopify-section-{{ section.id }} .hp-01-media__el { animation: none !important; }{%- endunless -%}
</style>
{%- if s.hide_theme_header -%}
  <style>#header-group { display: none; }</style>
{%- endif -%}
<section class="hp-section hp-section--flush hp-01" data-hp="01" aria-labelledby="hp-01-h1-{{ section.id }}"{% unless s.anim_breathe %} data-hp-01-breathe="off"{% endunless %}{% unless s.anim_zoom %} data-hp-01-zoom="off"{% endunless %}>
  {%- if s.show_bar -%}
  <header class="hp-container hp-01-bar">
    <a class="hp-01-logo" href="{{ s.logo_link | default: routes.root_url }}" aria-label="{{ s.logo_label | escape }}">
      {%- if s.logo_image != blank -%}
        {%- render 'hp-img', image: s.logo_image, class: 'hp-01-logo__img', sizes: '200px', widths: '200,400', alt: s.logo_text, loading: 'eager' -%}
      {%- else -%}
        {{- s.logo_text -}}
      {%- endif -%}
    </a>
    <nav class="hp-01-nav" id="hp-01-nav-{{ section.id }}" aria-label="{{ s.nav_label | escape }}">
      {%- for block in section.blocks -%}
        <a href="{{ block.settings.link }}" {{ block.shopify_attributes }}>{{ block.settings.label }}</a>
      {%- endfor -%}
    </nav>
    <button class="hp-01-menu" type="button" aria-expanded="false" aria-controls="hp-01-nav-{{ section.id }}" data-label-open="{{ s.menu_open | escape }}" data-label-close="{{ s.menu_close | escape }}">
      <span class="hp-01-menu__label">{{ s.menu_open }}</span>
      <span class="hp-01-menu__icon" aria-hidden="true"></span>
    </button>
  </header>
  {%- endif -%}

  <div class="hp-01-media" data-hp-01-media>
    {%- if s.image_mobile != blank -%}
      <picture>
        <source media="(max-width: 768px)" srcset="{{ s.image_mobile | image_url: width: 900 }} 900w, {{ s.image_mobile | image_url: width: 1400 }} 1400w" sizes="100vw">
        {%- render 'hp-img', image: s.image, class: 'hp-01-media__el', sizes: '100vw', alt: s.image_alt, priority: true -%}
      </picture>
    {%- else -%}
      {%- render 'hp-img', image: s.image, class: 'hp-01-media__el', sizes: '100vw', alt: s.image_alt, priority: true -%}
    {%- endif -%}
  </div>

  <div class="hp-container hp-01-stage">
    <div class="hp-01-copy">
      {%- if s.heading != blank -%}<{{ tag }} class="hp-01-h1" id="hp-01-h1-{{ section.id }}">{{ s.heading }}</{{ tag }}>{%- endif -%}
      {%- if s.sub != blank -%}<p class="hp-01-sub">{{ s.sub }}</p>{%- endif -%}
      {%- if s.def != blank -%}<p class="hp-01-def">{{ s.def }}</p>{%- endif -%}
      {%- if s.cta_label != blank -%}
        <a class="hp-pill hp-pill--light hp-01-cta" href="{{ s.cta_link }}">{{ s.cta_label }}<span class="hp-pill__chev" aria-hidden="true"><svg viewBox="0 0 14 14"><path d="M5 2.5 9.5 7 5 11.5" fill="none" stroke="currentColor" stroke-width="2"/></svg></span></a>
      {%- endif -%}
    </div>
  </div>
</section>
{% schema %}
