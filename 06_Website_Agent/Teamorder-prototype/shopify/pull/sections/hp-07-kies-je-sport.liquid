    },
    {
      "type": "range",
      "id": "h2_m",
      "label": "Kop grootte (mobiel)",
      "min": 9,
      "max": 109,
      "step": 1,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "h2_d",
      "label": "Kop grootte (laptop)",
      "min": 18,
      "max": 218,
      "step": 2,
      "unit": "px",
      "default": 64
    },
    {
      "type": "color",
      "id": "h2_c",
