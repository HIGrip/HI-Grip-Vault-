{% comment %}
  Section contract.
  HÏ homepage 07 · Kies je sport: kop met intro, een sleepbare rij sportkaarten (blokken) als lus met de actieve kaart
  in het midden, kantelende buren, snelheidsstrepen in de sportkleur en een kiezer met segmenten.
  @example
  <!-- Homepage > HÏ 07 · Kies je sport -->
{% endcomment %}
{%- liquid
  assign s = section.settings
  assign tag = s.heading_tag | default: 'h2'
  assign first = section.blocks | first
  assign first_slug = first.settings.name | handleize
-%}
{%- render 'hp-base' -%}
<style>
#shopify-section-{{ section.id }} {--hp-07-h2_c: {{ s.h2_c }}; --hp-07-lead_c: {{ s.lead_c }}; --hp-07-name_c: {{ s.name_c }}; --hp-07-line_c: {{ s.line_c }}; --hp-07-arrow_c: {{ s.arrow_c }}; --hp-07-bg: {{ s.bg }}; --hp-07-fg: {{ s.fg }}; --hp-btn-bg: {{ s.btn_bg }}; --hp-btn-fg: {{ s.btn_fg }}; --hp-btn-cbg: {{ s.btn_cbg }}; --hp-btn-cfg: {{ s.btn_cfg }}; --hp-btn-bd: {{ s.btn_bd }}; --hp-btn-bw: {{ s.btn_bw }}px; --hp-btn-r: {{ s.btn_r }}px; --hp-btn-hbg: {{ s.btn_hbg }}; --hp-btn-hfg: {{ s.btn_hfg }}; --hp-btn-hbd: {{ s.btn_hbd }}; --hp-btn-hcbg: {{ s.btn_hcbg }}; --hp-btn-hcfg: {{ s.btn_hcfg }};}
@media (max-width: 768px) { #shopify-section-{{ section.id }} {--hp-h2-k: {{ s.h2_m | times: 1.0 | divided_by: 32 }}; --hp-lead-k: {{ s.lead_m | times: 1.0 | divided_by: 17 }}; --hp-07-name-k: {{ s.name_m | times: 1.0 | divided_by: 33 }}; --hp-07-line-k: {{ s.line_m | times: 1.0 | divided_by: 15 }}; --hp-07-r-k: {{ s.img_r_m | times: 1.0 | divided_by: 16 }}; --hp-07-gap-set: {{ s.gap_m }}px; --hp-07-seg-k: {{ s.seg_m | times: 1.0 | divided_by: 15 }}; --hp-pt-k: {{ s.pt_m | times: 1.0 | divided_by: 44 }}; --hp-pt-add: 0px; --hp-pb-k: {{ s.pb_m | times: 1.0 | divided_by: 44 }}; --hp-pb-add: 0px; --hp-btn-k: {{ s.btn_m | times: 1.0 | divided_by: 12 }};} }
@media (min-width: 769px) { #shopify-section-{{ section.id }} {--hp-h2-k: {{ s.h2_d | times: 1.0 | divided_by: 64 }}; --hp-lead-k: {{ s.lead_d | times: 1.0 | divided_by: 19 }}; --hp-07-name-k: {{ s.name_d | times: 1.0 | divided_by: 66 }}; --hp-07-line-k: {{ s.line_d | times: 1.0 | divided_by: 19 }}; --hp-07-r-k: {{ s.img_r_d | times: 1.0 | divided_by: 26 }}; --hp-07-gap-set: {{ s.gap_d }}px; --hp-07-seg-k: {{ s.seg_d | times: 1.0 | divided_by: 18 }}; --hp-pt-k: {{ s.pt_d | times: 1.0 | divided_by: 72 }}; --hp-pt-add: 0px; --hp-pb-k: {{ s.pb_d | times: 1.0 | divided_by: 72 }}; --hp-pb-add: 0px; --hp-btn-k: {{ s.btn_d | times: 1.0 | divided_by: 14 }};} }
{%- if s.head_layout == 'stack' -%}@media (min-width: 769px) { #shopify-section-{{ section.id }} .hp-07-head { grid-template-columns: minmax(0, 1fr); } #shopify-section-{{ section.id }} .hp-07-head .hp-lead { justify-self: start; } }{%- endif -%}{%- if s.head_layout == 'center' -%}#shopify-section-{{ section.id }} .hp-07-head { justify-items: center; text-align: center; } #shopify-section-{{ section.id }} .hp-07-head > * { margin-inline: auto; } @media (min-width: 769px) { #shopify-section-{{ section.id }} .hp-07-head { grid-template-columns: minmax(0, 1fr); } #shopify-section-{{ section.id }} .hp-07-head .hp-lead { justify-self: center; } }{%- endif -%}
{%- unless s.tilt -%}#shopify-section-{{ section.id }} .hp-07 .hp-07-item.is-before .hp-07-card, #shopify-section-{{ section.id }} .hp-07 .hp-07-item.is-after .hp-07-card { transform: scale(0.9) !important; } #shopify-section-{{ section.id }} .hp-07-item:not(.is-active) .hp-07-img { filter: none !important; }{%- endunless -%}
{%- unless s.streaks -%}#shopify-section-{{ section.id }} .hp-07-streaks { display: none; }{%- endunless -%}
</style>
<section class="hp-section hp-07" data-hp="07"{% if s.anchor != blank %} id="{{ s.anchor }}"{% endif %} data-sport="{{ first_slug }}" style="--hp-07-c: {{ first.settings.color }};" aria-labelledby="hp-07-h2-{{ section.id }}"{% unless s.streaks %} data-hp-07-streaks="off"{% endunless %}>
  <div class="hp-07-wave" aria-hidden="true"><span class="hp-07-hole"></span></div>
  {%- if s.heading != blank or s.lead != blank -%}
    <div class="hp-container hp-head hp-07-head">
      {%- if s.heading != blank -%}<{{ tag }} class="hp-h2 hp-07-h2" id="hp-07-h2-{{ section.id }}">{{ s.heading }}</{{ tag }}>{%- endif -%}
      {%- if s.lead != blank -%}<p class="hp-lead hp-07-lead">{{ s.lead }}</p>{%- endif -%}
    </div>
  {%- endif -%}

  <div class="hp-07-viewport" role="group" aria-label="{{ s.row_label | escape }}">
    <div class="hp-07-streaks" aria-hidden="true"><span style="--y:1.6%;--h:3px;--w:340px;--d:0.0"></span><span style="--y:4.4%;--h:6px;--w:520px;--d:0.9"></span><span style="--y:16%;--h:3px;--w:260px;--d:1.8"></span><span style="--y:34%;--h:8px;--w:460px;--d:0.45"></span><span style="--y:55%;--h:3px;--w:300px;--d:1.35"></span><span style="--y:72%;--h:5px;--w:420px;--d:0.7"></span></div>
    <ul class="hp-07-track">
      {%- for block in section.blocks -%}
        {%- liquid
          assign b = block.settings
          assign slug = b.name | handleize
          assign zm = b.zoom_m | divided_by: 100.0
          assign zd = b.zoom_d | divided_by: 100.0
        -%}
        <li class="hp-07-item{% if forloop.first %} is-active{% endif %}" data-sport="{{ slug }}" data-c="{{ b.color }}" style="--hp-07-own: {{ b.color }}; --hp-07-own-ink: {{ b.ink }}; --hp-07-pos: {{ b.pos_x }}% {{ b.pos_y }}%; --hp-07-zm: {{ zm }}; --hp-07-zd: {{ zd }}; --hp-07-om: {{ b.om_x }}% {{ b.om_y }}%; --hp-07-od: {{ b.od_x }}% {{ b.od_y }}%;" {{ block.shopify_attributes }}>
          <a class="hp-07-card" href="{{ b.link }}" aria-label="{{ b.aria | escape }}" aria-describedby="hp-07-line-{{ slug }}-{{ section.id }}" draggable="false"{% unless forloop.first %} tabindex="-1"{% endunless %}>
            <div class="hp-07-frame">
              {%- render 'hp-img', image: b.image, class: 'hp-07-img', sizes: '(min-width: 769px) min(68vw, 1000px), calc(100vw - 64px)', widths: '500,1000,1500,2000', alt: b.alt, attrs: 'draggable="false"' -%}
            </div>
            <div class="hp-07-copy">
              <h3 class="hp-07-name">{{ b.name }}</h3>
              <p class="hp-07-line" id="hp-07-line-{{ slug }}-{{ section.id }}">{{ b.line }}</p>
              <span class="hp-pill hp-pill--light hp-07-go" aria-hidden="true"><span>{{ s.go_label }} <span class="hp-07-go__s">{{ b.name | downcase }}</span></span><span class="hp-pill__chev" aria-hidden="true"><svg viewBox="0 0 14 14"><path d="M5 2.5 9.5 7 5 11.5" fill="none" stroke="currentColor" stroke-width="2"/></svg></span></span>
            </div>
          </a>
        </li>
      {%- endfor -%}
    </ul>
  </div>

  <div class="hp-container hp-07-controls">
    <button class="hp-07-btn hp-07-prev" type="button" aria-label="{{ s.prev_label | escape }}"><svg viewBox="0 0 14 14" aria-hidden="true"><path d="M9 2.5 4.5 7 9 11.5" fill="none" stroke="currentColor" stroke-width="1.8"/></svg></button>
    <div class="hp-07-segs" role="group" aria-label="{{ s.segs_label | escape }}">
      {%- for block in section.blocks -%}
        {%- assign b = block.settings -%}
        <button class="hp-07-seg" type="button" data-i="{{ forloop.index0 }}" data-sport="{{ b.name | handleize }}" aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}" style="--hp-07-own: {{ b.color }}; --hp-07-own-ink: {{ b.ink }};"><span class="hp-07-seg__name">{{ b.name }}</span></button>
      {%- endfor -%}
    </div>
    <button class="hp-07-btn hp-07-next" type="button" aria-label="{{ s.next_label | escape }}"><svg viewBox="0 0 14 14" aria-hidden="true"><path d="M5 2.5 9.5 7 5 11.5" fill="none" stroke="currentColor" stroke-width="1.8"/></svg></button>
  </div>
  <p class="hp-sr hp-07-status" aria-live="polite" data-template="{{ s.status_tpl | escape }}"></p>
</section>
{% schema %}
{
  "name": "HÏ 07 · Kies je sport",
  "tag": "div",
  "class": "hp-shopify-section",
  "settings": [
    {
      "type": "header",
      "content": "Tekst"
    },
    {
      "type": "text",
