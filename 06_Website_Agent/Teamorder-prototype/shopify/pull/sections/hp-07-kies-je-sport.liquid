      "label": "Kop",
      "default": "Kies je sport"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Kopniveau (SEO)",
      "options": [
        {
          "value": "h2",
          "label": "H2"
        },
        {
          "value": "h1",
          "label": "H1"
        },
        {
          "value": "p",
          "label": "Gewone tekst"
        }
      ],
      "default": "h2"
    },
    {
      "type": "textarea",
      "id": "lead",
      "label": "Intro",
      "default": "Elke sport vraagt iets anders van je voet. Kies de jouwe en lees waarom grip daar telt."
    },
    {
      "type": "select",
      "id": "head_layout",
      "label": "Kop en intro: opbouw",
      "options": [
        {
          "value": "split",
          "label": "Naast elkaar (laptop)"
        },
        {
          "value": "stack",
          "label": "Onder elkaar"
        },
        {
          "value": "center",
          "label": "Gecentreerd"
