{% comment %}
  Section contract.
  HÏ homepage 14 · Teamorders: tweekleurige kop, een bento met links een grote foto met intro en knop en rechts
  blokken met een sportfoto, nummer, titel en regel (blokken). Motion: foto schuift licht mee, blokken rijzen op.
  @example
  <!-- Homepage > HÏ 14 · Teamorders -->
{% endcomment %}
{%- liquid
  assign s = section.settings
  assign tag = s.heading_tag | default: 'h2'
-%}
{%- render 'hp-base' -%}
{%- assign hp_a_grad = s.grad_a | divided_by: 100.0 -%}
<style>
#shopify-section-{{ section.id }} {--hp-14-h2a_c: {{ s.h2a_c }}; --hp-14-h2b_c: {{ s.h2b_c }}; --hp-14-lead_c: {{ s.lead_c }}; --hp-14-py: {{ s.pos_y }}%; --hp-14-minh: {{ s.minh_d }}px; --hp-14-grad: {{ s.grad | color_modify: 'alpha', hp_a_grad }}; --hp-14-blok_bg: {{ s.blok_bg }}; --hp-14-blok_fg: {{ s.blok_fg }}; --hp-14-no_c: {{ s.no_c }}; --hp-14-td-o: calc({{ s.td_o }} / 100); --hp-14-gap: {{ s.gap }}px; --hp-14-bg: {{ s.bg }}; --hp-14-fg: {{ s.fg }}; --hp-btn-bg: {{ s.btn_bg }}; --hp-btn-fg: {{ s.btn_fg }}; --hp-btn-cbg: {{ s.btn_cbg }}; --hp-btn-cfg: {{ s.btn_cfg }}; --hp-btn-bd: {{ s.btn_bd }}; --hp-btn-bw: {{ s.btn_bw }}px; --hp-btn-r: {{ s.btn_r }}px; --hp-btn-hbg: {{ s.btn_hbg }}; --hp-btn-hfg: {{ s.btn_hfg }}; --hp-btn-hbd: {{ s.btn_hbd }}; --hp-btn-hcbg: {{ s.btn_hcbg }}; --hp-btn-hcfg: {{ s.btn_hcfg }};}
@media (max-width: 768px) { #shopify-section-{{ section.id }} {--hp-14-r-k: {{ s.img_r_m | times: 1.0 | divided_by: 16 }}; --hp-pt-k: {{ s.pt_m | times: 1.0 | divided_by: 44 }}; --hp-pt-add: 0px; --hp-pb-k: {{ s.pb_m | times: 1.0 | divided_by: 44 }}; --hp-pb-add: 0px; --hp-btn-k: {{ s.btn_m | times: 1.0 | divided_by: 14 }};} }
@media (min-width: 769px) { #shopify-section-{{ section.id }} {--hp-14-r-k: {{ s.img_r_d | times: 1.0 | divided_by: 26 }}; --hp-pt-k: {{ s.pt_d | times: 1.0 | divided_by: 72 }}; --hp-pt-add: 0px; --hp-pb-k: {{ s.pb_d | times: 1.0 | divided_by: 72 }}; --hp-pb-add: 0px; --hp-btn-k: {{ s.btn_d | times: 1.0 | divided_by: 14 }};} }
@media (max-width: 899px) { #shopify-section-{{ section.id }} {--hp-14-h2-k: {{ s.h2_m | times: 1.0 | divided_by: 37 }}; --hp-14-lead-k: {{ s.lead_m | times: 1.0 | divided_by: 16 }}; --hp-14-no-k: {{ s.no_m | times: 1.0 | divided_by: 24 }}; --hp-14-tt-k: {{ s.tt_m | times: 1.0 | divided_by: 16 }}; --hp-14-td-k: {{ s.td_m | times: 1.0 | divided_by: 14 }};} }
@media (min-width: 900px) { #shopify-section-{{ section.id }} {--hp-14-h2-k: {{ s.h2_d | times: 1.0 | divided_by: 96 }}; --hp-14-lead-k: {{ s.lead_d | times: 1.0 | divided_by: 19 }}; --hp-14-no-k: {{ s.no_d | times: 1.0 | divided_by: 28 }}; --hp-14-tt-k: {{ s.tt_d | times: 1.0 | divided_by: 22 }}; --hp-14-td-k: {{ s.td_d | times: 1.0 | divided_by: 15 }};} }
{%- unless s.rise -%}#shopify-section-{{ section.id }} .hp-14-blok { transform: none !important; }{%- endunless -%}
</style>
<section class="hp-section hp-14" data-hp="14" aria-labelledby="hp-14-h2-{{ section.id }}"{% unless s.parallax %} data-parallax="off"{% endunless %}>
  <div class="hp-container hp-14-inner">
    {%- if s.heading_a != blank or s.heading_b != blank -%}
      <{{ tag }} class="hp-14-h2" id="hp-14-h2-{{ section.id }}"><span class="hp-14-h2__a">{{ s.heading_a }}</span> <span class="hp-14-h2__b">{{ s.heading_b }}</span></{{ tag }}>
    {%- endif -%}

    <div class="hp-14-bento">
      <figure class="hp-14-media">
        {%- render 'hp-img', image: s.image, class: 'hp-14-img', sizes: '(min-width: 900px) 58vw, 100vw', widths: '400,800', alt: s.alt -%}
        <figcaption class="hp-14-cap">
          {%- if s.lead != blank -%}<p class="hp-14-lead">{{ s.lead }}</p>{%- endif -%}
          {%- if s.cta_label != blank -%}
            <a class="hp-pill hp-pill--light hp-14-cta" href="{{ s.cta_link }}">{{ s.cta_label }}<span class="hp-pill__chev" aria-hidden="true"><svg viewBox="0 0 14 14"><path d="M5 2.5 9.5 7 5 11.5" fill="none" stroke="currentColor" stroke-width="2"/></svg></span></a>
          {%- endif -%}
        </figcaption>
      </figure>
      <ol class="hp-14-bloks">
        {%- for block in section.blocks -%}
          {%- assign b = block.settings -%}
          <li class="hp-14-blok" {{ block.shopify_attributes }}>
            {%- capture pos -%}--pos:{{ b.pos_x }}% {{ b.pos_y }}%{%- endcapture -%}
            {%- render 'hp-img', image: b.image, class: 'hp-14-bg', sizes: '(min-width: 900px) 40vw, 100vw', widths: '450,900', decorative: true, style: pos -%}
            <span class="hp-14-no" aria-hidden="true">{{ b.no }}</span>
            <span class="hp-14-itext"><span class="hp-14-tt">{{ b.title }}</span><span class="hp-14-td">{{ b.text }}</span></span>
          </li>
        {%- endfor -%}
      </ol>
    </div>
  </div>
</section>
{% schema %}
{
