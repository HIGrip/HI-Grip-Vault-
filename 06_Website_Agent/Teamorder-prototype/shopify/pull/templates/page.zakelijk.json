    "faq": {
      "type": "zk-faq",
      "blocks": {
        "q1": {
          "type": "faq",
          "settings": {
            "question": "Wat kost het?",
            "answer": "<p>Je betaalt een prijs per paar die daalt naarmate je meer bestelt, vanaf 6 paar. Prijzen gelden per order, ex btw, inclusief verpakking en verzending. Je krijgt je prijs in een offerte op maat.</p>"
          }
        },
        "q2": {
          "type": "faq",
          "settings": {
            "question": "Is het sample echt gratis?",
            "answer": "<p>Ja. Je krijgt een gratis sample, verzonden binnen 1 werkdag.</p>"
          }
        },
        "q3": {
          "type": "faq",
          "settings": {
            "question": "Kunnen we ons eigen logo laten maken?",
            "answer": "<p>Ja, vanaf 150 paar. Je past onder meer kleur, lengte, logo's en verpakking aan. De levertijd en alle opties staan in je offerte.</p>"
          }
        },
        "q4": {
          "type": "faq",
          "settings": {
            "question": "Welke maten en kleuren heb je?",
            "answer": "<p>De Performance Grip Socks 2.0 is er in zwart en wit, in de maten 35–38, 39–42 en 43–47.</p>"
          }
        },
        "q5": {
          "type": "faq",
          "settings": {
            "question": "Hoe worden de sokken verpakt?",
            "answer": "<p>Met een paper wrap, een header card of in een box. Wat het beste bij jouw winkel of club past, bespreken we in de offerte.</p>"
          }
        },
        "q6": {
          "type": "faq",
          "settings": {
            "question": "Waarom kan ik grip claimen?",
            "answer": "<p>Wetenschappelijk aangetoond: gripsokken verhogen de statische wrijvingscoëfficiënt van 0,60 naar 1,17, dus 95% meer grip (Apps et al. 2022). Dat onderzoek gaat over gripsokken in het algemeen, niet over een test van onze eigen sok.</p>"
          }
        },
        "q7": {
          "type": "faq",
          "settings": {
            "question": "Hoe snel hoor ik iets?",
            "answer": "<p>Op dezelfde werkdag. De kennismaking is vrijblijvend.</p>"
          }
        }
      },
