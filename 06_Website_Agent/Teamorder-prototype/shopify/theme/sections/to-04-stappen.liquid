{%- liquid
  assign s = section.settings
-%}
{%- render 'to-base' -%}
{%- render 'to-vars', s: s, id: section.id, h: 60 -%}
<section class="to to-steps-sec{% if s.align == 'center' %} to-c{% endif %}"{% if s.anim %} data-anim{% endif %} style="--to-cols: {{ section.blocks.size | at_least: 1 }};" aria-labelledby="to-w-{{ section.id }}">
  <div class="to-wrap">
    <h2 class="to-h2 to-rv" id="to-w-{{ section.id }}">{{ s.heading | escape | replace: '[', '<span class="to-ac">' | replace: ']', '</span>' }}</h2>
    <ol class="to-steps">
      {%- for block in section.blocks -%}
        <li class="to-rv" style="--d:{{ forloop.index0 | times: 80 }}ms" {{ block.shopify_attributes }}><span class="to-steps__n">{{ forloop.index }}</span><h3>{{ block.settings.title }}</h3><p>{{ block.settings.text }}</p></li>
      {%- endfor -%}
    </ol>
  </div>
</section>

{% schema %}
{
  "name": "HÏ Team 04 · Stappen",
  "tag": "div",
  "class": "to-shopify-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Kop",
      "default": "In vier stappen [geregeld.]",
      "info": "Zet een woord tussen [ ] voor de accentkleur."
    },
    {
      "type": "header",
      "content": "Kleuren"
    },
    {
      "type": "color",
      "id": "bg",
      "label": "Achtergrond",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "fg",
      "label": "Tekst",
      "default": "#0A0A0A"
    },
    {
      "type": "color",
      "id": "mu",
      "label": "Tweede tekstkleur",
      "default": "#55565A"
    },
    {
      "type": "color",
      "id": "ac",
      "label": "Accentwoord",
      "default": "#0A0A0A"
    },
    {
      "type": "header",
      "content": "Ruimte"
    },
    {
      "type": "range",
      "id": "pt_m",
      "label": "Boven (mobiel)",
      "min": 0,
      "max": 200,
      "step": 4,
      "default": 48,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "pb_m",
      "label": "Onder (mobiel)",
      "min": 0,
      "max": 200,
      "step": 4,
      "default": 48,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "pt_d",
      "label": "Boven (desktop)",
      "min": 0,
      "max": 240,
      "step": 4,
      "default": 88,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "pb_d",
      "label": "Onder (desktop)",
      "min": 0,
      "max": 240,
      "step": 4,
      "default": 88,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Tekst en layout"
    },
    {
      "type": "range",
      "id": "h_m",
      "label": "Kopmaat (mobiel)",
      "min": 16,
      "max": 120,
      "step": 2,
      "default": 34,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "h_d",
      "label": "Kopmaat (desktop)",
      "min": 20,
      "max": 200,
      "step": 2,
      "default": 60,
      "unit": "px"
    },
    {
      "type": "select",
      "id": "align",
      "label": "Uitlijning",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "Links"
        },
        {
          "value": "center",
          "label": "Midden"
        }
      ]
    },
    {
      "type": "range",
      "id": "w",
      "label": "Maximale breedte inhoud",
      "min": 900,
      "max": 1600,
      "step": 20,
      "default": 1240,
      "unit": "px"
    },
    {
      "type": "checkbox",
      "id": "anim",
      "label": "Binnenkomst-animatie",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Stap",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Titel",
          "default": "Stel samen"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Tekst",
          "default": "Kies je sok en kleur, en per maat het aantal paar."
        }
      ]
    }
  ],
  "max_blocks": 6
}
{% endschema %}
