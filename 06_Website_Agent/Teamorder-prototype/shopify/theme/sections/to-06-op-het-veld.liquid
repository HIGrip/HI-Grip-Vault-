{%- liquid
  assign s = section.settings
-%}
{%- render 'to-base' -%}
{%- render 'to-vars', s: s, id: section.id, h: 96, ref: 1500 -%}
<section class="to to-con{% if s.align == 'center' %} to-c{% endif %}"{% if s.anim %} data-anim{% endif %} id="op-het-veld" style="--to-lh: 0.88; --to-row: {{ s.row }}px;" aria-labelledby="to-k-{{ section.id }}">
  <div class="to-wrap">
    <h2 class="to-h2 to-rv" id="to-k-{{ section.id }}">{{ s.heading | escape | replace: '[', '<span class="to-ac">' | replace: ']', '</span>' | newline_to_br }}</h2>
    {%- if s.lead != blank -%}<p class="to-lead to-rv" style="--d:60ms">{{ s.lead }}</p>{%- endif -%}
    <div class="to-gal to-rv" style="--d:120ms" role="list" aria-label="{{ s.label | escape }}">
      {%- for block in section.blocks -%}
        {%- assign b = block.settings -%}
        <figure class="{% if b.ls %}is-ls{% endif %}" role="listitem" style="--cs:{{ b.cols }};--rs:{{ b.rows }};--p:{{ b.px }}% {{ b.py }}%" {{ block.shopify_attributes }}>
          {%- render 'to-img', image: b.image, alt: b.alt, sizes: '(min-width: 981px) 50vw, 90vw' -%}
        </figure>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "HÏ Team 06 · Op het veld",
  "tag": "div",
  "class": "to-shopify-section",
  "settings": [
    {
      "type": "textarea",
      "id": "heading",
      "label": "Kop",
      "default": "Op het veld\nbij [Concordia.]",
      "info": "Nieuwe regel = regelafbreking; [ ] = accentkleur"
    },
    {
      "type": "textarea",
      "id": "lead",
      "label": "Intro",
      "default": "Geen studio. Een avondtraining in Delft, onder de lampen, op kunstgras. Zo spelen teams met HÏ Grip."
    },
    {
      "type": "text",
      "id": "label",
      "label": "Naam voor schermlezers",
      "default": "Sfeerbeelden van de shootdag bij Concordia"
    },
    {
      "type": "range",
      "id": "row",
      "label": "Rijhoogte raster (desktop)",
      "min": 60,
      "max": 200,
      "step": 4,
      "default": 120,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Kleuren"
    },
    {
      "type": "color",
      "id": "bg",
      "label": "Achtergrond",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "fg",
      "label": "Tekst",
      "default": "#0A0A0A"
    },
    {
      "type": "color",
      "id": "mu",
      "label": "Tweede tekstkleur",
      "default": "#55565A"
    },
    {
      "type": "color",
      "id": "ac",
      "label": "Accentwoord",
      "default": "#0A0A0A"
    },
    {
      "type": "header",
      "content": "Ruimte"
    },
    {
      "type": "range",
      "id": "pt_m",
      "label": "Boven (mobiel)",
      "min": 0,
      "max": 200,
      "step": 4,
      "default": 72,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "pb_m",
      "label": "Onder (mobiel)",
      "min": 0,
      "max": 200,
      "step": 4,
      "default": 12,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "pt_d",
      "label": "Boven (desktop)",
      "min": 0,
      "max": 240,
      "step": 4,
      "default": 128,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "pb_d",
      "label": "Onder (desktop)",
      "min": 0,
      "max": 240,
      "step": 4,
      "default": 12,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Tekst en layout"
    },
    {
      "type": "range",
      "id": "h_m",
      "label": "Kopmaat (mobiel)",
      "min": 16,
      "max": 120,
      "step": 2,
      "default": 40,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "h_d",
      "label": "Kopmaat (desktop)",
      "min": 20,
      "max": 200,
      "step": 2,
      "default": 96,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "lead_m",
      "label": "Tekstmaat (mobiel)",
      "min": 12,
      "max": 24,
      "step": 1,
      "default": 15,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "lead_d",
      "label": "Tekstmaat (desktop)",
      "min": 12,
      "max": 28,
      "step": 1,
      "default": 17,
      "unit": "px"
    },
    {
      "type": "select",
      "id": "align",
      "label": "Uitlijning",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "Links"
        },
        {
          "value": "center",
          "label": "Midden"
        }
      ]
    },
    {
      "type": "range",
      "id": "w",
      "label": "Maximale breedte inhoud",
      "min": 900,
      "max": 1600,
      "step": 20,
      "default": 1240,
      "unit": "px"
    },
    {
      "type": "checkbox",
      "id": "anim",
      "label": "Binnenkomst-animatie",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "photo",
      "name": "Foto",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Foto"
        },
        {
          "type": "text",
          "id": "alt",
          "label": "Alt-tekst"
        },
        {
          "type": "range",
          "id": "cols",
          "label": "Breedte op desktop (van 12)",
          "min": 2,
          "max": 12,
          "step": 1,
          "default": 4
        },
        {
          "type": "range",
          "id": "rows",
          "label": "Hoogte op desktop (rijen)",
          "min": 1,
          "max": 6,
          "step": 1,
          "default": 3
        },
        {
          "type": "checkbox",
          "id": "ls",
          "label": "Liggend op mobiel",
          "default": false
        },
        {
          "type": "range",
          "id": "px",
          "label": "Uitsnede horizontaal",
          "min": 0,
          "max": 100,
          "step": 1,
          "default": 50,
          "unit": "%"
        },
        {
          "type": "range",
          "id": "py",
          "label": "Uitsnede verticaal",
          "min": 0,
          "max": 100,
          "step": 1,
          "default": 50,
          "unit": "%"
        }
      ]
    }
  ],
  "max_blocks": 12
}
{% endschema %}
