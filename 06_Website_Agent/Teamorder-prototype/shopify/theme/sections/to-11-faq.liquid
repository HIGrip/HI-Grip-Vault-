{%- liquid
  assign s = section.settings
-%}
{%- render 'to-base' -%}
{%- render 'to-vars', s: s, id: section.id, h: 60 -%}
<section class="to to-faq{% if s.align == 'center' %} to-c{% endif %}"{% if s.anim %} data-anim{% endif %} id="faq" aria-labelledby="to-f-{{ section.id }}">
  <div class="to-wrap">
    <div class="to-faq__h to-rv">
      <h2 class="to-h2" id="to-f-{{ section.id }}">{{ s.heading | escape | replace: '[', '<span class="to-ac">' | replace: ']', '</span>' }}</h2>
      {%- if s.lead != blank -%}<div class="to-lead">{{ s.lead }}</div>{%- endif -%}
    </div>
    <div class="to-faq__l to-rv" style="--d:80ms">
      {%- for block in section.blocks -%}
        <details class="to-qa" {{ block.shopify_attributes }}><summary>{{ block.settings.question }}</summary><div class="to-qa__a">{{ block.settings.answer }}</div></details>
      {%- endfor -%}
    </div>
  </div>
  {%- if s.schema and section.blocks.size > 0 -%}
    <script type="application/ld+json">{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{%- for block in section.blocks -%}{"@type":"Question","name":{{ block.settings.question | json }},"acceptedAnswer":{"@type":"Answer","text":{{ block.settings.answer | strip_html | strip | json }}}}{%- unless forloop.last -%},{%- endunless -%}{%- endfor -%}]}</script>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "HÏ Team 11 · FAQ",
  "tag": "div",
  "class": "to-shopify-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Kop",
      "default": "Vragen over je [teamorder.]",
      "info": "Zet een woord tussen [ ] voor de accentkleur."
    },
    {
      "type": "richtext",
      "id": "lead",
      "label": "Intro",
      "default": "<p>Staat je vraag er niet tussen? Mail ons via <a href=\"mailto:info@higrip.nl\">info@higrip.nl</a>, je hoort binnen 1 werkdag van ons.</p>"
    },
    {
      "type": "checkbox",
      "id": "schema",
      "label": "Vragen als FAQPage-data voor Google",
      "default": true,
      "info": "Zet uit als dezelfde vragen al elders op deze pagina als FAQPage staan."
    },
    {
      "type": "header",
      "content": "Kleuren"
    },
    {
      "type": "color",
      "id": "bg",
      "label": "Achtergrond",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "fg",
      "label": "Tekst",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "mu",
      "label": "Tweede tekstkleur",
      "default": "#909194"
    },
    {
      "type": "color",
      "id": "ac",
      "label": "Accentwoord",
      "default": "#CCFF00"
    },
    {
      "type": "header",
      "content": "Ruimte"
    },
    {
      "type": "range",
      "id": "pt_m",
      "label": "Boven (mobiel)",
      "min": 0,
      "max": 200,
      "step": 4,
      "default": 72,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "pb_m",
      "label": "Onder (mobiel)",
      "min": 0,
      "max": 200,
      "step": 4,
      "default": 72,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "pt_d",
      "label": "Boven (desktop)",
      "min": 0,
      "max": 240,
      "step": 4,
      "default": 128,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "pb_d",
      "label": "Onder (desktop)",
      "min": 0,
      "max": 240,
      "step": 4,
      "default": 128,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Tekst en layout"
    },
    {
      "type": "range",
      "id": "h_m",
      "label": "Kopmaat (mobiel)",
      "min": 16,
      "max": 120,
      "step": 2,
      "default": 34,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "h_d",
      "label": "Kopmaat (desktop)",
      "min": 20,
      "max": 200,
      "step": 2,
      "default": 60,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "lead_m",
      "label": "Tekstmaat (mobiel)",
      "min": 12,
      "max": 24,
      "step": 1,
      "default": 15,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "lead_d",
      "label": "Tekstmaat (desktop)",
      "min": 12,
      "max": 28,
      "step": 1,
      "default": 17,
      "unit": "px"
    },
    {
      "type": "select",
      "id": "align",
      "label": "Uitlijning",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "Links"
        },
        {
          "value": "center",
          "label": "Midden"
        }
      ]
    },
    {
      "type": "range",
      "id": "w",
      "label": "Maximale breedte inhoud",
      "min": 900,
      "max": 1600,
      "step": 20,
      "default": 1240,
      "unit": "px"
    },
    {
      "type": "checkbox",
      "id": "anim",
      "label": "Binnenkomst-animatie",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "qa",
      "name": "Vraag",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Vraag",
          "default": "Hoe werkt de staffelprijs?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Antwoord",
          "default": "<p>Antwoord</p>"
        }
      ]
    }
  ],
  "max_blocks": 20
}
{% endschema %}
