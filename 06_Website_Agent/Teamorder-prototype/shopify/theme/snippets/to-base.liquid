{%- comment -%}
  Gedeelde laag van de teamordersecties (to-*): Poppins, to-teamorder.css en .js, en de motion-klasse op <html>.
  Staat in elke sectie zodat elke sectie ook los werkt; de browser haalt elk bestand één keer op.
{%- endcomment -%}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Poppins:ital,wght@0,400;0,500;0,600;0,700;0,800;0,900;1,800;1,900&display=swap">
{{ 'to-teamorder.css' | asset_url | stylesheet_tag }}
<script>if ('IntersectionObserver' in window && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) document.documentElement.classList.add('to-motion');</script>
<script src="{{ 'to-teamorder.js' | asset_url }}" defer></script>
