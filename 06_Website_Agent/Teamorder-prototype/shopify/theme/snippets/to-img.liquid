{%- comment -%}
  Responsieve <img> voor de teamordersecties.
  @param image     afbeelding (image_picker)
  @param class     klasse(n)
  @param sizes     sizes-attribuut
  @param alt       alt-tekst; leeg = alt van het bestand
  @param decorative true = alt="" (bijv. de tweede ronde van een looprand)
  @param priority  true = fetchpriority="high" en eager (alleen de hero)
  @param style     inline style
{%- endcomment -%}
{%- if image != blank -%}
  {%- liquid
    assign ws = '360,540,720,900,1080,1200,1500,1800,2000,2400' | split: ','
    assign iw = image.width
    assign set = ''
    for w in ws
      assign wn = w | plus: 0
      if wn < iw
        assign u = image | image_url: width: wn
        assign set = set | append: u | append: ' ' | append: wn | append: 'w, '
      endif
    endfor
    assign u = image | image_url: width: iw
    assign set = set | append: u | append: ' ' | append: iw | append: 'w'
    assign a = alt | default: image.alt
    if decorative
      assign a = ''
    endif
  -%}
  <img class="{{ class }}" src="{{ image | image_url: width: 1200 }}" srcset="{{ set }}" sizes="{{ sizes | default: '100vw' }}" width="{{ image.width }}" height="{{ image.height }}" alt="{{ a | escape }}"{% if priority %} fetchpriority="high" loading="eager"{% else %} loading="lazy"{% endif %} decoding="async"{% if style != blank %} style="{{ style }}"{% endif %}>
{%- endif -%}
